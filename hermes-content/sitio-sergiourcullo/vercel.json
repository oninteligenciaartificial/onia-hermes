{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/stack/archivos",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/homelab/archivos",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/llamada",
      "destination": "https://cal.com/sergiourcullo/20min",
      "permanent": false
    },
    {
      "source": "/webs",
      "destination": "https://onia.com.bo/servicios/webs?origen=sergio",
      "permanent": false
    }
  ]
}
