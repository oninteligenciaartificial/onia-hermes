# env.stack.example — DELTA de produccion para el .env del stack Supabase dedicado
# Destino: /opt/dentalgest-supabase/supabase/docker/.env  (mergear sobre el .env existente
# del stack staging; NO reemplazar el archivo entero — el compose oficial usa mas variables).
# TODOS los valores <ASI> se generan/completan en la Fase 2.1 del runbook. CERO secretos reales aqui.

############
# Secretos — regenerar TODOS (los de staging estan QUEMADOS)
############
# gen-secrets.sh
POSTGRES_PASSWORD=<GENERAR_openssl_rand_hex_24>
JWT_SECRET=<GENERAR_openssl_rand_hex_32_min_40_chars>
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=<GENERAR_openssl_rand_hex_16>
# gen-jwt-keys.mjs "$JWT_SECRET"  → firma estos dos:
ANON_KEY=<JWT_HS256_role_anon>
SERVICE_ROLE_KEY=<JWT_HS256_role_service_role>
# Supavisor
SECRET_KEY_BASE=<GENERAR_openssl_rand_hex_32>
VAULT_ENC_KEY=<GENERAR_openssl_rand_hex_16>

############
# Base de datos (sin cambios vs staging — solo referencia)
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Puertos host (se conservan los de staging; SOLO 127.0.0.1)
############
KONG_HTTP_PORT=55321
KONG_HTTPS_PORT=55322
POOLER_PROXY_PORT_SESSION=55329
POOLER_PROXY_PORT_TRANSACTION=55320

############
# URLs publicas (cambian a prod)
############
API_EXTERNAL_URL=https://api.dentalgest.app
SUPABASE_PUBLIC_URL=https://api.dentalgest.app
SITE_URL=https://dentalgest.app
ADDITIONAL_REDIRECT_URLS=https://dentalgest.app/*,https://www.dentalgest.app/*

############
# Auth (GoTrue)
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=true            # altas de usuarios SOLO via service key / admin de la app
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# SMTP para GoTrue (D5 — recomendado: Resend via SMTP)
############
SMTP_ADMIN_EMAIL=noreply@dentalgest.app
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=<RESEND_API_KEY>
SMTP_SENDER_NAME=DentalGest
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Studio (solo tunel SSH — nunca publico)
############
STUDIO_DEFAULT_ORGANIZATION=ONIA
STUDIO_DEFAULT_PROJECT=DentalGest

############
# PostgREST — dentalgest NO se expone (la app usa Prisma; menos superficie)
############
PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Pooler (Supavisor) — queda instalado como plan B; la app NO pasa por el
############
POOLER_TENANT_ID=dentalgest
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100

############
# Funciones edge / analytics: NO se corren en este stack
############
FUNCTIONS_VERIFY_JWT=false
