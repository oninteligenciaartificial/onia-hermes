# env.app.example — .env.app del contenedor DentalGest en el VPS (Fase 2.4 / 5.1 del runbook)
# Destino: /opt/dentalgest-app/.env.app (root-only, chmod 600). CERO secretos reales aqui.
# Regla: todo lo que NO cambia se copia 1:1 desde las env vars actuales de Vercel.

# ── Runtime standalone ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ── Database (CAMBIA: Prisma directo al Postgres del stack, red docker) ──
# db = servicio del stack /opt/dentalgest-supabase (misma red docker; 5432 NUNCA publico)
DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/postgres?schema=dentalgest&connection_limit=15&pool_timeout=20"
DIRECT_URL="postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/postgres?schema=dentalgest"

# ── Supabase (CAMBIA: keys nuevas de la Fase 2.1) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://api.dentalgest.app"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<ANON_KEY_NUEVO>"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY_NUEVO>"

# ── App (no cambia) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://dentalgest.app"
NEXT_PUBLIC_GA_ID="<COPIAR_DE_VERCEL>"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="<COPIAR_DE_VERCEL>"
NEXT_PUBLIC_DENTALGEST_WA="<COPIAR_DE_VERCEL>"

# ── Email — Resend (no cambia) ────────────────────────────────────────
EMAIL_PROVIDER="resend"
RESEND_API_KEY="<COPIAR_DE_VERCEL>"
RESEND_FROM_EMAIL="noreply@dentalgest.app"
RESEND_FROM_NAME="DentalGest"

# ── WhatsApp Business API (no cambia) ─────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID="<COPIAR_DE_VERCEL>"
WHATSAPP_ACCESS_TOKEN="<COPIAR_DE_VERCEL>"
WHATSAPP_TEMPLATE_NAME="appointment_reminder"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="<COPIAR_DE_VERCEL>"
WHATSAPP_APP_SECRET="<COPIAR_DE_VERCEL>"

# ── OpenAI / Chatwoot / n8n / crons (no cambian) ──────────────────────
OPENAI_API_KEY="<COPIAR_DE_VERCEL>"
CHATWOOT_BASE_URL="<COPIAR_DE_VERCEL>"
CHATWOOT_API_TOKEN="<COPIAR_DE_VERCEL>"
CHATWOOT_ACCOUNT_ID="<COPIAR_DE_VERCEL>"
CHATWOOT_WEBHOOK_SECRET="<COPIAR_DE_VERCEL>"
N8N_API_KEY="<COPIAR_DE_VERCEL>"
N8N_API_URL="<COPIAR_DE_VERCEL>"
N8N_MANAGEMENT_API_KEY="<COPIAR_DE_VERCEL>"
N8N_WEBHOOK_PATIENT_CREATED="<COPIAR_DE_VERCEL>"
CRON_SECRET="<COPIAR_DE_VERCEL>"
ONIA_INTAKE_SECRET="<COPIAR_DE_VERCEL>"

# ── Pasarela / Sentry / Push / Redis (no cambian) ─────────────────────
ENCRYPTION_KEY="<COPIAR_DE_VERCEL>"
SENTRY_DSN="<COPIAR_DE_VERCEL>"
NEXT_PUBLIC_SENTRY_DSN="<COPIAR_DE_VERCEL>"
SENTRY_ORG="<COPIAR_DE_VERCEL>"
SENTRY_PROJECT="<COPIAR_DE_VERCEL>"
SENTRY_PROJECT_ID="<COPIAR_DE_VERCEL>"
SENTRY_AUTH_TOKEN="<COPIAR_DE_VERCEL>"
VAPID_PUBLIC_KEY="<COPIAR_DE_VERCEL>"
VAPID_PRIVATE_KEY="<COPIAR_DE_VERCEL>"
VAPID_CONTACT="<COPIAR_DE_VERCEL>"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<COPIAR_DE_VERCEL>"
UPSTASH_REDIS_REST_URL="<COPIAR_DE_VERCEL>"
UPSTASH_REDIS_REST_TOKEN="<COPIAR_DE_VERCEL>"

# ── Flags ONIA — OFF en el corte (encenderlos es decision separada) ───
PLATFORM_LAYER=""
SIAT_EMISSION=""
SIAT_SERVICE_URL=""
SIAT_SERVICE_TOKEN=""
AGENTS_RUNTIME=""
AGENT_RUNTIME_SECRET=""
