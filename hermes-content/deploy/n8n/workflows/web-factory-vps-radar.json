{
  "id": "ONIAWebFactoryRadar1",
  "name": "ONIA - Web Factory VPS Radar",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 7 * * 1-6"
            }
          ]
        }
      },
      "id": "schedule-lun-sab-0710",
      "name": "Lunes a sabado 07:10",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-620, 0]
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "resource": "command",
        "command": "cd /opt/onia-hermes/web-factory && node scripts/web-factory-vps-automation.mjs --mode daily",
        "cwd": "/opt/onia-hermes/web-factory"
      },
      "id": "run-web-factory-worker",
      "name": "Run Web Factory worker on VPS",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [-360, 0],
      "credentials": {
        "sshPrivateKey": {
          "id": "REPLACE_WITH_ONIA_VPS_SSH_CREDENTIAL_ID",
          "name": "ONIA VPS SSH"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0]?.json || {};\nconst stdout = String(raw.stdout || '').trim();\nlet parsed = null;\ntry {\n  const start = stdout.indexOf('{');\n  parsed = start >= 0 ? JSON.parse(stdout.slice(start)) : null;\n} catch (error) {\n  parsed = null;\n}\nconst report = parsed || {};\nconst steps = Array.isArray(report.steps) ? report.steps : [];\nconst failedStep = steps.find((step) => !step.ok);\nconst exitCode = typeof raw.code === 'number' ? raw.code : (typeof raw.exitCode === 'number' ? raw.exitCode : 1);\nconst ok = exitCode === 0 && report.ok !== false && !failedStep;\nconst lines = [\n  ok ? 'ONIA Web Factory VPS: OK' : 'ONIA Web Factory VPS: FALLO',\n  `mode=${report.mode || 'daily'} runId=${report.runId || 'sin-run-id'}`,\n  `exitCode=${exitCode} report=${report.reportPath || '/var/log/onia/web-factory/latest-web-factory-vps-automation.json'}`,\n  failedStep ? `failedStep=${failedStep.id || 'unknown'}` : `steps=${steps.length}`,\n];\nif (raw.stderr) lines.push(String(raw.stderr).slice(-800));\nreturn [{ json: { ok, exitCode, runId: report.runId || '', reportPath: report.reportPath || '', failedStep: failedStep?.id || '', message: lines.join('\\n').slice(0, 3900) } }];"
      },
      "id": "normalize-worker-result",
      "name": "Normalize worker result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "telegram-env-ready",
              "leftValue": "={{Boolean($env.TELEGRAM_BOT_TOKEN && $env.TELEGRAM_SERGIO_CHAT_ID)}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "telegram-configured",
      "name": "Telegram configurado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [180, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "worker-ok",
              "leftValue": "={{$json.ok}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "worker-ok",
      "name": "Worker OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage'}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: $env.TELEGRAM_SERGIO_CHAT_ID, text: $json.message, disable_web_page_preview: true } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "notify-success-telegram",
      "name": "Notify success Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage'}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: $env.TELEGRAM_SERGIO_CHAT_ID, text: $json.message, disable_web_page_preview: true } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "notify-failure-telegram",
      "name": "Notify failure Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 120]
    }
  ],
  "connections": {
    "Lunes a sabado 07:10": {
      "main": [[{ "node": "Run Web Factory worker on VPS", "type": "main", "index": 0 }]]
    },
    "Run Web Factory worker on VPS": {
      "main": [[{ "node": "Normalize worker result", "type": "main", "index": 0 }]]
    },
    "Normalize worker result": {
      "main": [[{ "node": "Telegram configurado?", "type": "main", "index": 0 }]]
    },
    "Telegram configurado?": {
      "main": [
        [{ "node": "Worker OK?", "type": "main", "index": 0 }],
        []
      ]
    },
    "Worker OK?": {
      "main": [
        [{ "node": "Notify success Telegram", "type": "main", "index": 0 }],
        [{ "node": "Notify failure Telegram", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "timezone": "America/La_Paz",
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "web-factory-vps-radar-20260704",
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Corre el worker de Web Factory en el VPS por SSH (Lun-Sab 07:10 La Paz), normaliza el resultado y notifica a Sergio por Telegram. El nodo SSH usa la credencial 'ONIA VPS SSH' (privateKey). Comando: node scripts/web-factory-vps-automation.mjs --mode daily en /opt/onia-hermes/web-factory (symlink a /opt/onia-center-src)."
  },
  "tags": [
    { "name": "onia" },
    { "name": "web-factory" },
    { "name": "safe-automation" }
  ]
}
