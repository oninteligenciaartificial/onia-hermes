COMPOSE_PROJECT_NAME=onia_selfhosted

# Bind all internal services to localhost first. Publish through Easypanel/Traefik
# only after auth, DNS and a rollback path are confirmed.
UPTIME_KUMA_BIND=127.0.0.1
UPTIME_KUMA_PORT=3101
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=3102
STIRLING_BIND=127.0.0.1
STIRLING_PORT=3103
CRAWL4AI_BIND=127.0.0.1
CRAWL4AI_PORT=11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_SECRET_KEY=
CRAWL4AI_REDIS_PASSWORD=
MAILPIT_BIND=127.0.0.1
MAILPIT_WEB_PORT=3104
MAILPIT_SMTP_PORT=3025
LISTMONK_BIND=127.0.0.1
LISTMONK_PORT=3105
FIRECRAWL_BIND=127.0.0.1
FIRECRAWL_PORT=3106
SPEAKR_BIND=127.0.0.1
SPEAKR_PORT=3107
SPEACHES_BIND=127.0.0.1
SPEACHES_PORT=3108
WHISPERX_ASR_BIND=127.0.0.1
WHISPERX_ASR_PORT=3109

# Images. Pin exact versions after the first validated install.
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
STIRLING_IMAGE=stirlingtools/stirling-pdf:latest
CRAWL4AI_IMAGE=unclecode/crawl4ai:latest
MAILPIT_IMAGE=axllent/mailpit:v1.30.2
LISTMONK_IMAGE=listmonk/listmonk:v6.1.0
LISTMONK_POSTGRES_IMAGE=postgres:17-alpine
SPEAKR_IMAGE=learnedmachine/speakr:latest
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
WHISPERX_ASR_IMAGE=learnedmachine/whisperx-asr-service:latest

# Generated by install.sh on the VPS if empty.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=
WEBUI_SECRET_KEY=
STIRLING_INITIALLOGIN_USERNAME=admin
STIRLING_INITIALLOGIN_PASSWORD=
LISTMONK_POSTGRES_DB=listmonk
LISTMONK_POSTGRES_USER=listmonk
LISTMONK_POSTGRES_PASSWORD=
LISTMONK_ADMIN_USER=onia-admin
LISTMONK_ADMIN_PASSWORD=
FIRECRAWL_POSTGRES_USER=firecrawl
FIRECRAWL_POSTGRES_PASSWORD=
FIRECRAWL_POSTGRES_DB=firecrawl
FIRECRAWL_BULL_AUTH_KEY=
FIRECRAWL_CRAWL_CONCURRENT_REQUESTS=2
FIRECRAWL_MAX_CONCURRENT_JOBS=1
FIRECRAWL_BROWSER_POOL_SIZE=1
FIRECRAWL_MAX_CPU=0.70
FIRECRAWL_MAX_RAM=0.70

# Meeting intelligence / audio intake.
# Secrets can also live in /root/.hermes/.env. install.sh can copy OPENAI_API_KEY
# into TEXT_MODEL_API_KEY on the remote generated .env if TEXT_MODEL_API_KEY is empty.
SPEAKR_ADMIN_USERNAME=admin
SPEAKR_ADMIN_EMAIL=admin@onia.local
SPEAKR_ADMIN_PASSWORD=
SPEAKR_SECRET_KEY=
SPEAKR_ALLOW_REGISTRATION=false
SPEAKR_ENABLE_PUBLIC_SHARING=false
SPEAKR_ENABLE_INTERNAL_SHARING=true
SPEAKR_ENABLE_SERVER_RECORDING_CHUNKS=true
SPEAKR_RECORDING_MAX_HOURS=8
SPEAKR_AUDIO_COMPRESS_UPLOADS=true
SPEAKR_AUDIO_CODEC=mp3
SPEAKR_AUDIO_BITRATE=128k
SPEAKR_TEXT_MODEL_BASE_URL=https://api.openai.com/v1
SPEAKR_TEXT_MODEL_NAME=gpt-4o-mini
TEXT_MODEL_API_KEY=
SPEAKR_TRANSCRIPTION_BASE_URL=http://speaches:8000/v1
SPEAKR_TRANSCRIPTION_MODEL=Systran/faster-distil-whisper-large-v3
SPEAKR_TRANSCRIPTION_API_KEY=local
SPEAKR_ASR_BASE_URL=
SPEAKR_ASR_DIARIZE=true
SPEAKR_ASR_MIN_SPEAKERS=1
SPEAKR_ASR_MAX_SPEAKERS=5
SPEAKR_ASR_RETURN_SPEAKER_EMBEDDINGS=true
SPEAKR_JOB_QUEUE_WORKERS=2
SPEAKR_SUMMARY_QUEUE_WORKERS=2
SPEAKR_MEM_LIMIT=4096m
SPEACHES_MEM_LIMIT=4096m

# WhisperX ASR is only for the meeting-gpu profile.
# HF_TOKEN belongs in /root/.hermes/.env after accepting the pyannote model terms.
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_BATCH_SIZE=16
WHISPERX_PRELOAD_MODEL=large-v3
WHISPERX_MAX_FILE_SIZE_MB=1000
WHISPERX_SERVE_MODE=simple
WHISPERX_GPU_CONCURRENCY=1
WHISPERX_SHM_SIZE=8g
WHISPERX_ASR_MEM_LIMIT=12288m
TZ=America/La_Paz

# Optional public URLs. Leave empty until DNS/auth are ready.
WEBUI_URL=
STIRLING_BASEURL=
