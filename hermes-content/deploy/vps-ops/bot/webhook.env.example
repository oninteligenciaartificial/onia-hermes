# ONIA — Chatbot propio: PLANTILLA de secretos del servidor de webhook.
#
# ESTE ARCHIVO ES SOLO LA PLANTILLA. El de verdad va en el VPS, FUERA de git:
#   /opt/onia/bot/webhook.env   (chmod 600, dueño root)
#
# Se llama `webhook.env.example` y no `.env.webhook.example` a propósito: `.gitignore` ignora
# `.env.*`, así que un archivo con ese otro nombre no se podría versionar ni como plantilla.
# El archivo REAL (`webhook.env`) hay que mantenerlo fuera del repo a mano — no lo cubre el
# `.gitignore` por nombre, así que NUNCA lo copies dentro de la carpeta del repo.
#
# Generar secretos (32 bytes al azar, uno distinto para cada uno):
#   openssl rand -hex 32

# --- Autenticación del webhook de Chatwoot -----------------------------------
# Con NINGUNO de los dos, el servidor responde 503 a todo (fail-closed, a propósito).

# Secreto en la RUTA. Es el que SIEMPRE funciona: Chatwoot deja poner un webhook_url arbitrario,
# así que el secreto viaja en el path. Configurá el inbox apuntando a:
#   http://onia-center:3020/webhook/chatwoot/<ESTE-VALOR>
ONIA_CHATWOOT_WEBHOOK_PATH_SECRET=

# Secreto HMAC de la firma (`x-chatwoot-timestamp` + `x-chatwoot-signature`). Sumalo si esta
# versión de Chatwoot firma sus webhooks; si no los firma, dejalo vacío y usá sólo el de la ruta.
ONIA_CHATWOOT_WEBHOOK_SECRET=

# Ventana anti-replay de la firma, en segundos.
ONIA_CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300

# SOLO para probar en local. En el VPS esto va en false SIEMPRE.
ONIA_CHATWOOT_ALLOW_UNSIGNED=false

# --- Evento a n8n (fire-and-forget, fuera del camino crítico) ----------------
# n8n ya NO responde mensajes: sólo recibe analítica redactada. Si está caído, el bot contesta
# igual. El secreto viaja en el header `x-onia-webhook-secret` y en n8n se valida con una
# credencial "Header Auth" (el plan VPS no soporta $env en los nodos).
ONIA_N8N_ENABLED=false
ONIA_N8N_EVENT_URL=
ONIA_N8N_EVENT_SECRET=

# --- Encendido en dos pasos --------------------------------------------------
# true = el motor calcula la respuesta real pero NO la postea a Chatwoot (se ve en bot_messages).
# Pasar a false recién después de mirar un rato en seco.
ONIA_BOT_DRY_RUN=true
