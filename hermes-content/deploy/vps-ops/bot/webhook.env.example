# ONIA — Chatbot propio: PLANTILLA de secretos del servidor de webhook.
#
# ESTE ARCHIVO ES SOLO LA PLANTILLA. El de verdad va en el VPS, FUERA de git:
#   /opt/onia/bot/webhook.env   (chmod 600, dueño root)
#
# Se llama `webhook.env.example` y no `.env.webhook.example` a propósito: `.gitignore` ignora
# `.env.*`, así que un archivo con ese otro nombre no se podría versionar ni como plantilla.
# El archivo REAL (`webhook.env`) hay que mantenerlo fuera del repo a mano — no lo cubre el
# `.gitignore` por nombre, así que NUNCA lo copies dentro de la carpeta del repo.
#
# Generar secretos (32 bytes al azar, uno distinto para cada uno):
#   openssl rand -hex 32

# --- Autenticación del webhook de Chatwoot -----------------------------------
# Con NINGUNO de los dos, el servidor responde 503 a todo (fail-closed, a propósito).

# Secreto en la RUTA. Es el que SIEMPRE funciona: Chatwoot deja poner un webhook_url arbitrario,
# así que el secreto viaja en el path. Configurá el inbox apuntando a:
#   http://onia-center:3020/webhook/chatwoot/<ESTE-VALOR>
ONIA_CHATWOOT_WEBHOOK_PATH_SECRET=

# Secreto HMAC de la firma (`x-chatwoot-timestamp` + `x-chatwoot-signature`). Sumalo si esta
# versión de Chatwoot firma sus webhooks; si no los firma, dejalo vacío y usá sólo el de la ruta.
ONIA_CHATWOOT_WEBHOOK_SECRET=

# Ventana anti-replay de la firma, en segundos.
ONIA_CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300

# SOLO para probar en local. En el VPS esto va en false SIEMPRE.
ONIA_CHATWOOT_ALLOW_UNSIGNED=false

# --- Evento a n8n (fire-and-forget, fuera del camino crítico) ----------------
# n8n ya NO responde mensajes: sólo recibe analítica redactada. Si está caído, el bot contesta
# igual. El secreto viaja en el header `x-onia-webhook-secret` y en n8n se valida con una
# credencial "Header Auth" (el plan VPS no soporta $env en los nodos).
ONIA_N8N_ENABLED=false
ONIA_N8N_EVENT_URL=
ONIA_N8N_EVENT_SECRET=

# --- Conocimiento del BOT DE VENTAS desde el panel (F2.1) --------------------
# La URL COMPLETA de la fila publicada de la ORG INTERNA de Onia en el producto. Con esto,
# Sergio edita el conocimiento del bot de ventas en el editor del panel (org `onia-interna`)
# y el bot lo toma solo (TTL 5 min), sin publicar knowledge.onia.json a mano. /health pasa a
# decir knowledge.source:"panel" con la version y el autor del editor.
# El Bearer es BOT_KNOWLEDGE_SECRET (mismo endpoint que la fuente por org, ya configurado).
# Vacio = apagada: el bot sigue con el archivo, exactamente como hoy. Si la URL falla o el
# panel no publico nada (404), el bot cae al archivo — jamas queda mudo.
#   ONIA_KNOWLEDGE_URL=http://onia-platform:3000/api/chatbot-knowledge/published?organizationId=<id-de-onia-interna>
ONIA_KNOWLEDGE_URL=

# --- Contador de la CUOTA en la plataforma (uso-plataforma.mjs) --------------
# La plataforma cuenta las conversaciones del add-on en su propio POST /api/webhooks/chatwoot,
# pero ese handler exige el header `X-Chatwoot-Secret` y Chatwoot NO manda headers
# personalizados: por eso el aviso lo manda el MOTOR por cada mensaje entrante real.
# Sin estas dos variables la cuota no se cuenta (y por lo tanto nunca se agota).
# El secreto tiene que ser EL MISMO valor que la plataforma tiene en su app.env; si difiere,
# la plataforma responde 401 y no cuenta nada.
ONIA_PLATFORM_URL=https://app.onia.com.bo
CHATWOOT_WEBHOOK_SECRET=

# --- Agenda propia del bot (el «agendo yo») ----------------------------------
# VACIO = el bot NO agenda (default seguro, 2-oct-2026). No ofrece horarios ni confirma una demo:
# ofrece la demo y el horario lo coordina Sergio Urcullo (le llega el aviso `coordinar_demo`).
# `calcom` = ofrece los horarios de ONIA_BOT_SLOTS y los reserva en Cal.com; SOLO enciende si
# ademas CALCOM_BASE_URL y CALCOM_BOT_EVENT_TYPE_ID apuntan a un Cal.com que EXISTE. Encenderlo
# sin eso es volver al «Listo, agendado» de una demo que no queda en ningun calendario.
# Los barridos (followup-run.sh) todavia no pasan esta variable: con la agenda encendida, M3 sigue
# bloqueado hasta cablearla ahi tambien (skill onia-chatbot).
ONIA_BOT_AGENDA=

# --- Reserva real en Cal.com -------------------------------------------------
# Id del tipo de evento OCULTO del bot (`demo-bot`), NO el publico. El publico (`demo-onia`)
# tiene 10 campos obligatorios que el bot no captura: reservar ahi devuelve 400 siempre.
# La DISPONIBILIDAD se lee del publico (un evento oculto no publica horarios) y se RESERVA en
# este; comparten usuario y agenda, asi que una reserva bloquea al otro. Vacio = no reserva.
CALCOM_BOT_EVENT_TYPE_ID=
# DEJALO VACIO. La duracion de la demo salio de aca a `config.mjs` (bloque DEMO) / knowledge.json,
# porque es EL MISMO HECHO que el guion le promete al prospecto ({{demo_duracion}}) y tenerlo en
# dos lugares es como llegamos a prometer 15 minutos mientras el calendario bloqueaba 45.
# Si pones un numero aca, este GANA sobre el conocimiento: es el freno de mano del que despliega,
# no el lugar normal para cambiarlo.
CALCOM_BOT_DURATION_MINUTES=
CALCOM_TIMEZONE=America/La_Paz

# --- Notas de voz (Speaches) ---------------------------------------------------
# En Bolivia una parte enorme del WhatsApp son notas de voz. Con esto encendido el bot las
# TRANSCRIBE en vez de contestar "¿me lo escribís?". Nada de esto es secreto.
#
# APAGADA POR DEFAULT (2-oct-2026): Speaches NO existe en el VPS (`getent hosts speaches` no
# resuelve). Apagada, el bot contesta al instante que no puede escuchar el audio y pide texto;
# si insiste con audio, lo deriva a una persona (M_AUDIO_FAIL + handoff). Solo `true` la enciende,
# y solo tiene sentido con un transcriptor que conteste (o el respaldo de OpenAI con su key).
ONIA_AUDIO_ENABLED=false
#
# Speaches DIRECTO, no a traves de un proxy del panel. Desde adentro del contenedor onia-center
# es la red de docker; desde el host del VPS seria http://127.0.0.1:3108/v1.
ONIA_AUDIO_STT_BASE_URL=http://speaches:8000/v1
#
# NO CAMBIAR A UN `faster-distil-*`: son English-only y TRADUCEN el español al inglés en vez de
# transcribirlo. El bot recibiria inglés y no matchearia ni un intent del guion.
ONIA_AUDIO_STT_MODEL=Systran/faster-whisper-small
ONIA_AUDIO_STT_LANGUAGE=es
#
# Techos. Medido en el VPS (nota de ~9 s): modelo frio ~33 s, caliente entre 6 s y 21 s segun
# carga. El tope de bytes descarta el audio gigante ANTES de bajarlo (8 MiB).
ONIA_AUDIO_STT_TIMEOUT_MS=45000
ONIA_AUDIO_MAX_BYTES=8388608

# --- Aviso a Sergio por Telegram (aviso-telegram.mjs) ------------------------
# El motor emite `notify_sergio` cuando deriva a un humano (handoff, demo agendada, se cayo una
# demo, ningun horario le sirve). Ese aviso viajaba DENTRO del evento de n8n, que esta apagado
# arriba: el bot le prometia al prospecto "te escribe Sergio" y no le llegaba a nadie. Medido en
# produccion el 2026-09-03 (conversacion 49, mensaje 389). Por eso sale por su propio canal y con
# su propio interruptor: la analitica y "hay una persona esperando" no pueden compartir uno.
#
# VIENE ENCENDIDO. Sergio ya decidio que si (tablero `t_b18ca430`, opcion (c)), y el lanzador lo
# arranca en `true` aunque esta linea no exista — el token y el chat los saca solo de
# `/root/.config/onia/backup.env`. Dejarlo apagado por defecto fue lo que lo tuvo un dia entero
# en cero con el codigo escrito, probado y CORRIENDO en produccion: encenderlo dependia de editar
# a mano este archivo, que no esta en git y que ningun deploy toca.
# Para APAGARLO, poner `false` aca: esta linea le gana al default del lanzador.
# En `true` SIN token o sin chat el aviso NO se calla: sale `failed` con nombre propio en el log,
# porque un aviso que se pierde en silencio es el bug que esto viene a arreglar.
# Se ve con: bash webhook-server.sh logs | grep '\[aviso\]'
ONIA_BOT_TG_AVISO=true
#
# El token y el chat que YA usa el watchdog de este mismo VPS (`/root/.config/onia/backup.env`).
# No hace falta credencial nueva: son los mismos valores, copiados aca.
#   grep -E '^TG_BOT_TOKEN=|^TG_CHAT_ID=' /root/.config/onia/backup.env
# Se aceptan los dos juegos de nombres a proposito (`TELEGRAM_*` es el de `/root/.hermes/.env`),
# asi encender esto no depende de acordarse de cual era. Con poner UNO de cada par alcanza.
TG_BOT_TOKEN=
TG_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Modelo del bot -----------------------------------------------------------
# La clave virtual del bot en LiteLLM (onia-bot-motor, /root/.config/onia/litellm-bot.key) SOLO
# puede usar este modelo. Sin esta linea el lanzador cae a su default (gpt-4o-mini), la clave lo
# rechaza y el arranque vuelve a la master SIN tope (y abre tarea). Medido en el VPS 2026-09-24.
ONIA_BOT_MODEL=gpt-4.1-mini

# --- Encendido en dos pasos --------------------------------------------------
# true = el motor calcula la respuesta real pero NO la postea a Chatwoot (se ve en bot_messages).
# Pasar a false recién después de mirar un rato en seco.
ONIA_BOT_DRY_RUN=true
