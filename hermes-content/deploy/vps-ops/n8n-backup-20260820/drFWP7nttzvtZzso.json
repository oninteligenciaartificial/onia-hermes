    {
      "id": "16cc4941-912a-4030-a231-5ac8b09646a4",
      "name": "Filtrar Ultima Hora y Formatear",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = Date.now();\nconst windowMs = 70 * 60 * 1000;\nconst recent = $input.all().filter((i) => {\n  const t = i.json.stoppedAt || i.json.startedAt;\n  return t && (now - new Date(t).getTime()) <= windowMs;\n});\nif (recent.length === 0) { return []; }\nconst lines = recent.map((i) => '- ' + (i.json.workflowId || 'desconocido') + ' (exec ' + i.json.id + ') ' + i.json.startedAt);\nconst message = 'ONIA - ' + recent.length + ' workflow(s) fallaron en la ultima hora:\\n\\n' + lines.join('\\n') + '\\n\\nRevisa n8n -> Executions (status: error) y arregla la causa raiz.';\nreturn [{ json: { alertCount: recent.length, message } }];"
      }
    },
    {
      "id": "6622a499-4718-46c4-8bc4-f1f9406ed807",
      "name": "Avisar a Sergio",
