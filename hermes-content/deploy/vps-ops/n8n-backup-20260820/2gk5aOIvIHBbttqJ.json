  "name": "ONIA - Aviso de pago QR (Telegram)",
  "description": "Cada 5 min busca subscription_payments status=PENDING que no esten en n8n_ops.payment_alerts_sent (tabla de vistos, evita duplicados) y avisa a Sergio por Telegram (chat 6830070978). Reemplaza el aviso in-app roto por SMTP (Brevo 535). Marca el pago como ",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "60b84cf2-94f9-4380-900b-82ed70f1a327",
      "name": "Cada 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "4be7ecc9-1fa2-48d3-9060-45cb45f98b3e",
      "name": "Asegurar tabla de vistos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "CREATE SCHEMA IF NOT EXISTS n8n_ops;\nCREATE TABLE IF NOT EXISTS n8n_ops.payment_alerts_sent (\n  payment_id text PRIMARY KEY,\n  notified_at timestamptz NOT NULL DEFAULT now()\n);",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "ecF3x3SGUrT0hBbm",
          "name": "Postgres VPS (dentalgest-staging)"
        }
      }
    },
    {
      "id": "559003a1-320f-4145-865f-f48c1b7ed97b",
      "name": "Pagos QR pendientes sin avisar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT\n  sp.id,\n  sp.plan,\n  sp.cycle,\n  sp.amount,\n  COALESCE(sp.\"payerName\", 'N/D') AS \"payerName\",\n  COALESCE(sp.\"bankName\", 'N/D') AS \"bankName\",\n  COALESCE(sp.\"transactionRef\", 'N/D') AS \"transactionRef\",\n  sp.\"receiptUrl\",\n  sp.\"createdAt\",\n  o.name AS \"clinicName\",\n  o.slug\nFROM subscription_payments sp\nJOIN organizations o ON o.id = sp.\"organizationId\"\nWHERE sp.status = 'PENDING'\n  AND NOT EXISTS (\n    SELECT 1 FROM n8n_ops.payment_alerts_sent a WHERE a.payment_id = sp.id\n  )\nORDER BY sp.\"createdAt\" ASC;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "ecF3x3SGUrT0hBbm",
          "name": "Postgres VPS (dentalgest-staging)"
        }
      }
    },
    {
      "id": "e6596d57-3b0f-4e46-9d4c-f9bf1e4a532e",
      "name": "Avisar a Sergio (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "6830070978",
        "text": "=Nuevo pago QR pendiente\n\nClinica: {{ $json.clinicName }} ({{ $json.slug }})\nPagador: {{ $json.payerName }}\nPlan: {{ $json.plan }} ({{ $json.cycle }})\nMonto: Bs. {{ $json.amount }}\nBanco: {{ $json.bankName }}\nRef: {{ $json.transactionRef }}\nFecha: {{ $json.createdAt }}\n\nComprobante: {{ $json.receiptUrl || \"no adjunto\" }}\n\nRevisar y aprobar: https://app.onia.com.bo/admin/payments",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "r8y2CN5RyOEIDce3",
          "name": "Telegram account"
        }
      },
      "webhookId": "9cc9868a-7fa4-4d89-8a56-399280b04d30"
    },
    {
      "id": "974d940e-b698-45ef-a1b0-0ff066107288",
      "name": "Marcar aviso enviado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        960,
