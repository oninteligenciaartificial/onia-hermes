      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "INSERT INTO n8n_ops.payment_alerts_sent (payment_id) VALUES ($1) ON CONFLICT (payment_id) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ $('Pagos QR pendientes sin avisar').item.json.id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "ecF3x3SGUrT0hBbm",
          "name": "Postgres VPS (dentalgest-staging)"
        }
      }
    }
