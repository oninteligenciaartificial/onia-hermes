    {
      "id": "2b91e5d4-9103-447f-a15e-24e04a91ed41",
      "name": "Obtener eventos del día",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "business@onia.com.bo"
        },
        "returnAll": false,
        "limit": 25,
        "timeMin": "={{ $now.setZone(\"America/La_Paz\").startOf(\"day\").toISO() }}",
        "timeMax": "={{ $now.setZone(\"America/La_Paz\").endOf(\"day\").toISO() }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "AIf6aLd0Q1yAqXKj",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "id": "c21853c0-f722-44e7-8577-b5928a7c6484",
      "name": "Formatear resumen diario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const events = $input.all();\nconst today = DateTime.now().setZone('America/La_Paz');\nconst months = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];\nconst days = ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];\nconst dayName = days[today.weekday % 7];\nconst dateStr = dayName + ' ' + today.day + ' de ' + months[today.month - 1];\nlet message = '📅 **Agenda del día — ' + dateStr.charAt(0).toUpperCase() + dateStr.slice(1) + '**\\n\\n';\nif (events.length === 0) {\n  message += '✅ No tienes eventos hoy. ¡Día libre!';\n} else {\n  message += 'Tienes **' + events.length + '** evento(s) hoy:\\n\\n';\n  for (const item of events) {\n    const e = item.json;\n    let timeStr = 'Todo el día';\n    if (e.start && e.start.dateTime) {\n      const startDT = DateTime.fromISO(e.start.dateTime).setZone('America/La_Paz');\n      timeStr = startDT.toFormat('HH:mm');\n      if (e.end && e.end.dateTime) {\n        const endDT = DateTime.fromISO(e.end.dateTime).setZone('America/La_Paz');\n        timeStr += ' - ' + endDT.toFormat('HH:mm');\n      }\n    }\n    message += '🕐 **' + (e.summary || 'Sin título') + '**\\n';\n    message += '⏰ ' + timeStr + '\\n';\n    if (e.description) { message += '📝 ' + e.description.substring(0, 150) + '\\n'; }\n    message += '\\n';\n  }\n}\nreturn [{ json: { message } }];"
      }
    },
    {
      "id": "dfda44bc-a408-425d-8f26-a7a49337c0d2",
      "name": "Enviar resumen a Discord",
