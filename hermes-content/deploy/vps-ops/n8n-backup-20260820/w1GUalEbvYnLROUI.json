    {
      "id": "11112f08-a2e3-466e-83dd-d67c615a11f3",
      "name": "Parsear comentario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $('Webhook Comentario IG').first().json.body || {};\nconst ch = ((b.entry || [])[0] || {}).changes || [];\nconst c0 = ch[0] || {};\nconst v = c0.value || {};\nconst texto = String(v.text || '').toUpperCase();\nconst fromId = String((v.from || {}).id || '');\nconst MIOS = ['17841423363059652', '27942557688720145'];\nlet palabra = null;\nif (texto.includes('SISTEMA')) palabra = 'SISTEMA';\nelse if (texto.includes('LISTA')) palabra = 'LISTA';\nconst propio = MIOS.includes(fromId);\nconst esComentario = c0.field === 'comments';\nconst accionable = palabra === 'SISTEMA' && !propio && esComentario && Boolean(v.id);\nlet motivo = 'ok';\nif (!esComentario) motivo = 'no_es_comentario';\nelse if (propio) motivo = 'comentario_propio';\nelse if (!palabra) motivo = 'sin_palabra_clave';\nelse if (palabra === 'LISTA') motivo = 'LISTA_sin_pdf_publicado';\nreturn [{ json: { comment_id: v.id || '', texto: v.text || '', from_id: fromId, username: (v.from || {}).username || '', media_id: (v.media || {}).id || '', palabra: palabra, propio: propio, accionable: accionable, motivo: motivo } }];"
      }
    },
    {
      "id": "73869c26-aaae-425b-b5e5-63769083b861",
      "name": "Accionable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-acc",
              "leftValue": "={{ $json.accionable }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "99dcd339-fe1a-4788-86a5-94aa467c3720",
