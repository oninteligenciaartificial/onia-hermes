  "name": "WF-DISCORD-02: Recordatorios de Eventos",
  "description": "Cada 15 minutos revisa Google Calendar. Si hay un evento empezando en 15-35 min, envía un recordatorio al canal Discord.",
  "active": false,
  "isArchived": true,
  "nodes": [
    {
      "id": "46d26f6f-b752-44d9-bc45-ce746b8a053a",
      "name": "Cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "f9ca4f00-211a-4783-8dc0-480aae4aa051",
      "name": "Eventos próximos 15-35 min",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "business@onia.com.bo"
        },
        "returnAll": false,
        "limit": 10,
        "timeMin": "={{ $now.plus({ minutes: 15 }).toISO() }}",
        "timeMax": "={{ $now.plus({ minutes: 35 }).toISO() }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "AIf6aLd0Q1yAqXKj",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "id": "8e684cb1-7804-42e7-8ac6-9495fedae793",
      "name": "Enviar recordatorio",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "authentication": "botToken",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "1508571461663719454"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "1508571462196400303"
        },
        "content": "={{ \"⏰ **Recordatorio** — En ~30 min tienes:\\n🕐 **\" + $json.summary + \"**\\n⏱️ \" + ($json.start && $json.start.dateTime ? DateTime.fromISO($json.start.dateTime).setZone(\"America/La_Paz\").toFormat(\"HH:mm\") : \"Todo el día\") }}"
      },
      "webhookId": "58f9df52-2b73-4bca-af3e-0a7e345dc0e8",
      "credentials": {
        "discordBotApi": {
          "id": "4K40hl2Un0aWGges",
          "name": "Discord Bot account"
        }
      }
    }
