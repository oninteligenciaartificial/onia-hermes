    {
      "id": "03a4f24d-1357-445c-97f5-f77136f3d0bb",
      "name": "Armar agenda del dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst evs = items.map(i => i.json).filter(e => e && (e.start || e.summary));\nfunction fmt(e) {\n  let hora = \"todo el dia\";\n  if (e.start && e.start.dateTime) {\n    hora = new Date(e.start.dateTime).toLocaleTimeString(\"es-BO\", { timeZone: \"America/La_Paz\", hour: \"2-digit\", minute: \"2-digit\" });\n  }\n  return \"• \" + hora + \" - \" + (e.summary || \"(sin titulo)\");\n}\nevs.sort((a, b) => String((a.start && a.start.dateTime) || \"\").localeCompare(String((b.start && b.start.dateTime) || \"\")));\nconst hoy = new Date().toLocaleDateString(\"es-BO\", { timeZone: \"America/La_Paz\", weekday: \"long\", day: \"2-digit\", month: \"long\" });\nconst L = [];\nL.push(\"☀️ Arranque del dia - \" + hoy);\nL.push(\"\");\nif (evs.length === 0) {\n  L.push(\"Hoy no tenes reuniones agendadas. Dia despejado para foco profundo.\");\n} else {\n  L.push(\"Tu agenda de hoy (\" + evs.length + \"):\");\n  for (const e of evs) L.push(fmt(e));\n}\nL.push(\"\");\nconst focos = [\"Energia: bloquea 90 min sin notificaciones para lo que mueve la aguja.\", \"Foco: elegi UNA cosa que si la cerras hoy, el dia valio.\", \"Responder no es avanzar; avanza primero lo importante.\", \"Antes de abrir el chat, define el resultado del dia en una frase.\"];\nL.push(\"💡 \" + focos[new Date().getDate() % focos.length]);\nreturn { json: { text: L.join(String.fromCharCode(10)).slice(0, 3900), chatId: \"6830070978\", count: evs.length } };"
      }
    },
