  "name": "ONIA - Agenda Create API",
  "description": "Webhook POST /agendar-create: recibe titulo/startISO/endISO/descripcion, crea evento en Google Calendar y responde JSON con htmlLink. Llamado por Hermes VPS.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "2ef0be14-8b03-4328-b9ae-3c9b1a682068",
      "name": "Agendar Create Hook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "agendar-create",
        "responseMode": "responseNode"
      },
      "webhookId": "f0ab1aae-60c6-43fd-b67c-9d1a2301bc3f"
    },
    {
      "id": "8558e753-d616-49e4-a733-00239ea8c2d4",
      "name": "Crear Evento GCal",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "oninteligenciaartificial@gmail.com"
        },
        "start": "={{ $json.body.startISO }}",
        "end": "={{ $json.body.endISO }}",
        "additionalFields": {
          "summary": "={{ $json.body.titulo }}",
          "description": "={{ $json.body.descripcion }}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "a3FResZHqQ32ptyt",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "id": "de1a9685-f56d-4469-83f9-d55dd05100c3",
      "name": "Responder JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, summary: $json.summary, htmlLink: $json.htmlLink, id: $json.id }) }}"
      }
    }
  ],
