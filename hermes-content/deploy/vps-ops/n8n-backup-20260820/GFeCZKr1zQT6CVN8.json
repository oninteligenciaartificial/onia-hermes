    {
      "id": "a964de31-41dd-4fb4-9725-7c1153231ff9",
      "name": "Evaluar QA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = items[0]?.json || {};\nconst stdout = String(raw.stdout || '').trim();\nlet q = null;\ntry { const s = stdout.indexOf('{'); q = s >= 0 ? JSON.parse(stdout.slice(s)) : null; } catch (e) { q = null; }\nconst exitCode = typeof raw.code === 'number' ? raw.code : (typeof raw.exitCode === 'number' ? raw.exitCode : 1);\nlet alert = false, message = '';\nif (!q || exitCode !== 0) { alert = true; message = 'Web Factory QA: no se pudo evaluar (exitCode=' + exitCode + ')\\n' + String(raw.stderr || stdout).slice(-400); }\nelse if (q.ok === false) { alert = true; message = 'Web Factory QA: TEMPLATES ROTOS\\n' + (q.broken || 'ver detalle') + '\\n(' + q.checked + ' demos chequeados)'; }\nreturn [{ json: { alert, ok: q ? q.ok : false, checked: q ? q.checked : 0, message } }];"
      }
    },
    {
      "id": "1df3d217-8797-484c-a4f0-f2344ad9856a",
      "name": "Roto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1140,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "alert",
              "leftValue": "={{ $json.alert }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "049b7dde-1e31-4f20-abb5-9430113828b6",
      "name": "Alerta Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
