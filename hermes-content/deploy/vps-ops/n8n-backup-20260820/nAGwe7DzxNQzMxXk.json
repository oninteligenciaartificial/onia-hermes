        "text": "={{ \"Recibido: \" + $(\"Extraer links de video\").first().json.cuantos + \" link(s). Bajando y leyendo el video; la ficha se commitea en hermes-content/references/video-intake/ y te aviso al terminar.\" }}",
        "additionalFields": {},
