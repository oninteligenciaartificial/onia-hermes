  "name": "ONIA - Video Intake (link por Telegram)",
  "description": "Sergio manda un link de IG/TikTok/YouTube por Telegram y dispara el workflow video-intake de GitHub Actions (repository_dispatch), que baja el video, lo ve, lo transcribe y commitea la ficha. El token de GitHub va como CREDENCIAL Header Auth, nunca en el ",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "34f104c0-71fb-4904-ad4c-291ebdc2819a",
      "name": "Link por Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "credentials": {
        "telegramApi": {
          "id": "r8y2CN5RyOEIDce3",
          "name": "Telegram account"
        }
      },
      "webhookId": "76d269dd-4abf-418a-abb4-1c813fb07ddf"
    },
    {
      "id": "8987134b-fbcb-4a2d-a8c9-060fda9ba780",
      "name": "Extraer links de video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const m = $input.first().json.message || {};\nconst texto = (m.text || '') + ' ' + (m.caption || '');\nconst encontrados = texto.match(/https?:\\/\\/\\S*?(?:instagram\\.com|tiktok\\.com|youtube\\.com|youtu\\.be)\\S*/gi) || [];\nif (!encontrados.length) return [];\nreturn [{ json: { urls: encontrados.join(' '), cuantos: encontrados.length, chatId: m.chat.id } }];"
      }
    },
    {
      "id": "862b3341-4af1-4dd2-aad3-ea3a455c3694",
      "name": "Disparar video-intake en GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/oninteligenciaartificial/onia-hermes/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "onia-n8n"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: \"video-intake\", client_payload: { urls: $json.urls } }) }}",
        "options": {}
      }
    },
    {
      "id": "4c266770-39f8-4f6a-b1d8-514846febff5",
      "name": "Avisar que entro",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
