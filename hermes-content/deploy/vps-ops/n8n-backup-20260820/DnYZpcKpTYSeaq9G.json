  "name": "Hermes TEMP - DentalGest PostgREST Status Check",
  "description": "Temporary manual read-only check for DentalGest PostgREST/Data API configuration and public.n8n_* function visibility.",
  "active": false,
  "isArchived": true,
  "nodes": [
    {
      "id": "5f468805-29e3-4319-94ac-2d46908cb802",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
