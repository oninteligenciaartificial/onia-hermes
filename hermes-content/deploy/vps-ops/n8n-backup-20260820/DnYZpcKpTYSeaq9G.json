      ],
      "parameters": {}
    },
    {
      "id": "0bfb88e8-82df-40e5-9f63-e345dd4d12c4",
      "name": "Check DentalGest Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        540,
        300
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "WITH role_config AS (\n  SELECT coalesce(array_to_string(rolconfig, E'\\n'), '') AS authenticator_config\n  FROM pg_roles\n  WHERE rolname = 'authenticator'\n), function_count AS (\n  SELECT count(*)::int AS n8n_function_count\n  FROM pg_proc p\n  JOIN pg_namespace n ON n.oid = p.pronamespace\n  WHERE n.nspname = 'public'\n    AND p.proname LIKE 'n8n_%'\n)\nSELECT\n  (SELECT authenticator_config FROM role_config) AS authenticator_config,\n  (SELECT n8n_function_count FROM function_count) AS n8n_function_count,\n  now() AS checked_at;",
        "options": {
          "queryBatching": "single"
        }
      },
      "credentials": {
        "postgres": {
          "id": "2P4w95n0vir90EkT",
          "name": "Postgres account"
        }
      }
    }
  ],
