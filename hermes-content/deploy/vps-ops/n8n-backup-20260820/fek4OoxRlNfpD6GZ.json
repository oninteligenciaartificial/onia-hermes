  "id": "fek4OoxRlNfpD6GZ",
  "name": "ONIA - Disparador de Agentes (panel)",
  "description": "Webhook desde ONIA Center: recibe agentId/agentName del panel, mapea al script del agente y lo corre en el VPS por SSH (mismo patron que los crons). No toca los workflows de cron existentes.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "fb02d2e8-04ba-48f1-80f9-d03c70462a0b",
      "name": "Disparo desde panel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "onia-center-disparar-agente",
        "responseMode": "responseNode"
      },
      "webhookId": "16711e62-4b73-48ae-a84a-d2c3e715c31d"
    },
    {
      "id": "94141565-458b-4a97-b892-2613130661a2",
      "name": "Mapear agente a script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// El cuerpo se lee del WEBHOOK explicitamente: despues del chequeo de secreto, la entrada de\n// este nodo es la salida del SSH, no el request original.\nconst src = $('Disparo desde panel').first().json.body || {};\nconst name = String(src.agentName || '').toLowerCase();\nlet script = '';\nif (name.includes('vendedor') || name.includes('sales')) script = 'sales-agent-run.sh';\nelse if (name.includes('contenido') || name.includes('media')) script = 'content-media-agent-run.sh';\nelse if (name.includes('finanzas') || name.includes('fondo') || name.includes('finance')) script = 'finance-fund-agent-run.sh';\nelse if (name.includes('building') || name.includes('public')) script = 'building-public-agent-run.sh';\nconst command = script ? ('timeout 300 bash /opt/onia/' + script) : 'echo sin-script-disparable';\nreturn [{ json: { script, command, agentName: src.agentName || '' } }];"
      }
    },
    {
      "id": "3a63e87e-6e04-4226-8932-e8dcbd3008ce",
      "name": "Correr agente en VPS",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "authentication": "privateKey",
        "command": "={{ $json.command }}",
        "cwd": "/root"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "4XKauEX3b6cqaDhW",
          "name": "ONIA VPS SSH"
        }
      }
    },
    {
      "id": "fe3fb82e-28ea-4bbe-8abb-39214a6d533d",
      "name": "Responder al panel",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "respondWith": "firstIncomingItem"
      }
    },
    {
      "id": "1f473e06-6d16-40fb-b149-0d0828ae039b",
      "name": "Verificar secret",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        224,
        200
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "cwd": "/root",
        "authentication": "privateKey",
        "command": "={{ 'bash /opt/onia/check-secret.sh \"' + String($json.headers['x-onia-webhook-secret'] || '').replace(/[^\\w\\-\\.=+\\/]/g, '') + '\"' }}"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "4XKauEX3b6cqaDhW",
          "name": "ONIA VPS SSH"
        }
      }
    },
    {
      "id": "9921597c-1dd0-4598-a94e-2fc927147f8c",
      "name": "Autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-auth",
              "leftValue": "={{ $json.stdout }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              },
              "rightValue": "\"authorized\":true"
            }
          ]
        }
      }
    },
    {
      "id": "262a86a7-798e-4f8e-ba56-1a531ccf1ded",
      "name": "Responder No Autorizado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        672,
        320
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"reason\": \"unauthorized\" } }}",
        "options": {
          "responseCode": 401
        }
      }
    }
  ],
