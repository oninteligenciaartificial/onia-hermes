    {
      "id": "a836362e-8656-482a-845b-33f12905954f",
      "name": "Code: Aggregate Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        192
      ],
      "parameters": {
        "jsCode": "const apt = $('Supabase: Weekly Appointments').first().json;\nconst rev = $('Supabase: Weekly Revenue').first().json;\nconst pat = $('Supabase: New Patients').first().json;\n\nconst total = apt.total_appointments || 0;\nconst noShowRate = total > 0 ? Math.round(((apt.no_shows || 0) / total) * 100) : 0;\n\nreturn {\n  json: {\n    clinicName: $('Split: Per Clinic').first().json.clinicName,\n    clinicSlug: $('Split: Per Clinic').first().json.slug,\n    adminName: $('Split: Per Clinic').first().json.adminName,\n    adminEmail: $('Split: Per Clinic').first().json.adminEmail,\n    totalAppointments: total,\n    completed: apt.completed || 0,\n    cancelled: apt.cancelled || 0,\n    noShows: apt.no_shows || 0,\n    noShowRate: noShowRate + '%',\n    revenuePaid: Number(rev.paid || 0).toLocaleString('es-BO'),\n    revenuePending: Number(rev.pending || 0).toLocaleString('es-BO'),\n    paidInvoices: rev.paid_count || 0,\n    pendingInvoices: rev.pending_count || 0,\n    newPatients: pat.new_patients || 0,\n  }\n};"
      }
    },
