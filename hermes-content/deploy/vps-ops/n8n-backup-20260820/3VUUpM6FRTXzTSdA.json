        "operation": "send",
        "sendTo": "={{ $json.adminEmail }}",
        "subject": "=Reporte semanal de {{ $json.clinicName }}",
        "emailType": "html",
        "message": "=<h2>Reporte semanal de {{ $json.clinicName }}</h2><p>Hola {{ $json.adminName }},</p><h3>CITAS</h3><ul><li>Total: {{ $json.totalAppointments }}</li><li>Completadas: {{ $json.completed }}</li><li>Canceladas: {{ $json.cancelled }}</li><li>No-shows: {{ $json.noShows }} ({{ $json.noShowRate }})</li></ul><h3>INGRESOS</h3><ul><li>Facturas pagadas: {{ $json.paidInvoices }} (Bs. {{ $json.revenuePaid }})</li><li>Facturas pendientes: {{ $json.pendingInvoices }} (Bs. {{ $json.revenuePending }})</li></ul><h3>PACIENTES</h3><ul><li>Nuevos esta semana: {{ $json.newPatients }}</li></ul><p><a href=\"https://app.onia.com.bo/dashboard\">Ver dashboard completo</a></p><p>- Onia</p>",
        "options": {}
