        }
      }
    },
    {
      "id": "10766f5e-3547-41c8-9764-1e3544f6aab0",
      "name": "Evaluar salud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = items[0]?.json || {};\nconst stdout = String(raw.stdout || '').trim();\nlet h = null;\ntry { const s = stdout.indexOf('{'); h = s >= 0 ? JSON.parse(stdout.slice(s)) : null; } catch (e) { h = null; }\nconst exitCode = typeof raw.code === 'number' ? raw.code : (typeof raw.exitCode === 'number' ? raw.exitCode : 0);\nlet alert = false; let message = '';\nif (!h || exitCode !== 0) {\n  alert = true;\n  message = 'ONIA VPS Healthcheck: no se pudo leer estado (exitCode=' + exitCode + ').\\n' + String(raw.stderr || stdout).slice(-500);\n} else if (h.ok === false) {\n  alert = true;\n  message = 'ONIA VPS: PROBLEMA\\n' + (h.problems || 'ver detalle') + '\\ndisco=' + h.disk + '% mem=' + h.mem + '%\\nRevisar: docker ps / df -h en 187.77.16.63';\n}\nreturn [{ json: { alert, ok: h ? h.ok : false, disk: h ? h.disk : null, mem: h ? h.mem : null, message } }];"
      }
    },
    {
      "id": "63f2d0f9-327b-4c28-b1b6-747808afa2f8",
      "name": "Hay problema?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1140,
        300
      ],
      "parameters": {
