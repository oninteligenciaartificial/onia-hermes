        "jsonBody": "={{ JSON.stringify({ recipient: { comment_id: $(\"Parsear comentario\").item.json.comment_id }, message: { text: \"Hola! Vi tu comentario. Te dejo el link para agendar el diagnostico de 20 min: miramos tu operacion y te decimos que conviene automatizar primero, y que no vale la pena todavia. https://onia.com.bo/?src=onia-ig-sistema . Si preferis, contame en una linea a que se dedica tu negocio y te adelanto por aca.\" } }) }}",
