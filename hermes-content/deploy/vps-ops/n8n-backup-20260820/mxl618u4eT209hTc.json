    {
      "id": "104297a2-6952-4f05-928d-52783c77f785",
      "name": "Parsear comentario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $('Webhook Comentario IG').first().json.body || {};\nconst ch = ((b.entry || [])[0] || {}).changes || [];\nconst c0 = ch[0] || {};\nconst v = c0.value || {};\nconst texto = String(v.text || '').toUpperCase();\nconst fromId = String((v.from || {}).id || '');\nconst MIOS = ['17841423363059652', '27942557688720145'];\nlet palabra = null;\nif (texto.includes('SISTEMA')) palabra = 'SISTEMA';\nelse if (texto.includes('LISTA')) palabra = 'LISTA';\nconst propio = MIOS.includes(fromId);\nconst esComentario = c0.field === 'comments';\nconst accionable = palabra === 'SISTEMA' && !propio && esComentario && Boolean(v.id) && /^[0-9]+$/.test(fromId);\nlet motivo = 'ok';\nif (!esComentario) motivo = 'no_es_comentario';\nelse if (propio) motivo = 'comentario_propio';\nelse if (!palabra) motivo = 'sin_palabra_clave';\nelse if (palabra === 'LISTA') motivo = 'LISTA_sin_pdf_publicado';\nreturn [{ json: { comment_id: v.id || '', texto: v.text || '', from_id: fromId, username: (v.from || {}).username || '', media_id: (v.media || {}).id || '', palabra: palabra, propio: propio, accionable: accionable, motivo: motivo } }];"
      }
    },
    {
