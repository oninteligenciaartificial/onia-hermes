          "value": "1508571461663719454"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "1508571462196400303"
        },
        "content": "={{ $json.message }}"
      },
      "credentials": {
        "discordBotApi": {
          "id": "4K40hl2Un0aWGges",
          "name": "Discord Bot account"
        }
      },
      "webhookId": "23c8ecd9-3ccf-47fa-ad54-0fc7a5645ac4"
    }
