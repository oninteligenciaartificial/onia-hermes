    {
      "id": "d36efb5e-a9a1-45f8-9eb6-57f68f01dea0",
      "name": "Fetch Subscriptions from Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://jafxylfocvvlflpqfsix.supabase.co/rest/v1/personal_subscriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "activa",
              "value": "eq.true"
            },
            {
              "name": "dia_cobro",
              "value": "=eq.{{ $now.setZone(\"America/La_Paz\").plus({ days: 3 }).day }}"
            },
            {
              "name": "select",
              "value": "nombre,monto,moneda,frecuencia,dia_cobro"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "81402f47-60b6-49e1-88c9-9a1bc6856dce",
      "name": "Check Has Subscriptions",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "993cfab6-f99c-406d-9c3f-8a487021e0fb",
      "name": "Format Discord Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nlet lines = [];\nlet totalsByCurrency = {};\n\nfor (const item of items) {\n  const { nombre, monto, moneda } = item.json;\n  lines.push('• ' + nombre + ' — $' + monto + ' ' + moneda);\n  if (!totalsByCurrency[moneda]) totalsByCurrency[moneda] = 0;\n  totalsByCurrency[moneda] += Number(monto);\n}\n\nconst totalsLine = Object.entries(totalsByCurrency)\n  .map(([currency, total]) => '$' + total + ' ' + currency)\n  .join(' + ');\n\nconst message = '💳 **Alerta de cobro próximo**\\nEn 3 días se cobrarán:\\n' + lines.join('\\n') + '\\n**Total: ' + totalsLine + '**';\n\nreturn [{ json: { message } }];\n"
      }
    },
    {
      "id": "3ebb957a-403c-4181-80d4-dc1c12a1e619",
      "name": "Send Discord Alert",
