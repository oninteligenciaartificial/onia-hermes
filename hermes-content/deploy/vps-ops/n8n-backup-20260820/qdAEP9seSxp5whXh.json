    {
      "id": "d50ce735-6e60-410f-8a58-ee66e459cf51",
      "name": "Formatear Agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst hoy = new Date().toLocaleDateString('es-BO', { timeZone: 'America/La_Paz', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\nlet msg = '📅 <b>Agenda ' + hoy + '</b>\\n\\n';\nconst eventos = items.filter(i => i.json.id);\nif (eventos.length === 0) {\n  msg += '✅ Día libre — sin eventos agendados.';\n} else {\n  for (const item of eventos) {\n    const ev = item.json;\n    const s = ev.start && ev.start.dateTime ? new Date(ev.start.dateTime).toLocaleTimeString('es-BO', { timeZone: 'America/La_Paz', hour: '2-digit', minute: '2-digit' }) : 'Todo el día';\n    const e = ev.end && ev.end.dateTime ? new Date(ev.end.dateTime).toLocaleTimeString('es-BO', { timeZone: 'America/La_Paz', hour: '2-digit', minute: '2-digit' }) : '';\n    msg += '⏰ ' + s + (e ? ' - ' + e : '') + '  <b>' + (ev.summary || 'Sin título') + '</b>\\n';\n  }\n}\nreturn [{ json: { mensaje: msg } }];"
      }
    },
