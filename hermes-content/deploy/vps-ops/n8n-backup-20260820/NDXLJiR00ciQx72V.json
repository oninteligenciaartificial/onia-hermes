      "name": "Fecha + pilar del dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const date = new Date().toLocaleDateString('es-BO', { timeZone: 'America/La_Paz' });\nconst pilares = ['Dolor real (proceso manual que pierde plata/tiempo)','Antes/Despues (sin metricas falsas)','Caso de uso concreto (chatbot / web que capta / automatizacion)','Educativo o mito de IA para pyme','Detras de escena de ONIA','Autoridad Sergio fundador'];\nconst i = Math.floor(Date.now()/86400000) % pilares.length;\nreturn [{ json: { date, pilarDelDia: pilares[i] } }];"
      }
    },
    {
      "id": "7eb19797-d5ee-45e2-880b-60c5477671b0",
      "name": "Generar guiones (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "system",
              "content": "Eres el guionista de contenido propio de ONIA, agencia de IA practica para negocios de Bolivia. Escribes guiones listos para producir, claros y directos, sin humo. REGLAS: no inventes testimonios, metricas, resultados ni precios; antes/despues sin numeros falsos; inspiracion estructural, nunca copiar identidad; nada se publica sin aprobacion; cara/voz IA de Sergio solo con aprobacion. Formato de CADA guion: GUION N - [Pilar] - [Formato] / Gancho (0-3s): / Desarrollo: / Cierre + CTA: / Texto en pantalla: / Prompt visual: / Voz-tono: / Duracion."
            },
            {
              "type": "text",
              "role": "user",
              "content": "='Genera 3 guiones ONIA para hoy ' + $json.date + '. Guion 1 = Reel priorizando el pilar: ' + $json.pilarDelDia + '. Guion 2 = Carrusel. Guion 3 = Historia. Cierra con \"Guion recomendado para hoy:\" y \"Siguiente comando:\".'"
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "oAEdJ5GA8hOYB83l",
          "name": "OpenAi account"
        }
      }
    },
    {
      "id": "d4a153bb-8a65-4e56-b6ae-1a1b1eea9925",
      "name": "Preparar mensaje Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const j = items[0].json || {};\nconst content = j.content || j.output || j.text || j.response || (j.message && j.message.content) || (j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content) || '';\nconst NL = String.fromCharCode(10);\nconst date = new Date().toLocaleDateString('es-BO', { timeZone: 'America/La_Paz' });\nconst body = typeof content === 'string' ? content : JSON.stringify(content);\nconst head = 'ONIA | Guiones de contenido ' + date;\nconst foot = 'Nada se publica sin tu OK. Para producir: Genera Reel ONIA: <tema>.';\nconst text = body ? (head + NL + NL + body + NL + NL + foot) : (head + NL + 'No se pudo generar. Revisar nodo OpenAI en n8n.');\nreturn [{ json: { text: text.slice(0, 3900) } }];\n"
      }
    },
