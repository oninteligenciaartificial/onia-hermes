  "name": "ONIA - Web Factory VPS Radar",
  "description": "Corre el worker de Web Factory en el VPS por SSH (Lun-Sab 07:10 La Paz), normaliza el resultado y notifica a Sergio por Telegram. Nodo SSH usa credencial ONIA VPS SSH. Comando: node scripts/web-factory-vps-automation.mjs --mode daily en /opt/onia-hermes/w",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "b2d1b67f-33ea-49ae-8e71-8614397394c1",
      "name": "Lunes a sabado 07:10",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 7 * * 1-6"
            }
          ]
        }
      }
    },
    {
      "id": "c194269a-4e01-4539-95aa-c1fc5623ba38",
      "name": "Run Web Factory worker on VPS",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        540,
        300
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "authentication": "privateKey",
        "cwd": "/opt/onia-hermes/web-factory",
        "command": "cd /opt/onia-hermes/web-factory && node scripts/web-factory-vps-automation.mjs --mode daily"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "4XKauEX3b6cqaDhW",
          "name": "ONIA VPS SSH"
        }
      }
    },
    {
      "id": "b1d0b04b-36d8-47a4-a081-f6eb9a89de47",
      "name": "Normalize worker result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = items[0]?.json || {};\nconst stdout = String(raw.stdout || '').trim();\nlet parsed = null;\ntry {\n  const start = stdout.indexOf('{');\n  parsed = start >= 0 ? JSON.parse(stdout.slice(start)) : null;\n} catch (error) {\n  parsed = null;\n}\nconst report = parsed || {};\nconst steps = Array.isArray(report.steps) ? report.steps : [];\nconst failedStep = steps.find((step) => !step.ok);\nconst exitCode = typeof raw.code === 'number' ? raw.code : (typeof raw.exitCode === 'number' ? raw.exitCode : 1);\nconst ok = exitCode === 0 && report.ok !== false && !failedStep;\nconst lines = [\n  ok ? 'ONIA Web Factory VPS: OK' : 'ONIA Web Factory VPS: FALLO',\n  `mode=${report.mode || 'daily'} runId=${report.runId || 'sin-run-id'}`,\n  `exitCode=${exitCode} report=${report.reportPath || '/var/log/onia/web-factory/latest-web-factory-vps-automation.json'}`,\n  failedStep ? `failedStep=${failedStep.id || 'unknown'}` : `steps=${steps.length}`,\n];\nif (raw.stderr) lines.push(String(raw.stderr).slice(-800));\nreturn [{ json: { ok, exitCode, runId: report.runId || '', reportPath: report.reportPath || '', failedStep: failedStep?.id || '', message: lines.join('\\n').slice(0, 3900) } }];"
      }
    },
    {
      "id": "defc5280-33af-4677-9eda-2c1337d0e5a8",
      "name": "Telegram configured?",
      "type": "n8n-nodes-base.if",
