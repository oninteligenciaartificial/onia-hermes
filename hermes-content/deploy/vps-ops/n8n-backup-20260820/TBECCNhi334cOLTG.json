      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const NL = String.fromCharCode(10);\nconst raw = ($input.first().json.stdout || \"\").trim();\nlet s;\ntry { s = JSON.parse(raw.split(NL).pop()); } catch (e) { s = { text: \"Agente ONIA: no pude leer la salida.\", notify: true }; }\nreturn [{ json: { text: String(s.text || \"(sin contenido)\").slice(0, 3900), notify: s.notify === true } }];"
      }
