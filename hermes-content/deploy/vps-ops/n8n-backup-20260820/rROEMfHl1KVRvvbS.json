        "jsCode": "const items = $input.all();\nconst lines = items.map((i) => '- ' + (i.json.patientName || '?') + ' / ' + (i.json.clinicName || '?') + ' / ' + (i.json.dateTime || '?')).join('\\n');\nreturn [{ json: { summary: 'DRY-RUN DentalGest WF-00 (recordatorios 24h): ' + items.length + ' paciente(s) que el sistema contactaria. NO se envio nada.\\n\\n' + lines + '\\n\\nSi las listas estan bien, avisa para activar envio real.' } }];"
