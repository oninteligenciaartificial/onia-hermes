    {
      "id": "bde1347f-0a26-4c94-8c9f-59723a76336f",
      "name": "Formatear Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst items = $input.all();\n\n// Filter out pages where Status is \"Done\" or \"Completado\"\nconst pendingTasks = items.filter(item => {\n  const props = item.json.properties || {};\n  \n  // Check common status property names\n  const statusProp = props.Status || props.Estado || props.status || props.estado;\n  \n  if (!statusProp) return true; // Include if no status property found\n  \n  let statusValue = '';\n  \n  if (statusProp.select) {\n    statusValue = statusProp.select?.name || '';\n  } else if (statusProp.status) {\n    statusValue = statusProp.status?.name || '';\n  } else if (typeof statusProp === 'string') {\n    statusValue = statusProp;\n  }\n  \n  const doneStatuses = ['done', 'completado', 'completed', 'terminado', 'finalizado'];\n  return !doneStatuses.includes(statusValue.toLowerCase());\n});\n\nif (pendingTasks.length === 0) {\n  return [{ json: { skip: true, message: '' } }];\n}\n\n// Extract task names\nconst taskLines = pendingTasks.map(item => {\n  const props = item.json.properties || {};\n  \n  // Try different common title property names\n  const nameProp = props.Name || props.Nombre || props.Title || props.Titulo || props.name || props.title;\n  \n  let taskName = 'Sin título';\n  \n  if (nameProp) {\n    if (nameProp.title && Array.isArray(nameProp.title)) {\n      taskName = nameProp.title.map(t => t.plain_text || '').join('') || 'Sin título';\n    } else if (nameProp.rich_text && Array.isArray(nameProp.rich_text)) {\n      taskName = nameProp.rich_text.map(t => t.plain_text || '').join('') || 'Sin título';\n    } else if (typeof nameProp === 'string') {\n      taskName = nameProp;\n    }\n  }\n  \n  return '• ' + taskName;\n});\n\nconst message = '📋 **Tareas pendientes de hoy**\\n\\n' + taskLines.join('\\n') + '\\n\\nTotal: ' + pendingTasks.length + ' tareas';\n\nreturn [{ json: { skip: false, message: message, taskCount: pendingTasks.length } }];\n"
      }
    },
