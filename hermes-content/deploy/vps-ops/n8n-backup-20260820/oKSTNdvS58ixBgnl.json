      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = ($input.first().json.stdout || '').trim();\nlet s;\ntry { s = JSON.parse(raw.split('\\n').pop()); } catch (e) { s = { ok: false, fatal: 'parse', raw: raw.slice(0, 200) }; }\nconst notify = (!s.ok) || (s.notify === true);\nlet text;\nif (!s.ok) {\n  text = 'Agente Finanzas ONIA - ERROR: ' + (s.fatal || 'desconocido');\n} else {\n  const anomalies = Array.isArray(s.anomalies) ? s.anomalies : [];\n  text = (s.text || ('Agente Finanzas ONIA: resumen ' + (s.summary_key || '') + ' generado.')).slice(0, 3900);\n  if (anomalies.length) text = 'ANOMALIAS FINANZAS (' + anomalies.length + ') - accion requerida\\n\\n' + text;\n}\nreturn [{ json: { notify: notify, text: text } }];"
      }
