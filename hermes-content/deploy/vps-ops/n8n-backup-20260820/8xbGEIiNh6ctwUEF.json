  "name": "WF-00: Appointment Reminders",
  "description": null,
  "active": false,
  "isArchived": true,
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Schedule: Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "minutesInterval": 60
            }
          ]
        }
      }
    },
    {
      "id": "pg-24h",
      "name": "Supabase: Get 24h Appointments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "kXsaPlwveqzzNOmY",
          "name": "Supabase account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.\"dateTime\", a.status, p.name AS \"patientName\", p.email AS \"patientEmail\", o.name AS \"clinicName\", '24h' AS \"reminderType\" FROM appointments a JOIN patients p ON a.\"patientId\" = p.id JOIN organizations o ON a.\"organizationId\" = o.id WHERE a.\"dateTime\" BETWEEN NOW() + INTERVAL '23 hours' AND NOW() + INTERVAL '25 hours' AND a.status = 'CONFIRMADA' AND (a.\"reminder24Sent\" = false OR a.\"reminder24Sent\" IS NULL) LIMIT 100",
        "options": {}
      }
    },
    {
      "id": "if-24h",
      "name": "If: Has 24h Reminders",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        760,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-24h",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "split-24h",
      "name": "Split: Per Reminder 24h",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1020,
        200
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "brevo-24h",
      "name": "Brevo: Send 24h Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        200
      ],
      "credentials": {
        "sendInBlueApi": {
          "id": "mI0Vd3e0dhXDryiR",
          "name": "Brevo account"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendInBlueApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sender\": { \"email\": \"{{ $env.BREVO_SENDER_EMAIL }}\", \"name\": \"{{ $env.BREVO_SENDER_NAME }}\" },\n  \"to\": [{ \"email\": \"{{ $json.patientEmail }}\" }],\n  \"subject\": \"Recordatorio: Tu cita en {{ $json.clinicName }} es manana\",\n  \"textContent\": \"Hola {{ $json.patientName }},\\n\\nTienes una cita manana {{ $json.dateTime }} en {{ $json.clinicName }}.\\n\\nSaludos,\\nEl equipo de {{ $json.clinicName }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "mark-24h",
      "name": "Supabase: Mark reminder24Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1540,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "kXsaPlwveqzzNOmY",
          "name": "Supabase account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE appointments SET \"reminder24Sent\" = true WHERE id = '{{ $json.id }}'",
        "options": {}
      }
    },
    {
