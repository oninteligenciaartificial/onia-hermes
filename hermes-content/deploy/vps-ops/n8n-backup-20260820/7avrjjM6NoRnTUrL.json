      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst lines = items.map((i) => '- ' + (i.json.patientName || '?') + ' / ' + (i.json.clinicName || '?') + ' / Dr. ' + (i.json.doctorName || '?')).join('\\n');\nreturn [{ json: { summary: 'DRY-RUN DentalGest WF-11 (follow-up post-cita): ' + items.length + ' paciente(s) que el sistema contactaria. NO se envio nada.\\n\\n' + lines + '\\n\\nSi las listas estan bien, avisa para activar envio real.' } }];"
      }
    },
