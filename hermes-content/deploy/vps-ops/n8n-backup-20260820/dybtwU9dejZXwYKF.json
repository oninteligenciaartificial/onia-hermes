      "position": [
        0,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst plus3 = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000);\nreturn [{ json: { nowISO: now.toISOString(), plus3ISO: plus3.toISOString() } }];"
      },
      "id": "7fb66af4-c7d4-441a-913d-802019430b38",
      "name": "Calc Dates",
      "type": "n8n-nodes-base.code",
