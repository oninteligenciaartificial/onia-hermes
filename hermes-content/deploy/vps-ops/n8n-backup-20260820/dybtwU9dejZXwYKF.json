  "name": "WF-GS-01 — Trial Expiry Warning- Gesti-os",
  "description": "Daily 9AM LPZ: finds orgs with trial ending in 3 days, emails admin via Resend, optionally sends WhatsApp via Meta Graph API if addon active.",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
