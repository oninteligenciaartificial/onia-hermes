      "position": [
        224,
        272
      ]
    },
    {
      "parameters": {
        "url": "='https://jafxylfocvvlflpqfsix.supabase.co/rest/v1/organizations?trialEndsAt=gte.' + $('Calc Dates').first().json.nowISO + '&trialEndsAt=lte.' + $('Calc Dates').first().json.plus3ISO + '&select=id,name,plan,trialEndsAt,whatsappAddon'",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "=$vars.SUPABASE_SERVICE_ROLE"
            }
          ]
        },
        "options": {}
      },
