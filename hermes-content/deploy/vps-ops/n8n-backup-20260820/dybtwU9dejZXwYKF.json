        1568,
        192
      ]
    },
    {
      "parameters": {
        "url": "='https://jafxylfocvvlflpqfsix.supabase.co/rest/v1/org_addons?organizationId=eq.' + $('For Each Org').first().json.id + '&addon=eq.WHATSAPP&active=eq.true&select=accessToken,phoneNumberId&limit=1'",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendHeaders": true,
