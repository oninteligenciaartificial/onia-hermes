      "position": [
        896,
        192
      ]
    },
    {
      "parameters": {
        "url": "='https://jafxylfocvvlflpqfsix.supabase.co/auth/v1/admin/users/' + $json[0].userId",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "=$vars.SUPABASE_SERVICE_ROLE"
