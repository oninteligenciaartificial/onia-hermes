    },
    {
      "parameters": {
        "url": "='https://jafxylfocvvlflpqfsix.supabase.co/rest/v1/profiles?organizationId=eq.' + $json.id + '&role=eq.ADMIN&select=userId&limit=1'",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
