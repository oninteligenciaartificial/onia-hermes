      "typeVersion": 4.4,
      "position": [
        1792,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "='https://graph.facebook.com/v20.0/' + $('Fetch WA Addon').first().json.phoneNumberId + '/messages'",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "='Bearer ' + $('Fetch WA Addon').first().json.accessToken"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=JSON.stringify({ messaging_product: 'whatsapp', to: $('Fetch Auth User').first().json.phone || '', type: 'text', text: { body: 'Hola! Tu trial de GestiOS vence pronto. Activa tu plan en: https://' + $vars.GESTIOS_APP_URL + '/settings/billing' } })",
        "options": {}
      },
