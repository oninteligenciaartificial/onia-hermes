    {
      "id": "0f6d23eb-676c-4c5f-947f-805e356d1d0d",
      "name": "Preparar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const NL=String.fromCharCode(10); const raw=($input.first().json.stdout||'').trim(); let s; try{ s=JSON.parse(raw.split(NL).pop()); }catch(e){ s={ok:false,fatal:'parse'}; } const prospects=Array.isArray(s.prospects)?s.prospects:[]; const notify=(!s.ok)||(s.inserted||0)>0; let text; if(!s.ok){ text='Prospector ONIA - ERROR: '+(s.fatal||'desconocido'); } else { const lines=['Prospector ONIA: '+(s.inserted||0)+' prospecto(s) nuevos en el CRM ('+(s.category||'')+' / '+String(s.city||'').replace(/_/g,' ')+'), de '+(s.found||0)+' encontrados.']; for(const p of prospects.slice(0,10)){ lines.push(''); lines.push('- '+p.company+' ['+(p.priority||'media')+']'+(p.has_web?'':' (sin web)')); if(p.suggested_service){ lines.push('  Servicio: '+String(p.suggested_service).split('_').join(' ')); } if(p.contact){ lines.push('  Contacto: '+p.contact); } lines.push('  '+String(p.why||'').slice(0,180)); } lines.push(''); lines.push('Revisa y aproba en ONIA Center. Nada se contacto.'); text=lines.join(NL).split('_').join(' ').slice(0,3900); } return [{ json:{ notify:notify, text:text } }];"
      }
    },
