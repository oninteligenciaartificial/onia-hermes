      "name": "Elegir rubro y ciudad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const combos=[{city:'santa_cruz',category:'dental'},{city:'santa_cruz',category:'estetica'},{city:'santa_cruz',category:'gastronomia'},{city:'la_paz',category:'dental'},{city:'cochabamba',category:'dental'},{city:'santa_cruz',category:'veterinaria'},{city:'la_paz',category:'estetica'},{city:'santa_cruz',category:'comercio'}]; const day=Math.floor(Date.now()/86400000); const c=combos[day%combos.length]; return [{ json: { city: c.city, category: c.category, limit: 8 } }];"
      }
    },
    {
      "id": "560d026e-9243-473d-9cd7-370874a28a85",
