    {
      "id": "16be64fa-bdf1-4d16-93db-359c05838762",
      "name": "Parsear comentario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $('Webhook Comentario IG').first().json.body || {};\nconst e0 = (b.entry || [])[0] || {};\nconst c0 = (e0.changes || [])[0] || {};\nconst v = c0.value || {};\nconst texto = String(v.text || '').toUpperCase();\nconst fromId = String((v.from || {}).id || '');\nconst MIOS = ['17841423363059652', '27942557688720145'];\n\n// La palabra decide QUE se manda. Fuente: hermes-content/contenido/README.md seccion 5.\nconst RECURSOS = {\n  SISTEMA: 'Hola! Vi tu comentario. Te dejo el link para agendar el diagnostico de 20 minutos: miramos tu operacion y te decimos que conviene automatizar primero, y que no vale la pena todavia.\\n\\nhttps://onia.com.bo/?src=onia-ig-sistema\\n\\nSi preferis, contame en una linea a que se dedica tu negocio y te adelanto algo por aca.',\n  LISTA: 'Hola! Ahi va la lista: las 6 tareas por donde conviene empezar a automatizar, en orden, y lo que cuesta resolver cada una.\\n\\nhttps://onia.com.bo/recursos/lista-por-donde-empezar.pdf\\n\\nLa regla que decide el orden esta arriba de todo: no se automatiza lo que mas te molesta, se automatiza lo que hacés mas veces y siempre igual. Si queres que la miremos sobre tu negocio, contame a que te dedicas.'\n};\n\nlet palabra = null;\nif (texto.includes('SISTEMA')) palabra = 'SISTEMA';\nelse if (texto.includes('LISTA')) palabra = 'LISTA';\n\nconst propio = MIOS.includes(fromId);\nconst esComentario = c0.field === 'comments';\nconst idValido = /^[0-9]+$/.test(fromId);\nconst accionable = Boolean(palabra) && !propio && esComentario && Boolean(v.id) && idValido;\n\nlet motivo = 'ok';\nif (!esComentario) motivo = 'no_es_comentario';\nelse if (propio) motivo = 'comentario_propio';\nelse if (!palabra) motivo = 'sin_palabra_clave';\nelse if (!idValido) motivo = 'from_id_invalido';\n\nreturn [{ json: {\n  comment_id: v.id || '',\n  texto: v.text || '',\n  from_id: fromId,\n  username: (v.from || {}).username || '',\n  media_id: (v.media || {}).id || '',\n  entry_id: String(e0.id || ''),\n  palabra: palabra,\n  mensaje: palabra ? RECURSOS[palabra] : '',\n  propio: propio,\n  accionable: accionable,\n  motivo: motivo\n} }];"
      }
    },
