      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        336,
        64
      ],
      "parameters": {
        "content": "## WF-DISCORD-04 — Alertas de Tareas Pendientes en Notion\n\n**Trigger:** Diario a las 9:00am Bolivia (UTC-4) = 13:00 UTC\n\n**Flujo:**\n1. Cron dispara cada día a las 13:00 UTC\n2. Notion busca páginas con texto \"pendiente\"\n3. Se formatea la lista de tareas en un mensaje\n4. El mensaje se envía al canal Discord configurado\n\n**Credenciales necesarias:**\n- Notion API Key\n- Discord Bot OnIA (botToken)",
        "color": 3,
        "width": 1200,
        "height": 200
      }
    },
    {
      "id": "b8f275f6-727f-478b-a3cc-e521507b0c35",
      "name": "Cron 9am Bolivia (13:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 13,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "a1a3f3ed-589c-4d5e-9c9a-d566b7403529",
      "name": "Buscar Tareas Pendientes en Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "page",
        "operation": "search",
        "authentication": "apiKey",
        "text": "pendiente",
        "returnAll": true,
        "simple": false,
        "options": {
          "filter": {
            "filters": {
              "property": "object",
              "value": "page"
            }
          },
          "sort": {
            "sortValue": {
              "direction": "descending",
              "timestamp": "last_edited_time"
            }
          }
        }
      }
    },
    {
      "id": "2afdea56-f7d1-463e-ba0e-b630dedf19da",
      "name": "Formatear Lista de Tareas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst items = $input.all();\nconst today = new Date().toLocaleDateString('es-BO', { \n  timeZone: 'America/La_Paz',\n  weekday: 'long', \n  year: 'numeric', \n  month: 'long', \n  day: 'numeric' \n});\n\nlet message = `📋 **Alertas de Tareas Pendientes** — ${today}\n\n`;\n\nif (items.length === 0) {\n  message += '✅ No hay tareas pendientes en Notion. ¡Todo al día!';\n} else {\n  message += `Se encontraron **${items.length}** tarea(s) pendiente(s):\n\n`;\n  items.forEach((item, index) => {\n    const name = item.json.name || item.json.title || '(Sin título)';\n    const url = item.json.url || '';\n    message += `${index + 1}. **${name}**`;\n    if (url) message += ` → ${url}`;\n    message += '\n';\n  });\n  message += '\n> Revisa y actualiza tus tareas en Notion.';\n}\n\nreturn [{ json: { message, taskCount: items.length } }];\n"
      },
      "executeOnce": true
    },
    {
      "id": "2051acf3-be2b-42af-bd0f-0858fc46fa67",
