    {
      "id": "be86397a-cb35-4a59-a2f5-bd639ffa3791",
      "name": "Fetch Active Subscriptions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://jafxylfocvvlflpqfsix.supabase.co/rest/v1/personal_subscriptions",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "activa",
              "value": "eq.true"
            },
            {
              "name": "select",
              "value": "nombre,monto,moneda,notas,dia_cobro"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "<__PLACEHOLDER_VALUE__Supabase anon key__>"
            },
            {
              "name": "Authorization",
              "value": "<__PLACEHOLDER_VALUE__Bearer <supabase-anon-key>__>"
            }
          ]
        }
      }
    },
    {
      "id": "d419d45d-0eb0-4028-a8e9-1b5971cb1871",
      "name": "Filter Due in 3 Days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const today = new Date();\nconst targetDate = new Date(today);\ntargetDate.setDate(today.getDate() + 3);\nconst targetDay = targetDate.getDate();\n\nconst allItems = $input.all();\n\nconst dueSubscriptions = allItems\n  .map(item => item.json)\n  .filter(sub => sub.dia_cobro === targetDay);\n\nif (dueSubscriptions.length === 0) {\n  return [{ json: { hasSubscriptions: false, message: '', count: 0 } }];\n}\n\nconst byCurrency = {};\nconst lines = dueSubscriptions.map(sub => {\n  const currency = sub.moneda || 'USD';\n  const amount = parseFloat(sub.monto) || 0;\n  if (!byCurrency[currency]) byCurrency[currency] = 0;\n  byCurrency[currency] += amount;\n  const notasPart = sub.notas ? ' — ' + sub.notas : '';\n  return '• ' + sub.nombre + ' — ' + amount + ' ' + currency + notasPart;\n});\n\nconst totalsLines = Object.entries(byCurrency)\n  .map(([cur, total]) => '**Total: ' + total + ' ' + cur + '**')\n  .join('\\n');\n\nconst message = '\\uD83D\\uDCB3 **Cobro pr\\u00F3ximo en 3 d\\u00EDas**\\n\\n' + lines.join('\\n') + '\\n\\n' + totalsLines;\n\nreturn [{ json: { hasSubscriptions: true, message, count: dueSubscriptions.length } }];"
      }
    },
