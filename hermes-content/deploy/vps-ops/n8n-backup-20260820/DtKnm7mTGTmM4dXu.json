  "name": "WF-13: WhatsApp Quota Alert",
  "description": "Daily cron checks WhatsApp usage per clinic. Alerts clinic admin at 80% and superadmin at 100% via Gmail Workspace. Limit 200 msgs/month per org (migrado 2026-08-07, sin $env).",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "ec7ac7cc-4db3-43b8-bd73-ab4286e7e2b1",
      "name": "Daily 10am La Paz",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        272
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        },
        "timezone": "America/La_Paz"
      }
    },
    {
      "id": "a889b50e-22b0-4c09-abc4-598a7db2c617",
      "name": "Query WA Usage",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        272
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  o.id AS \"organizationId\",\n  o.name AS \"clinicName\",\n  o.\"whatsappAddon\",\n  p.email AS \"adminEmail\",\n  p.name AS \"adminName\",\n  COUNT(CASE WHEN a.\"whatsapp24hSentAt\" >= date_trunc('month', NOW()) THEN 1 END) +\n  COUNT(CASE WHEN a.\"whatsapp2hSentAt\" >= date_trunc('month', NOW()) THEN 1 END) AS \"msgsSentThisMonth\"\nFROM organizations o\nJOIN profiles p ON p.\"organizationId\" = o.id AND p.role = 'ADMIN'\nLEFT JOIN appointments a ON a.\"organizationId\" = o.id\nWHERE o.\"whatsappAddon\" = true\nGROUP BY o.id, o.name, o.\"whatsappAddon\", p.email, p.name\nHAVING (\n  COUNT(CASE WHEN a.\"whatsapp24hSentAt\" >= date_trunc('month', NOW()) THEN 1 END) +\n  COUNT(CASE WHEN a.\"whatsapp2hSentAt\" >= date_trunc('month', NOW()) THEN 1 END)\n) >= 160\nORDER BY \"msgsSentThisMonth\" DESC"
      },
      "credentials": {
        "postgres": {
          "id": "2P4w95n0vir90EkT",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "7cdc71f8-42fa-4c3c-9ea2-79868e716261",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {}
    },
    {
      "id": "6b1db038-701c-4874-891f-9f5a16a03cd1",
      "name": "Compute Flags",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "fields": {
          "values": [
            {
              "name": "pct",
              "type": "numberValue",
              "numberValue": "={{ Math.round($json.msgsSentThisMonth / 200 * 100) }}"
            },
            {
              "name": "is100pct",
              "type": "booleanValue",
              "booleanValue": "={{ $json.msgsSentThisMonth >= 200 }}"
            },
            {
              "name": "is80pct",
              "type": "booleanValue",
              "booleanValue": "={{ $json.msgsSentThisMonth >= 160 && $json.msgsSentThisMonth < 200 }}"
            }
          ]
        }
      }
    },
    {
      "id": "554e2563-2cdb-4fa2-931f-47f81b422b33",
      "name": "Is 100%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.is100pct }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "0a949810-b4bb-4a71-939d-30044cb7ef30",
