    {
      "id": "wh-chatwoot-1",
      "name": "Webhook Chatwoot",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "onia-chatbot-demo",
        "responseMode": "onReceived"
      },
      "webhookId": "a416f3d6-3e68-4d5e-8638-757ad9770dd6"
    },
    {
      "id": "code-normalizar-1",
      "name": "Normalizar webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Un solo lugar arma el contrato de entrada de chatwoot-adapter.mjs: el webhook crudo\n// de Chatwoot, en base64 (el nodo SSH no tiene stdin).\nconst raw = $json.body || $json;\nreturn [{ json: { b64: Buffer.from(JSON.stringify(raw)).toString('base64') } }];\n"
      }
    },
    {
      "id": "ssh-correr-1",
      "name": "Correr adaptador (VPS)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "authentication": "privateKey",
        "cwd": "/root",
        "command": "=CHATWOOT_WEBHOOK_B64='{{ $json.b64 }}' bash /opt/onia/bot/chatwoot-adapter.sh < /dev/null"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "4XKauEX3b6cqaDhW",
          "name": "ONIA VPS SSH"
        }
      }
    },
    {
      "id": "code-leer-1",
      "name": "Leer resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Parsea el stdout de chatwoot-adapter.mjs (que ya posteo la respuesta a Chatwoot el solo,\n// esto es solo para ver el resultado en la ejecucion de n8n: ok / skipped / duplicate / sent / warnings).\nconst raw = ($input.first().json.stdout || '').trim();\nlet r;\ntry { r = JSON.parse(raw.split('\n').pop()); }\ncatch (e) { r = { ok: false, skipped: false, duplicate: false, sent: [], error: 'stdout ilegible: ' + raw.slice(0, 300) }; }\nreturn [{ json: r }];\n"
      }
    }
  ],
