              "value": "[{\"role\":\"system\",\"content\":\"Eres un experto en inteligencia artificial. Resume las noticias de forma clara y profesional.\"},{\"role\":\"user\",\"content\":\"Busca y resume las principales novedades sobre inteligencia artificial del día anterior ({{$today.minus(1, 'days').format('YYYY-MM-DD')}}). Incluye: 1) Títulos de las noticias más importantes, 2) Breve descripción de cada una, 3) Enlaces a las fuentes. Organiza todo de forma clara y profesional.\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request-1",
      "name": "Perplexity AI Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.choices?.[0]?.message?.content || 'No se encontraron resultados';\n\nconst today = new Date();\nconst yesterday = new Date(today);\nyesterday.setDate(yesterday.getDate() - 1);\nconst formattedDate = yesterday.toLocaleDateString('es-ES', {\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\nreturn [{\n  json: {\n    taskName: `🤖 Novedades IA - ${formattedDate}`,\n    description: content,\n    date: formattedDate\n  }\n}];"
      },
