  "name": "ONIA - Generar Propuesta (oficial)",
  "description": "Webhook POST /generar-propuesta {slug,secret}. Valida secret (ONIA_CENTER_INTERNAL_API_KEY) y slug kebab-case, corre el generador oficial + PDF (chromium VPS) por SSH, y envia el PDF a Sergio por Telegram para revisar antes de enviar al cliente. Autonomo ",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "a7dbeb05-5d79-45a0-9e45-f5a0c2309d2e",
      "name": "Webhook Propuesta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        192
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "generar-propuesta",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "09e70fa0-65f9-4800-b4b5-7e26a1145a06"
    },
    {
      "id": "a673a66a-f641-41cf-b32c-ccff7dae1a95",
      "name": "Autorizado y slug valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        224,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-auth",
              "leftValue": "={{ $json.stdout }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              },
              "rightValue": "\"authorized\":true"
            },
            {
              "id": "cond-slug",
              "leftValue": "={{ $('Webhook Propuesta').item.json.body.slug }}",
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "rightValue": "^[a-z0-9-]{1,60}$"
            }
          ]
        }
      }
    },
    {
      "id": "a544fcfb-bb28-4053-8b50-5d76c4418f89",
      "name": "Generar propuesta + PDF (VPS)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        448,
        96
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "authentication": "privateKey",
        "command": "=bash /opt/onia/generar-propuesta-pdf.sh \"{{ $('Webhook Propuesta').item.json.body.slug }}\"",
        "cwd": "/root"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "4XKauEX3b6cqaDhW",
          "name": "ONIA VPS SSH"
        }
      }
    },
    {
      "id": "66c53340-c023-4ad2-b705-bfc2744072a6",
      "name": "Preparar PDF binario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = ($input.first().json.stdout || '').trim();\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch (e) { parsed = { ok: false, stage: 'parse' }; }\nif (!parsed || !parsed.ok) {\n  return [{ json: { ok: false, slug: (parsed && parsed.slug) || '', stage: (parsed && parsed.stage) || 'unknown' } }];\n}\nconst slug = parsed.slug;\nreturn [{ json: { ok: true, slug: slug }, binary: { data: { data: parsed.pdf_b64, fileName: 'propuesta-' + slug + '.pdf', mimeType: 'application/pdf', fileExtension: 'pdf' } } }];"
      }
    },
    {
      "id": "df7add9d-3991-4e30-9425-10c4fc1c9c8a",
      "name": "PDF generado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
