          "fileName": "=propuesta-{{ $json.slug }}.pdf"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "r8y2CN5RyOEIDce3",
          "name": "Telegram account"
        }
      },
      "webhookId": "6b45ee8f-979c-4e97-a345-b9f61398c34b"
    },
