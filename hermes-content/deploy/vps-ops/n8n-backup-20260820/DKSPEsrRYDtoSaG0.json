    {
      "id": "38f24d0a-220d-4771-bec1-ee1669610b9e",
      "name": "Code: Compare & Find Mismatches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "jsCode": "const payments = $('Supabase: Last 24h Payments').all();\nconst orphanPaid = $('Supabase: Paid Without Payment Record').all();\nconst orphanPayments = $('Supabase: Payment Without Matching Invoice').all();\n\nconst issues = [];\n\nif (orphanPaid.length > 0) {\n  for (const row of orphanPaid) {\n    issues.push({\n      type: 'PAID_WITHOUT_PAYMENT_RECORD',\n      severity: 'HIGH',\n      invoiceId: row.json.id,\n      clinicName: row.json.clinicName,\n      patientName: row.json.patientName,\n      amount: row.json.total,\n      detail: 'Factura marcada como PAGADA pero sin registro en payments table'\n    });\n  }\n}\n\nif (orphanPayments.length > 0) {\n  for (const row of orphanPayments) {\n    issues.push({\n      type: 'PAYMENT_WITHOUT_INVOICE',\n      severity: 'CRITICAL',\n      paymentId: row.json.id,\n      clinicName: row.json.clinicName || 'N/A',\n      amount: row.json.amount,\n      detail: 'Pago existe pero la factura no existe o esta en BORRADOR'\n    });\n  }\n}\n\nconst totalPaid = payments.reduce((s, p) => s + Number(p.json.amount || 0), 0);\n\nreturn {\n  json: {\n    totalPayments: payments.length,\n    totalAmount: totalPaid.toLocaleString('es-BO'),\n    issueCount: issues.length,\n    issues: JSON.stringify(issues, null, 2)\n  }\n};"
      }
    },
    {
      "id": "ebfd219a-737d-44b4-99a2-bf678904d257",
      "name": "If: Has Issues?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
