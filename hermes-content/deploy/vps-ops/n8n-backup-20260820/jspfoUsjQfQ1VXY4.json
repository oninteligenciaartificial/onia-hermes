  "name": "ONIA - Prospeccion diaria",
  "description": "Lun-Vie 09:00: manda a Sergio por Telegram el prospecto del dia (rota rubro+ciudad) con el prompt de prospeccion ONIA y la regla de no contactar sin aprobar. v1 nudge; upgrade a auto-busqueda cuando haya fuente (Google Places/Tavily).",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "72115db8-8371-4a81-b8d4-22cb111d97e3",
      "name": "Lun-Vie 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "896d003c-bf62-4cd8-af45-1e3ee6e87539",
      "name": "Armar prospeccion del dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rubros = ['clinicas dentales','esteticas y dermatologia','restaurantes y cafes','inmobiliarias','gimnasios','ecommerce y tiendas locales','servicios locales (plomeria/limpieza/electricidad)','constructoras y arquitectura'];\nconst ciudades = ['Santa Cruz','La Paz','Cochabamba'];\nconst now = new Date();\nconst dayIdx = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 86400000);\nconst rubro = rubros[dayIdx % rubros.length];\nconst ciudad = ciudades[dayIdx % ciudades.length];\nconst message = [\n  'Prospeccion de hoy',\n  'Busca 5 ' + rubro + ' en ' + ciudad + ' con senal de oportunidad (web mejorable, sin CRM, redes sin sistema, mucho manual).',\n  'Fuentes publicas verificables (Google Maps, web, redes). Nada inventado.',\n  'Carga los 5 buenos al CRM (Notion) como por-revisar.',\n  'Regla: NO contactar sin aprobar antes el mensaje y canal con Sergio.',\n].join('\\n');\nreturn [{ json: { rubro, ciudad, message } }];"
      }
    },
    {
      "id": "0c7cf432-cbaf-4759-8406-231cfe27d28f",
      "name": "Enviar a Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        840,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: $env.TELEGRAM_SERGIO_CHAT_ID, text: $json.message, disable_web_page_preview: true } }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
