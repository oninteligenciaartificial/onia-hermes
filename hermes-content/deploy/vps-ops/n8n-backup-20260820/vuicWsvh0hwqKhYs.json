    {
      "id": "ae1710c4-64ef-464f-b50f-bd6fcc9a74c6",
      "name": "Voz a base64 CC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const bin = $input.item.binary && $input.item.binary.data;\nconst audioB64 = bin && bin.data ? bin.data : \"\";\nconst m = $('Unwrap Update').item.json.message;\nconst chatId = String((m && m.chat && m.chat.id) || \"\");\nreturn { json: { audioB64, chatId } };"
      }
    },
