    {
      "id": "59e59bc6-e088-4183-9c0b-234c830fa02c",
      "name": "Es /agendar? CC",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.command }}",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              },
              "rightValue": "/agendar"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "113d54b8-0368-46b3-a45c-c55a19d1f9cb",
      "name": "Parsear Agenda CC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const msg = $input.first().json.command;\nconst chatId = String($input.first().json.chatId);\nconst partes = msg.replace(/^\\/agendar\\s*/i, '').split('|').map(p => p.trim());\nconst titulo = partes[0] || 'Sin título';\nconst fechaHora = partes[1] || '';\nconst descripcion = partes[2] || '';\n\nfunction parseFecha(texto) {\n  const dias = { lunes: 1, martes: 2, miercoles: 3, miércoles: 3, jueves: 4, viernes: 5, sabado: 6, sábado: 6, domingo: 0 };\n  const lower = texto.toLowerCase();\n  const fecha = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/La_Paz' }));\n  if (lower.includes('mañana') || lower.includes('manana')) {\n    fecha.setDate(fecha.getDate() + 1);\n  } else {\n    for (const [nombre, num] of Object.entries(dias)) {\n      if (lower.includes(nombre)) {\n        const hoy = fecha.getDay();\n        let diff = num - hoy;\n        if (diff <= 0) diff += 7;\n        fecha.setDate(fecha.getDate() + diff);\n        break;\n      }\n    }\n    const matchSlash = texto.match(/(\\d{1,2})\\/(\\d{1,2})/);\n    if (matchSlash) { fecha.setMonth(parseInt(matchSlash[2]) - 1); fecha.setDate(parseInt(matchSlash[1])); }\n  }\n  return fecha;\n}\n\nfunction parseHora(texto) {\n  const match = texto.match(/(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm)?/i);\n  if (!match) return { h: 9, m: 0 };\n  let h = parseInt(match[1]);\n  const m = parseInt(match[2] || '0');\n  const ampm = (match[3] || '').toLowerCase();\n  if (ampm === 'pm' && h < 12) h += 12;\n  if (ampm === 'am' && h === 12) h = 0;\n  return { h, m };\n}\n\nconst fecha = parseFecha(fechaHora);\nconst rangoMatch = fechaHora.match(/([\\d:apm]+)\\s*-\\s*([\\d:apm]+)/i);\nlet startH = { h: 9, m: 0 }, endH = { h: 10, m: 0 };\nif (rangoMatch) { startH = parseHora(rangoMatch[1]); endH = parseHora(rangoMatch[2]); }\n\nconst startDate = new Date(fecha);\nstartDate.setHours(startH.h, startH.m, 0, 0);\nconst endDate = new Date(fecha);\nendDate.setHours(endH.h, endH.m, 0, 0);\n\nconst resumen = titulo + ' — ' + startDate.toLocaleString('es-BO', { timeZone: 'America/La_Paz', weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });\nreturn [{ json: { titulo, descripcion, startISO: startDate.toISOString(), endISO: endDate.toISOString(), chatId, resumen } }];"
      }
    },
