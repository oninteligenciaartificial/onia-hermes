    {
      "id": "bb5949db-b424-4779-9076-02170552f2fa",
      "name": "Comando desde voz CC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "let text = \"\";\ntry {\n  const out = JSON.parse(String($json.stdout || \"\").trim());\n  if (out && out.ok && out.text) text = String(out.text).trim();\n} catch (e) { text = \"\"; }\nconst chatId = String($('Voz a base64 CC').item.json.chatId || \"\");\nif (!text) text = \"No entendi la nota de voz, la repetis?\";\nreturn { json: { message: { text: text, chat: { id: chatId } } } };"
      }
