  "name": "GestiOS — Birthday WA [WF-GS-03]",
  "description": "Daily 1PM: fetches customers with birthdays today, sends WA greeting using each org's own WhatsApp Business credentials.",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "63e74b05-5eb1-42a8-ad2f-e22a9b0c1ed2",
      "name": "Daily 1PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        80
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 13 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c61b5f95-0b4b-4289-8533-2d0687c88938",
      "name": "Fetch Customers With Birthday",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://jafxylfocvvlflpqfsix.supabase.co/rest/v1/customers?select=id,name,phone,birthday,organizationId&birthday=not.is.null&phone=not.is.null&limit=1000",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer __REDACTED_JWT__"
            },
            {
              "name": "apikey",
              "value": "__REDACTED_JWT__"
            }
          ]
        }
      },
      "executeOnce": true
    },
    {
      "id": "ff540581-d089-4b5f-9e1a-b7c37c9f0e6f",
      "name": "Filter Birthdays Today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const today = new Date();\nconst month = today.getMonth() + 1;\nconst day = today.getDate();\nconst customers = $input.all().map(i => i.json);\nconst todayBirthdays = customers.filter(c => {\n  if (!c.birthday) return false;\n  const d = new Date(c.birthday);\n  return d.getMonth() + 1 === month && d.getDate() === day;\n});\nreturn todayBirthdays.map(c => ({ json: c }));"
      },
      "executeOnce": true
    },
    {
      "id": "3d09e151-e835-4bbf-a86b-6f92ed221399",
      "name": "Fetch WA Addon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://jafxylfocvvlflpqfsix.supabase.co/rest/v1/org_addons?select=phoneNumberId,accessToken&organizationId=eq.{{ $json.organizationId }}&addon=eq.WHATSAPP&active=eq.true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer __REDACTED_JWT__"
            },
            {
              "name": "apikey",
              "value": "__REDACTED_JWT__"
            }
          ]
        }
      }
    },
    {
      "id": "9a43b161-2da8-4742-af9b-04b56e016188",
      "name": "Send Birthday WA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1120,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $(\"Fetch WA Addon\").item.json.phoneNumberId }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $(\"Fetch WA Addon\").item.json.accessToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"messaging_product\": \"whatsapp\", \"to\": \"{{ $(\\\"Split In Batches\\\").item.json.phone }}\", \"type\": \"text\", \"text\": { \"body\": \"🎂 ¡Feliz cumpleaños {{ $(\\\"Split In Batches\\\").item.json.name }}! Que tengas un día increíble. ¡Gracias por ser nuestro cliente!\" } }"
      }
    },
    {
      "id": "074ec8cf-7d25-474e-ab92-eabe76c73838",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        672,
        80
      ],
      "parameters": {
        "batchSize": 10
      }
    }
  ],
