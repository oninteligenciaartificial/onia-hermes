    {
      "parameters": {
        "jsCode": "const pr = $input.first().json;\nconst expiry = new Date();\nexpiry.setMonth(expiry.getMonth() + (pr.months || 1));\nreturn [{ json: { organizationId: pr.organizationId, plan: pr.plan, planExpiresAt: expiry.toISOString(), months: pr.months } }];"
      },
