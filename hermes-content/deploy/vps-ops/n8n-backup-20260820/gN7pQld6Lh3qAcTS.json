      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = items[0]?.json || {};\nconst stdout = String(raw.stdout || '').trim();\nlet b = null;\ntry { const s = stdout.indexOf('{'); b = s >= 0 ? JSON.parse(stdout.slice(s)) : null; } catch (e) { b = null; }\nconst exitCode = typeof raw.code === 'number' ? raw.code : (typeof raw.exitCode === 'number' ? raw.exitCode : 1);\nconst ok = !!b && b.ok === true && exitCode === 0;\nconst mb = (n) => (Number(n) / 1048576).toFixed(2) + 'MB';\nlet message;\nif (ok) {\n  message = 'ONIA Backup: OK (' + b.ts + ')\\nSupabase=' + mb(b.supabaseBytes) + ' n8n=' + mb(b.n8nBytes) + '\\n' + b.files + ' archivos, ' + b.totalSize + ' en /opt/onia/backups (rotacion 7 dias)';\n} else {\n  message = 'ONIA Backup: FALLO\\nerrors=' + ((b && b.errors) || ('exitCode=' + exitCode)) + '\\n' + String(raw.stderr || stdout).slice(-400);\n}\nreturn [{ json: { ok, message } }];"
      }
    },
