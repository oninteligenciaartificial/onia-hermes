      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst lines = items.map((i) => '- ' + (i.json.patientName || '?') + ' / ' + (i.json.clinicName || '?') + ' / Bs. ' + (i.json.total || '?') + ' / vence ' + (i.json.dueDate || '?')).join('\\n');\nreturn [{ json: { summary: 'DRY-RUN DentalGest WF-03 (facturas recurrentes): ' + items.length + ' factura(s) que el sistema enviaria. NO se envio nada.\\n\\n' + lines + '\\n\\nSi las listas estan bien, avisa para activar envio real.' } }];"
      }
    },
    {
      "id": "debedf37-d358-4836-870e-ca55f1dbdd9a",
      "name": "DRY RUN Aviso Facturas",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        896,
        480
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "6830070978",
        "text": "={{ $json.summary }}",
        "replyMarkup": "none",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "r8y2CN5RyOEIDce3",
          "name": "Telegram account"
        }
      },
      "webhookId": "493a6c4d-312d-4a32-8fed-cb2ead30d277"
    },
    {
      "id": "b1b2c737-694c-43bc-aec9-e1c197a02e30",
