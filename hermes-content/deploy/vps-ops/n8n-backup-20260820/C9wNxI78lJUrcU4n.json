      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        896,
        192
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.patientEmail }}",
        "subject": "=Factura de {{ $json.clinicName }} - Bs. {{ $json.total }}",
        "emailType": "html",
        "message": "=<p>Hola {{ $json.patientName }},</p><p>Tu factura de {{ $json.clinicName }} esta lista.</p><p>Total: Bs. {{ $json.total }}<br>Vencimiento: {{ $json.dueDate }}</p><p><a href='https://app.onia.com.bo/print/invoice/{{ $json.id }}'>Ver factura</a></p><p>- {{ $json.clinicName }} via Onia</p>",
        "options": {}
      },
      "credentials": {
