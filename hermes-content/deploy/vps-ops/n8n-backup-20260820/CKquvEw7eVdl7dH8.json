      "parameters": {
        "jsCode": "const content = $json.content || '';\nconst conversationId = $json.conversation_id || $json.id;\nconst accountId = $json.account_id || 1;\n\nconst clean = content.trim().toLowerCase();\nconst isEmpty = clean.length < 3 || /^(ok|dale|gracias|jaja)$/.test(clean);\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    account_id: accountId,\n    content: content,\n    is_empty: isEmpty\n  }\n}];"
      },
