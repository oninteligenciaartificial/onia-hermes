    {
      "id": "799654e5-450f-4b28-bbe2-28092041f309",
      "name": "Code: Calculate Days Overdue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        416
      ],
      "parameters": {
        "jsCode": "const dueDate = new Date($json.dueDate);\nconst now = new Date();\nconst daysOverdue = Math.floor((now - dueDate) / 86400000);\nconst currentLevel = $json.dunningLevel || 0;\nconst calculatedLevel = daysOverdue >= 1 && daysOverdue <= 3 ? 1\n  : daysOverdue >= 4 && daysOverdue <= 7 ? 2\n  : daysOverdue >= 8 && daysOverdue <= 15 ? 3\n  : daysOverdue > 15 ? 4 : 0;\nconst dunningLevel = Math.max(currentLevel, calculatedLevel);\nreturn { json: { ...$json, daysOverdue, dunningLevel } };"
      }
    },
