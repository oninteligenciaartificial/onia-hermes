  "isArchived": true,
  "nodes": [
    {
      "id": "38d18c02-2198-49eb-b337-cb3236da9623",
      "name": "Recibir Texto Discord",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        288
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "discord-asistente",
        "responseMode": "onReceived"
      },
      "webhookId": "941080a9-088c-49dc-9464-1f6046bd0f0a"
    },
    {
      "id": "42685adb-7178-4245-b232-1c19228370a7",
      "name": "Clasificar con OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        288
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"model\": \"gpt-4o-mini\", \"messages\": [ { \"role\": \"system\", \"content\": \"Eres un asistente. Analiza el texto y devuelve JSON con: {tipo: 'evento'|'tarea'|'nota'|'desconocido', titulo: string, descripcion: string, inicio: ISO8601|null, fin: ISO8601|null}. La fecha de hoy es {{ $now.setZone('America/La_Paz').toISO() }}\" }, { \"role\": \"user\", \"content\": \"{{ $('Recibir Texto Discord').item.json.body.texto }}\" } ] }"
      }
    },
    {
      "id": "b4d76157-c0ad-42b3-8b6b-7fb61a1e89e0",
      "name": "Parsear Respuesta IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const rawContent = item.json.choices[0].message.content;\n  \n  let parsed;\n  try {\n    const jsonMatch = rawContent.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      parsed = JSON.parse(jsonMatch[0]);\n    } else {\n      parsed = { tipo: 'desconocido', titulo: 'Sin título', descripcion: rawContent, inicio: null, fin: null };\n    }\n  } catch (e) {\n    parsed = { tipo: 'desconocido', titulo: 'Sin título', descripcion: rawContent, inicio: null, fin: null };\n  }\n\n  result.push({\n    json: {\n      tipo: parsed.tipo || 'desconocido',\n      titulo: parsed.titulo || 'Sin título',\n      descripcion: parsed.descripcion || '',\n      inicio: parsed.inicio || null,\n      fin: parsed.fin || null,\n    }\n  });\n}\n\nreturn result;\n"
      }
    },
    {
