    {
      "id": "81c08992-f5b6-451a-8737-83212f898b84",
      "name": "buildDigest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const orgs = $('fetchOrgStats').all().map(i => i.json);\nconst newOrgs = $('fetchNewOrgs').all().map(i => i.json);\nconst orders = $('fetchRevenueStats').all().map(i => i.json);\nconst totalOrgs = orgs.length;\nconst newOrgsCount = newOrgs.length;\nconst totalRevenue = orders.reduce((sum, o) => sum + (parseFloat(o.total) || 0), 0);\nconst totalOrders = orders.length;\nconst planCount = {};\nfor (const org of orgs) { planCount[org.plan] = (planCount[org.plan] || 0) + 1; }\nconst planSummary = Object.entries(planCount).map(([p,c]) => `${p}: ${c}`).join(', ');\nconst newOrgsList = newOrgs.length > 0 ? newOrgs.map(o => `• ${o.name} (${o.plan})`).join('\\n') : '• Ninguno';\nconst emailHtml = `<h2>📊 Resumen Semanal GestiOS</h2><ul><li>Orgs activas: <strong>${totalOrgs}</strong></li><li>Nuevas esta semana: <strong>${newOrgsCount}</strong></li><li>Ventas entregadas: <strong>${totalOrders} pedidos — Bs ${totalRevenue.toFixed(2)}</strong></li><li>Planes: ${planSummary}</li></ul><h3>Nuevas orgs</h3><pre>${newOrgsList}</pre><p><a href=\"https://gesti-os.vercel.app\">Ver Dashboard</a></p>`;\nreturn [{ json: { emailHtml, totalOrgs, newOrgsCount, totalRevenue, totalOrders } }];"
      },
      "executeOnce": true
    },
    {
      "id": "a3e59936-4bcc-43d2-aa0d-3ca15ee04ef9",
      "name": "fetchNewOrgs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
