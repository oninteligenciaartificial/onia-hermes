    {
      "id": "be33e2ac-28a2-4e49-a62a-c08b6b7d372b",
      "name": "Build Digest Pipeline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        1400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fecha = new Date().toLocaleDateString('es-BO', { timeZone: 'America/La_Paz', day: '2-digit', month: 'long', year: 'numeric' });\nconst clientes = [\n  { emoji: '🎬', nombre: 'Epic Motion Group', detalle: 'web premium + portafolio AV (en desarrollo)' },\n  { emoji: '🏛️', nombre: 'DeMolay Bolivia', detalle: 'Sistema Nacional actas — piloto Grigotá 476' }\n];\nlet msg = '📊 <b>Pipeline ONIA — semana del ' + fecha + '</b>\\n\\n';\nmsg += 'Revisar estado de cada cliente y alinear prioridades. Responder por Alfredhq.\\n\\n';\nfor (const c of clientes) {\n  msg += c.emoji + ' <b>' + c.nombre + '</b>\\n   ' + c.detalle + '\\n   estado: ___  |  próximo paso: ___\\n\\n';\n}\nmsg += '➕ Nuevos leads / otros: ___\\n\\n🤝 Sergio + Arthur: definir foco de la semana.';\nconst destinatarios = ['6830070978', '8887222181'];\nreturn destinatarios.map(chatId => ({ json: { chatId, text: msg } }));"
      }
    },
