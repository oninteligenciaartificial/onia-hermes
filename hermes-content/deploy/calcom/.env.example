# ONIA Cal.com/Cal.diy environment example.
# Copy to .env on the VPS and replace placeholders there. Do not commit real values.

CALCOM_IMAGE=calcom/cal.com:v6.2.0
POSTGRES_DB=calcom
POSTGRES_USER=calcom
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

NEXTAUTH_URL=https://onia-calcom.hqdqgh.easypanel.host
NEXT_PUBLIC_WEBAPP_URL=https://onia-calcom.hqdqgh.easypanel.host
NEXT_PUBLIC_WEBSITE_URL=https://onia-calcom.hqdqgh.easypanel.host
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
CALENDSO_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_24
NEXT_PUBLIC_LICENSE_CONSENT=agree
CALCOM_TELEMETRY_DISABLED=1

EMAIL_FROM=agenda@onia.ai
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=REPLACE_WITH_SMTP_USER
EMAIL_SERVER_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD

# Configure this webhook manually inside Cal after setup.
CALCOM_N8N_WEBHOOK_URL=https://n8n-sergio-n8n.hqdqgh.easypanel.host/webhook/calcom-booking
