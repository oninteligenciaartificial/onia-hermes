 // ---------------------------------------------------------------------------
 // EL BUG QUE ESTOS CASOS CIERRAN
@@ -109,3 +109,48 @@ test("M_SIAT_BODY tiene {{humano}} a mitad de frase y sigue en minuscula", () =>
   });
   assert.ok(texto.includes("lo ve la encargada en la demo"), texto);
 });
+
+// ---------------------------------------------------------------------------
+// Un horario VIVO que no salio sorteado como A o B igual se puede ELEGIR
+// ---------------------------------------------------------------------------
+// Medido en produccion el 2026-09-24: el cron manda 5 horarios y `parseSlotsSpec` devolvia 2.
+// Los otros 3 seguian libres en la agenda de Sergio Urcullo, pero para el motor no existian:
+// quien escribia "el lunes 28 a las 14:00" no matcheaba ningun slot, caia en `proposesOwnTime`
+// y se iba a la cola humana — que ese dia tenia leads esperando hace 15-20 dias. Resultado:
+// 43 conversaciones, 18 llegaron a `esperando_horario` y CERO a `demo_agendada` (0 filas con
+// calendar_event_id en toda la historia de onia_center.bot_conversations).
+//
+// OFRECER sigue siendo de a dos (el guion pone {{slot_a}} y {{slot_b}} en la misma frase).
+// Lo que cambia es ACEPTAR: un horario que tenemos libre y que el prospecto nombra se agenda.
+test("los horarios vivos que no se ofrecen siguen siendo elegibles", () => {
+  const spec = [
+    "viernes 25 de septiembre, 21:00@2026-09-26T01:00:00Z",
+    "sábado 26 de septiembre, 09:00@2026-09-26T13:00:00Z",
+    "lunes 28 de septiembre, 14:00@2026-09-28T18:00:00Z",
+    "martes 29 de septiembre, 14:00@2026-09-29T18:00:00Z",
+  ].join("|");
+  const slots = parseSlotsSpec(spec, { now: Date.parse("2026-09-24T11:00:00Z") });
+
+  assert.equal(slots[0].key, "A", "el par ofrecido no se mueve: el guion lo nombra por letra");
+  assert.equal(slots[1].key, "B");
+  assert.equal(slots[0].label, "viernes 25 de septiembre, 21:00");
+
+  const extras = slots.slice(2);
+  assert.equal(extras.length, 2, "los horarios libres que no salieron A/B siguen en la lista");
+  assert.ok(extras.every((slot) => slot.key === null), "sin letra: 'A' nunca puede reasignarse a otro dia");
+  assert.ok(extras.every((slot) => !slot.pending), "estan vivos, no son placeholders");
+  assert.deepEqual(extras.map((slot) => slot.label), [
+    "lunes 28 de septiembre, 14:00",
+    "martes 29 de septiembre, 14:00",
+  ]);
+});
+
+test("un horario que ya caduco no se cuela como elegible", () => {
+  const spec = [
+    "viernes 25 de septiembre, 21:00@2026-09-26T01:00:00Z",
+    "sábado 26 de septiembre, 09:00@2026-09-26T13:00:00Z",
+    "jueves 24 de septiembre, 09:00@2026-09-24T13:00:00Z",
+  ].join("|");
+  const slots = parseSlotsSpec(spec, { now: Date.parse("2026-09-24T11:00:00Z") });
+  assert.equal(slots.length, 2, "el vencido no suma: solo el par ofrecido");
+});
