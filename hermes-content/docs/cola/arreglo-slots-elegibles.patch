   // invisible en produccion y visible solo cuando alguien lee el log para entender un fallo.
   elegidos.sort((uno, otro) => candidatos.indexOf(uno) - candidatos.indexOf(otro));
 
-  return elegidos.slice(0, 2).map((slot, index) => ({
+  const ofrecidos = elegidos.slice(0, 2).map((slot, index) => ({
     key: index === 0 ? "A" : "B",
     label: slot.label || `opción ${index === 0 ? "A" : "B"}`,
     startAt: slot.startAt,
     pending: slot.pending,
   }));
+
+  // OFRECER es de a dos; ACEPTAR no tiene por que serlo. Los candidatos que no salieron
+  // sorteados siguen LIBRES en la agenda: el guion no los nombra, pero si el prospecto los
+  // nombra el bot los agenda en vez de derivarlo a un humano.
+  //
+  // Medido en produccion el 2026-09-24: el cron manda 5 horarios, esta funcion devolvia 2, y
+  // "el lunes 28 a las 14:00" —un horario NUESTRO y libre— no matcheaba ningun slot, caia en
+  // `proposesOwnTime` y se iba a la cola humana, que ese dia tenia leads esperando hace 15-20
+  // dias. De 43 conversaciones, 18 llegaron a `esperando_horario` y CERO a `demo_agendada`.
+  //
+  // Van SIN `key` a proposito: `detectSlotChoice` resuelve "A"/"B" por letra contra la foto
+  // ofrecida, y una letra reasignada le confirmaria a alguien un dia que nunca eligio — peor
+  // que el bug que esto cierra. Se matchean solo nombrando el dia y la hora.
+  const extras = candidatos
+    .filter((slot) => !slot.pending && !elegidos.includes(slot))
+    .map((slot) => ({ key: null, label: slot.label || "", startAt: slot.startAt, pending: false }));
+
+  return [...ofrecidos, ...extras];
 }
 
