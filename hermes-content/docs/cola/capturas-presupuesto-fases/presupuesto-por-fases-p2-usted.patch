@@ -0,0 +1,97 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+
+import { getRequestMeta, logAudit } from "@/lib/audit";
+import { AuthError, requireAuth } from "@/lib/auth";
+import { registrarError } from "@/lib/http/registrar-error";
+import { requirePermission } from "@/lib/onia-core/access-control";
+import { requireVerticalRoute } from "@/lib/platform/api-guard";
+import { clienteNoEncontrado, palabrasDeLaSesion } from "@/lib/platform/idioma-del-error";
+import { prisma } from "@/lib/prisma";
+import { resolveVerticalPack } from "@/lib/platform/vertical-pack";
+import { centavosDe, FASES_MAX, presupuestoEnRubro } from "@/lib/presupuesto/fases";
+import { firmarPresupuestoToken } from "@/lib/presupuesto/token";
+
+// El link público del presupuesto por fases (2-oct, hueco #2 de dental en la
+// auditoría; lo #1 que copiar de Doctocliq). El cliente manda QUÉ filas y en qué
+// fase; el PRECIO sale del catálogo del negocio acá, en el servidor, y queda
+// congelado en el link firmado. Solo dental y estética (registro de rutas).
+const bodySchema = z.object({
+  filas: z
+    .array(z.object({ id: z.string().min(1).max(64), fase: z.number().int().min(1).max(FASES_MAX) }))
+    .min(1, "Elegí al menos un tratamiento")
+    .max(60)
+    .refine((filas) => new Set(filas.map((f) => f.id)).size === filas.length, "Un tratamiento aparece dos veces"),
+});
+
+function urlBase(): string {
+  return (process.env.NEXT_PUBLIC_APP_URL?.trim() || "https://app.onia.com.bo").replace(/\/$/, "");
+}
+
+export async function POST(request: Request, { params }: { params: Promise<{ id: string }> }) {
+  try {
+    const profile = await requireAuth();
+    await requireVerticalRoute("patients/[id]/presupuesto");
+    // El presupuesto nombra tratamientos: dato clínico.
+    await requirePermission(profile, "clinical.read", request);
+    // El registro abre el segmento /patients a los cuatro rubros con agenda; el
+    // presupuesto es solo de dental y estética (presupuestoEnRubro).
+    const org = await prisma.organization.findUnique({
+      where: { id: profile.organizationId },
+      select: { verticalTrackId: true },
+    });
+    if (!presupuestoEnRubro(resolveVerticalPack(org?.verticalTrackId ?? "").trackId)) {
+      return NextResponse.json({ error: "El presupuesto por fases es de clínicas dentales y de estética." }, { status: 403 });
+    }
+    const { id } = await params;
+    const { filas } = bodySchema.parse(await request.json());
+
+    // El celular de hoy: el link queda atado a él (corregirlo lo anula).
+    const patient = await prisma.patient.findFirst({
+      where: { id, organizationId: profile.organizationId },
+      select: { id: true, phone: true },
+    });
+    if (!patient) return NextResponse.json({ error: clienteNoEncontrado(await palabrasDeLaSesion()) }, { status: 404 });
+
+    const ids = filas.map((f) => f.id);
+    const enLaBase = await prisma.patientTreatment.findMany({
+      where: { organizationId: profile.organizationId, patientId: id, id: { in: ids }, status: { not: "CANCELADO" } },
+      select: { id: true, treatment: { select: { price: true } } },
+    });
+    if (enLaBase.length !== ids.length) {
+      return NextResponse.json({ error: "Algún tratamiento ya no está en el plan. Recargá la página." }, { status: 400 });
+    }
+    const precio = new Map(enLaBase.map((f) => [f.id, centavosDe(f.treatment.price)]));
+    const ahora = new Date();
+    const token = firmarPresupuestoToken({
+      organizationId: profile.organizationId,
+      patientId: id,
+      filas: filas.map((f) => ({ id: f.id, fase: f.fase, centavos: precio.get(f.id) ?? 0 })),
+      telefono: patient.phone,
+      ahora,
+    });
+
+    // Un link que se abre SIN sesión y nombra tratamientos: queda quién lo armó.
+    const meta = getRequestMeta(request);
+    await logAudit({
+      organizationId: profile.organizationId,
+      userId: profile.userId,
+      action: "BUDGET_LINK_CREATED",
+      entityType: "Patient",
+      entityId: id,
+      newValue: { filas: filas.length },
+      ipAddress: meta.ipAddress,
+      userAgent: meta.userAgent,
+    });
+
+    return NextResponse.json({ url: `${urlBase()}/presupuesto/${token}` });
+  } catch (err) {
+    if (err instanceof AuthError) return NextResponse.json({ error: "No autorizado" }, { status: 403 });
+    if (err instanceof z.ZodError) {
+      return NextResponse.json({ error: err.issues.map((e) => e.message).join(", ") }, { status: 400 });
+    }
+    if (err instanceof SyntaxError) return NextResponse.json({ error: "Datos inválidos" }, { status: 400 });
+    registrarError("api/patients/[id]/presupuesto", "POST", err);
+    return NextResponse.json({ error: "No se pudo armar el link del presupuesto" }, { status: 500 });
+  }
+}
