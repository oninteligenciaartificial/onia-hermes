+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+// POST /api/patients/:id/presupuesto — arma el link público del presupuesto por
+// fases (2-oct). Lo que defiende: permiso clínico, rubro (solo dental y
+// estética), aislamiento por negocio Y por paciente, y que el PRECIO salga del
+// catálogo del negocio en el servidor, nunca del cliente.
+const authMocks = vi.hoisted(() => {
+  class AuthError extends Error {
+    constructor(message: string) {
+      super(message);
+      this.name = "AuthError";
+    }
+  }
+  return { AuthError, requireAuth: vi.fn() };
+});
+
+vi.mock("@/lib/auth", () => ({ AuthError: authMocks.AuthError, requireAuth: authMocks.requireAuth }));
+
+const prismaMocks = vi.hoisted(() => ({
+  patient: { findFirst: vi.fn() },
+  patientTreatment: { findMany: vi.fn() },
+  oniaCoreRoleAssignment: { findMany: vi.fn() },
+  organization: { findUnique: vi.fn() },
+  auditLog: { create: vi.fn() },
+}));
+vi.mock("@/lib/prisma", () => ({ prisma: prismaMocks }));
+
+const guard = vi.hoisted(() => ({ requireVerticalRoute: vi.fn() }));
+vi.mock("@/lib/platform/api-guard", () => guard);
+
+import { huellaDelTelefono, verificarPresupuestoToken } from "@/lib/presupuesto/token";
+
+import { POST } from "./route";
+
+function perfil(role: "ADMIN" | "DOCTOR" | "STAFF") {
+  return { id: "prof_1", userId: "user_1", organizationId: "org_1", role, name: "x" };
+}
+
+function pedir(body: unknown, id = "pat_1") {
+  return POST(new Request(`https://x.test/api/patients/${id}/presupuesto`, { method: "POST", body: JSON.stringify(body) }), {
+    params: Promise.resolve({ id }),
+  });
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  process.env.ENCRYPTION_KEY = "a".repeat(64);
+  process.env.NEXT_PUBLIC_APP_URL = "https://app.onia.com.bo";
+  authMocks.requireAuth.mockResolvedValue(perfil("DOCTOR"));
+  guard.requireVerticalRoute.mockResolvedValue(undefined);
+  prismaMocks.oniaCoreRoleAssignment.findMany.mockResolvedValue([]);
+  prismaMocks.organization.findUnique.mockResolvedValue({ verticalTrackId: "dentagest-clinical" });
+  prismaMocks.auditLog.create.mockResolvedValue({});
+  prismaMocks.patient.findFirst.mockResolvedValue({ id: "pat_1", phone: "71234567" });
+  prismaMocks.patientTreatment.findMany.mockResolvedValue([
+    { id: "pt_a", treatment: { price: "800.00" } },
+    { id: "pt_b", treatment: { price: "1200.50" } },
+  ]);
+});
+
+describe("POST /api/patients/:id/presupuesto", () => {
+  it("arma un link firmado con las fases y el precio del CATÁLOGO, no el que mande el cliente", async () => {
+    const res = await pedir({
+      filas: [
+        { id: "pt_a", fase: 1, centavos: 1 },
+        { id: "pt_b", fase: 2 },
+      ],
+    });
+
+    expect(res.status).toBe(200);
+    const { url } = await res.json();
+    expect(url).toMatch(/^https:\/\/app\.onia\.com\.bo\/presupuesto\/[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/);
+    const leido = verificarPresupuestoToken(url.split("/presupuesto/")[1]);
+    expect(leido).toMatchObject({
+      organizationId: "org_1",
+      patientId: "pat_1",
+      filas: [
+        { id: "pt_a", fase: 1, centavos: 80_000 },
+        { id: "pt_b", fase: 2, centavos: 120_050 },
+      ],
+    });
+  });
+
+  it("el link queda atado al celular de la ficha: corregirlo después lo anula", async () => {
+    const { url } = await (await pedir({ filas: [{ id: "pt_a", fase: 1 }, { id: "pt_b", fase: 1 }] })).json();
+    expect(verificarPresupuestoToken(url.split("/presupuesto/")[1])?.huellaTelefono).toBe(huellaDelTelefono("71234567"));
+    expect(prismaMocks.patient.findFirst.mock.calls[0][0].select).toEqual({ id: true, phone: true });
+  });
+
+  it("lee las filas por negocio, paciente e ids, sin las canceladas", async () => {
+    await pedir({ filas: [{ id: "pt_a", fase: 1 }, { id: "pt_b", fase: 1 }] });
+
+    expect(prismaMocks.patient.findFirst.mock.calls[0][0].where).toEqual({ id: "pat_1", organizationId: "org_1" });
+    expect(prismaMocks.patientTreatment.findMany.mock.calls[0][0].where).toEqual({
+      organizationId: "org_1",
+      patientId: "pat_1",
+      id: { in: ["pt_a", "pt_b"] },
+      status: { not: "CANCELADO" },
+    });
+  });
+
+  it("una fila de otro paciente u otro negocio no entra: 400 y no firma nada", async () => {
+    prismaMocks.patientTreatment.findMany.mockResolvedValue([{ id: "pt_a", treatment: { price: "800.00" } }]);
+
+    const res = await pedir({ filas: [{ id: "pt_a", fase: 1 }, { id: "pt_ajena", fase: 1 }] });
+
+    expect(res.status).toBe(400);
+    expect(prismaMocks.auditLog.create).not.toHaveBeenCalled();
+  });
+
+  it("paciente de otro negocio: 404", async () => {
+    prismaMocks.patient.findFirst.mockResolvedValue(null);
+    expect((await pedir({ filas: [{ id: "pt_a", fase: 1 }] })).status).toBe(404);
+  });
+
+  it("queda en auditoría quién armó un link que se abre sin sesión", async () => {
+    await pedir({ filas: [{ id: "pt_a", fase: 1 }, { id: "pt_b", fase: 1 }] });
+
+    const { data } = prismaMocks.auditLog.create.mock.calls[0][0];
+    expect(data).toMatchObject({ organizationId: "org_1", userId: "user_1", action: "BUDGET_LINK_CREATED", entityType: "Patient", entityId: "pat_1" });
+  });
+
+  it("sin filas, fase fuera de rango o ids repetidos: 400", async () => {
+    expect((await pedir({ filas: [] })).status).toBe(400);
+    expect((await pedir({ filas: [{ id: "pt_a", fase: 7 }] })).status).toBe(400);
+    expect((await pedir({ filas: [{ id: "pt_a", fase: 1 }, { id: "pt_a", fase: 2 }] })).status).toBe(400);
+  });
+
+  it("recepción (STAFF, sin lo clínico): 403", async () => {
+    authMocks.requireAuth.mockResolvedValue(perfil("STAFF"));
+    expect((await pedir({ filas: [{ id: "pt_a", fase: 1 }] })).status).toBe(403);
+    expect(prismaMocks.patientTreatment.findMany).not.toHaveBeenCalled();
+  });
+
+  it("pasa por el guard de rubro del registro", async () => {
+    await pedir({ filas: [{ id: "pt_a", fase: 1 }, { id: "pt_b", fase: 1 }] });
+    expect(guard.requireVerticalRoute).toHaveBeenCalledWith("patients/[id]/presupuesto");
+  });
+
+  it("veterinaria o servicios (comparten /patients): 403 y no lee el plan", async () => {
+    // El registro no distingue más fino que el segmento /patients: el rubro se
+    // controla acá. En veterinaria el tratamiento es de la mascota.
+    for (const track of ["vetgest-clinical", "gestios-servicios-profesionales"]) {
+      prismaMocks.organization.findUnique.mockResolvedValue({ verticalTrackId: track });
+      expect((await pedir({ filas: [{ id: "pt_a", fase: 1 }] })).status).toBe(403);
+    }
+    expect(prismaMocks.patientTreatment.findMany).not.toHaveBeenCalled();
+  });
+
+  it("estética sí", async () => {
+    prismaMocks.organization.findUnique.mockResolvedValue({ verticalTrackId: "esteticagest-clinical" });
+    expect((await pedir({ filas: [{ id: "pt_a", fase: 1 }, { id: "pt_b", fase: 2 }] })).status).toBe(200);
+  });
+});
