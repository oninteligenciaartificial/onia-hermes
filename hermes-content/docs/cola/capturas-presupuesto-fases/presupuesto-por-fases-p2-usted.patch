+
+  it("token inválido o vencido: null sin tocar la base", async () => {
+    expect(await cargarPresupuestoPublico("basura.firma", AHORA)).toBeNull();
+    expect(await cargarPresupuestoPublico(token, new Date(AHORA.getTime() + 40 * 86_400_000))).toBeNull();
+    expect(prismaMocks.organization.findUnique).not.toHaveBeenCalled();
+    expect(prismaMocks.patientTreatment.findMany).not.toHaveBeenCalled();
+  });
+
+  it("dado de baja o de otro negocio (no aparece): null", async () => {
