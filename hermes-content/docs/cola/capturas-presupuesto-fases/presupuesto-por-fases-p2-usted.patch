+import type { Metadata } from "next";
+import { headers } from "next/headers";
+
+import { ESTILOS_COMPROBANTE } from "@/app/print/estilos";
+import { ESTILOS_PRESUPUESTO, PresupuestoVista } from "@/app/print/presupuesto/PresupuestoVista";
+import { cargarPresupuestoPublico } from "@/lib/presupuesto/cargar";
+import { checkRateLimitKey } from "@/lib/rate-limit";
+
+// El link del presupuesto que la clínica le manda al paciente por WhatsApp
+// (2-oct). Sin sesión: lo autoriza el token firmado, con vencimiento, de UNA
+// persona de UN negocio (lib/presupuesto/token.ts). Solo lectura.
+//
+// No indexable y sin Referer: la URL lleva el token, y un buscador o un sitio
+// externo no tienen por qué verla.
+export const metadata: Metadata = {
+  title: "Su presupuesto",
+  description: "El presupuesto de su tratamiento, por fases.",
+  robots: { index: false, follow: false, googleBot: { index: false, follow: false } },
+  referrer: "no-referrer",
+};
+
+export const dynamic = "force-dynamic";
+
+/** 30 aperturas por minuto por IP: un link legítimo se abre pocas veces. */
+const LIMITE = { windowMs: 60_000, maxRequests: 30 };
+
+function NoDisponible() {
+  return (
+    <main className="mx-auto flex min-h-[60vh] max-w-md flex-col items-center justify-center gap-3 px-6 text-center">
+      <h1 className="text-xl font-semibold text-on-surface">Este presupuesto ya no está disponible</h1>
+      <p className="text-sm text-on-surface-variant">Pídale uno nuevo a quien se lo envió.</p>
+    </main>
+  );
+}
+
+export default async function PresupuestoPublicoPage({ params }: { params: Promise<{ token: string }> }) {
+  const h = await headers();
+  const ip = h.get("cf-connecting-ip")?.trim() || h.get("x-forwarded-for")?.split(",")[0]?.trim() || "unknown";
+  if (!checkRateLimitKey(LIMITE, `presupuesto:${ip}`).allowed) return <NoDisponible />;
+
+  const { token } = await params;
+  const datos = await cargarPresupuestoPublico(token);
+  if (!datos) return <NoDisponible />;
+
+  return (
+    <>
+      <style>{ESTILOS_COMPROBANTE + ESTILOS_PRESUPUESTO}</style>
+      <PresupuestoVista {...datos} />
+    </>
+  );
+}
