+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { firmarPortalToken, verificarPortalToken } from "@/lib/onia-core/portal-token";
+
+import { firmarPresupuestoToken, huellaDelTelefono, PRESUPUESTO_VALIDEZ_DIAS, verificarPresupuestoToken } from "./token";
+
+// El link público del presupuesto (2-oct): el paciente lo abre sin sesión desde
+// WhatsApp. Lo que defiende (skill onia-seguridad): no adivinable (HMAC con el
+// secreto del servidor), vence, alcanza a UNA persona de UN negocio, y no se
+// confunde con el token del portal de requerimientos (mismo secreto de base).
+
+const ORIGINAL = { ...process.env };
+const AHORA = new Date("2026-10-02T14:00:00.000Z");
+const BASE = {
+  organizationId: "org_1",
+  patientId: "pat_1",
+  filas: [
+    { id: "pt_a", fase: 1, centavos: 80_000 },
+    { id: "pt_b", fase: 2, centavos: 120_000 },
+  ],
+};
+/** El celular de la ficha al armar el link: el link vale para ESE número. */
+const TELEFONO = "70012345";
+
+beforeEach(() => {
+  process.env.ENCRYPTION_KEY = "a".repeat(64);
+  delete process.env.PORTAL_TOKEN_SECRET;
+});
+afterEach(() => {
+  process.env = { ...ORIGINAL };
+});
+
+describe("token del presupuesto", () => {
+  it("ida y vuelta: negocio, persona, filas con fase y precio, emisión y vencimiento", () => {
+    const token = firmarPresupuestoToken({ ...BASE, telefono: TELEFONO, ahora: AHORA });
+    const leido = verificarPresupuestoToken(token, AHORA);
+    expect(leido).toEqual({
+      ...BASE,
+      huellaTelefono: huellaDelTelefono(TELEFONO),
+      emitidoEl: AHORA,
+      venceEl: new Date(AHORA.getTime() + PRESUPUESTO_VALIDEZ_DIAS * 86_400_000),
+    });
+  });
+
+  it("vence: al día siguiente del vencimiento ya no abre", () => {
+    const token = firmarPresupuestoToken({ ...BASE, telefono: TELEFONO, ahora: AHORA });
+    const despues = new Date(AHORA.getTime() + (PRESUPUESTO_VALIDEZ_DIAS + 1) * 86_400_000);
+    expect(verificarPresupuestoToken(token, despues)).toBeNull();
+  });
+
+  it("tocar un solo carácter del contenido (otra persona, otro precio) lo invalida", () => {
+    const token = firmarPresupuestoToken({ ...BASE, telefono: TELEFONO, ahora: AHORA });
+    const [carga, firma] = token.split(".");
+    const otro = JSON.parse(Buffer.from(carga, "base64url").toString("utf8"));
+    otro.p = "pat_ajeno";
+    const falsificado = `${Buffer.from(JSON.stringify(otro)).toString("base64url")}.${firma}`;
+    expect(verificarPresupuestoToken(falsificado, AHORA)).toBeNull();
+  });
+
+  it("firmado con otro secreto no abre", () => {
+    const token = firmarPresupuestoToken({ ...BASE, telefono: TELEFONO, ahora: AHORA });
+    process.env.ENCRYPTION_KEY = "b".repeat(64);
+    expect(verificarPresupuestoToken(token, AHORA)).toBeNull();
+  });
+
+  it("no se cruza con el portal: un token de portal no abre un presupuesto ni al revés", () => {
+    const portal = firmarPortalToken({ organizationId: "org_1", patientId: "pat_1" });
+    expect(verificarPresupuestoToken(portal, AHORA)).toBeNull();
+    const presupuesto = firmarPresupuestoToken({ ...BASE, telefono: TELEFONO, ahora: new Date() });
+    expect(verificarPortalToken(presupuesto)).toBeNull();
+  });
+
+  it("basura, vacío o formato raro: null, nunca una excepción", () => {
+    for (const malo of ["", "abc", "a.b.c", "....", "%%%.%%%"]) {
+      expect(verificarPresupuestoToken(malo, AHORA)).toBeNull();
+    }
+  });
+
+  it("no lleva nombres ni teléfonos: solo ids, fases, centavos y la HUELLA del celular", () => {
+    const token = firmarPresupuestoToken({ ...BASE, telefono: TELEFONO, ahora: AHORA });
+    const carga = Buffer.from(token.split(".")[0], "base64url").toString("utf8");
+    expect(Object.keys(JSON.parse(carga)).sort()).toEqual(["e", "f", "i", "k", "o", "p", "t"]);
+    // La huella va con la clave del servidor: el número no se puede sacar del link
+    // probando los ~20 millones de celulares bolivianos.
+    expect(carga).not.toContain("70012345");
+    expect(carga).not.toContain("59170012345");
+  });
+
+  // Auditoría del 2-oct: el link era stateless y valía 30 días sin forma de
+  // cortarlo. Con el celular mal escrito, «Enviar al paciente» lo mandaba a un
+  // desconocido, que veía nombre, tratamientos, piezas y montos un mes entero.
+  it("la huella del celular: el mismo número en otro formato da la misma; otro número, otra", () => {
+    const h = huellaDelTelefono("70012345");
+    expect(huellaDelTelefono("+591 700 12345")).toBe(h);
+    expect(huellaDelTelefono("59170012345")).toBe(h);
+    expect(huellaDelTelefono("70012346")).not.toBe(h);
+    expect(huellaDelTelefono(null)).not.toBe(h);
+  });
+
+  it("la huella depende del secreto del servidor", () => {
+    const h = huellaDelTelefono("70012345");
+    process.env.ENCRYPTION_KEY = "b".repeat(64);
+    expect(huellaDelTelefono("70012345")).not.toBe(h);
+  });
+});
