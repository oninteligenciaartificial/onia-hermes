+// consulta va por el negocio Y la persona del token (nunca datos de otro
+// paciente); dado de baja, otro rubro o plan vacío = no disponible.
+
+const prismaMocks = vi.hoisted(() => ({
+  organization: { findUnique: vi.fn() },
+  patient: { findFirst: vi.fn() },
+  patientTreatment: { findMany: vi.fn() },
+  clinicSettings: { findUnique: vi.fn() },
+}));
+vi.mock("@/lib/prisma", () => ({ prisma: prismaMocks }));
+
+import { cargarPresupuestoPublico } from "./cargar";
+import { firmarPresupuestoToken } from "./token";
+
+const AHORA = new Date("2026-10-02T14:00:00.000Z");
+let token = "";
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  process.env.ENCRYPTION_KEY = "a".repeat(64);
+  token = firmarPresupuestoToken({
+    organizationId: "org_1",
+    patientId: "pat_1",
+    filas: [
+      { id: "pt_b", fase: 2, centavos: 120_000 },
+      { id: "pt_a", fase: 1, centavos: 80_000 },
+    ],
+    telefono: "71234567",
+    ahora: AHORA,
+  });
+  prismaMocks.organization.findUnique.mockResolvedValue({
+    name: "Clínica Dental Aramayo",
+    address: null,
+    phone: "33445566",
+    email: null,
+    nit: null,
+    verticalTrackId: "dentagest-clinical",
+  });
+  prismaMocks.patient.findFirst.mockResolvedValue({ name: "Lucía Mendoza", phone: "71234567" });
+  prismaMocks.clinicSettings.findUnique.mockResolvedValue({ timezone: "America/La_Paz" });
+  prismaMocks.patientTreatment.findMany.mockResolvedValue([
+    { id: "pt_a", toothNumber: 36, treatment: { name: "Endodoncia" } },
+    { id: "pt_b", toothNumber: 36, treatment: { name: "Corona de porcelana" } },
+  ]);
+});
+
+describe("cargarPresupuestoPublico", () => {
+  it("arma la hoja con el PRECIO del token y los nombres de la base, en el orden del link", async () => {
+    const datos = await cargarPresupuestoPublico(token, AHORA);
+    expect(datos?.para).toBe("Lucía Mendoza");
+    expect(datos?.rotuloPieza).toBe("Diente");
+    expect(datos?.armado.fases.map((f) => f.filas.map((x) => [x.nombre, x.centavos]))).toEqual([
+      [["Endodoncia", 80_000]],
+      [["Corona de porcelana", 120_000]],
+    ]);
+    expect(datos?.armado.totalCentavos).toBe(200_000);
+  });
+
+  it("cada consulta va por el negocio y la persona del token", async () => {
+    await cargarPresupuestoPublico(token, AHORA);
+    expect(prismaMocks.patient.findFirst.mock.calls[0][0].where).toEqual({ id: "pat_1", organizationId: "org_1", deactivatedAt: null });
+    expect(prismaMocks.patientTreatment.findMany.mock.calls[0][0].where).toEqual({
+      organizationId: "org_1",
+      patientId: "pat_1",
+      id: { in: ["pt_b", "pt_a"] },
+      status: { not: "CANCELADO" },
+    });
