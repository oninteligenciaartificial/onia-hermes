+++ b/app/print/presupuesto/[patientId]/page.tsx
@@ -0,0 +1,88 @@
+// Presupuesto por fases imprimible (2-oct): el navegador lo imprime o lo guarda
+// como PDF. Misma hoja que recibe el paciente por el link (PresupuestoVista).
+//
+// Con sesión, como las otras rutas de /print: la persona y sus pasos tienen que
+// ser de la organización del usuario, con clinical.read y en un rubro con
+// presupuesto (dental y estética). Las fases llegan en la URL (?f=id:fase,...)
+// y el precio sale del catálogo.
+
+import { notFound, redirect } from "next/navigation";
+
+import { hasPermissionForProfile } from "@/lib/onia-core/access-control";
+import { resolveVerticalPack, tieneOdontograma } from "@/lib/platform/vertical-pack";
+import { prisma } from "@/lib/prisma";
+import { armarPresupuesto, centavosDe, leerFases, presupuestoEnRubro, PRESUPUESTO_VALIDEZ_DIAS } from "@/lib/presupuesto/fases";
+import { createClient } from "@/lib/supabase/server";
+import { DEFAULT_TZ } from "@/lib/time";
+
+import { PrintTrigger } from "../../invoice/[id]/PrintTrigger";
+import { ESTILOS_COMPROBANTE } from "../../estilos";
+import { ESTILOS_PRESUPUESTO, PresupuestoVista } from "../PresupuestoVista";
+
+export default async function PrintPresupuestoPage({
+  params,
+  searchParams,
+}: {
+  params: Promise<{ patientId: string }>;
+  searchParams: Promise<{ f?: string }>;
+}) {
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) redirect("/login");
+
+  const profile = await prisma.profile.findUnique({
+    where: { userId: user.id },
+    include: { organization: { include: { clinicSettings: { select: { timezone: true } } } } },
+  });
+  if (!profile) redirect("/login");
+
+  const trackId = resolveVerticalPack(profile.organization.verticalTrackId ?? "").trackId;
+  if (!presupuestoEnRubro(trackId) || !(await hasPermissionForProfile(profile, "clinical.read"))) notFound();
+
+  const { patientId } = await params;
+  const fases = leerFases((await searchParams).f);
+  const [persona, plan] = await Promise.all([
+    prisma.patient.findFirst({ where: { id: patientId, organizationId: profile.organizationId }, select: { name: true } }),
+    prisma.patientTreatment.findMany({
+      where: {
+        organizationId: profile.organizationId,
+        patientId,
+        id: { in: [...fases.keys()] },
+        status: { not: "CANCELADO" },
+      },
+      orderBy: { date: "asc" },
+      select: { id: true, toothNumber: true, treatment: { select: { name: true, price: true } } },
+    }),
+  ]);
+  if (!persona || plan.length === 0) notFound();
+
+  const esDental = tieneOdontograma(trackId);
+  const ahora = new Date();
+  const org = profile.organization;
+
+  return (
+    <>
+      <PrintTrigger />
+      <style>{ESTILOS_COMPROBANTE + ESTILOS_PRESUPUESTO}</style>
+      <PresupuestoVista
+        emisor={org}
+        para={persona.name}
+        rotuloPieza={esDental ? "Diente" : null}
+        emitidoEl={ahora}
+        venceEl={new Date(ahora.getTime() + PRESUPUESTO_VALIDEZ_DIAS * 86_400_000)}
+        timeZone={org.clinicSettings?.timezone || DEFAULT_TZ}
+        armado={armarPresupuesto(
+          plan.map((f) => ({
+            id: f.id,
+            nombre: f.treatment.name,
+            pieza: esDental ? f.toothNumber : null,
+            centavos: centavosDe(f.treatment.price),
+          })),
+          fases,
+        )}
+      />
+    </>
+  );
+}
