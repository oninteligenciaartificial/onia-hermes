--- /dev/null
+++ b/lib/presupuesto/cargar.ts
@@ -0,0 +1,75 @@
+// Lo que el paciente ve al abrir el link del presupuesto (2-oct). Sin sesión:
+// todo lo autoriza el token firmado (lib/presupuesto/token.ts).
+//
+// - Token inválido o vencido: null sin tocar la base.
+// - Cada consulta va por el negocio Y la persona del token: el link no puede
+//   mostrar nada de otro paciente aunque alguien le cambie los ids de las filas
+//   (la firma lo impide, y la consulta lo impide otra vez).
+// - El PRECIO sale del token (congelado al armarlo); los nombres, de la base.
+// - Dado de baja, negocio que ya no es dental/estética o plan vacío (todo se
+//   canceló o se borró): no disponible.
+// - Otro celular en la ficha que el del link (se corrigió un número mal
+//   escrito): no disponible. El link vale para el número al que se mandó.
+
+import type { EmisorRecibo } from "@/app/print/recibo-venta/ReciboVentaVista";
+import { resolveVerticalPack, tieneOdontograma } from "@/lib/platform/vertical-pack";
+import { prisma } from "@/lib/prisma";
+import { DEFAULT_TZ } from "@/lib/time";
+
+import { armarPresupuesto, presupuestoEnRubro, type PresupuestoArmado } from "./fases";
+import { huellaDelTelefono, verificarPresupuestoToken } from "./token";
+
+export interface PresupuestoPublico {
+  emisor: EmisorRecibo;
+  para: string;
+  rotuloPieza: string | null;
+  emitidoEl: Date;
+  venceEl: Date;
+  timeZone: string;
+  armado: PresupuestoArmado;
+}
+
+export async function cargarPresupuestoPublico(token: string, ahora: Date = new Date()): Promise<PresupuestoPublico | null> {
+  const firmado = verificarPresupuestoToken(token, ahora);
+  if (!firmado) return null;
+  const { organizationId, patientId, filas } = firmado;
+
+  const org = await prisma.organization.findUnique({
+    where: { id: organizationId },
+    select: { name: true, address: true, phone: true, email: true, nit: true, verticalTrackId: true },
+  });
+  const trackId = resolveVerticalPack(org?.verticalTrackId ?? "").trackId;
+  if (!org || !presupuestoEnRubro(trackId)) return null;
+
+  const [persona, enLaBase, settings] = await Promise.all([
+    prisma.patient.findFirst({ where: { id: patientId, organizationId, deactivatedAt: null }, select: { name: true, phone: true } }),
+    prisma.patientTreatment.findMany({
+      where: { organizationId, patientId, id: { in: filas.map((f) => f.id) }, status: { not: "CANCELADO" } },
+      select: { id: true, toothNumber: true, treatment: { select: { name: true } } },
+    }),
+    prisma.clinicSettings.findUnique({ where: { organizationId }, select: { timezone: true } }),
+  ]);
+  if (!persona || enLaBase.length === 0) return null;
+  if (huellaDelTelefono(persona.phone) !== firmado.huellaTelefono) return null;
+
+  const esDental = tieneOdontograma(trackId);
+  const deLaBase = new Map(enLaBase.map((f) => [f.id, f]));
+  const presentes = filas.filter((f) => deLaBase.has(f.id));
+  const armado = armarPresupuesto(
+    presentes.map((f) => {
+      const fila = deLaBase.get(f.id)!;
+      return { id: f.id, nombre: fila.treatment.name, pieza: esDental ? fila.toothNumber : null, centavos: f.centavos };
+    }),
+    new Map(presentes.map((f) => [f.id, f.fase])),
+  );
+
+  return {
+    emisor: { name: org.name, address: org.address, phone: org.phone, email: org.email, nit: org.nit },
+    para: persona.name,
+    rotuloPieza: esDental ? "Diente" : null,
+    emitidoEl: firmado.emitidoEl,
+    venceEl: firmado.venceEl,
+    timeZone: settings?.timezone || DEFAULT_TZ,
+    armado,
+  };
+}
