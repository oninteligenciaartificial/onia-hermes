@@ -0,0 +1,66 @@
+// La HOJA del presupuesto por fases (2-oct): la misma que abre el paciente desde
+// WhatsApp (/presupuesto/[token]) y la que se imprime (/print/presupuesto).
+// Sin JSX a propósito: el include de vitest es **/*.test.ts.
+
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+
+import { armarPresupuesto } from "@/lib/presupuesto/fases";
+
+import { PresupuestoVista } from "./PresupuestoVista";
+
+const FILAS = [
+  { id: "a", nombre: "Endodoncia", pieza: 36, centavos: 80_000 },
+  { id: "b", nombre: "Corona de porcelana", pieza: 36, centavos: 120_050 },
+  { id: "c", nombre: "Limpieza dental", pieza: null, centavos: 15_000 },
+];
+
+function pintar(fases: Map<string, number>, extra: Partial<Parameters<typeof PresupuestoVista>[0]> = {}) {
+  const html = renderToStaticMarkup(
+    createElement(PresupuestoVista, {
+      emisor: { name: "Clínica Dental Aramayo", address: "Av. Busch 123", phone: "33445566", nit: "1023456028" },
+      para: "Lucía Mendoza",
+      rotuloPieza: "Diente",
+      emitidoEl: new Date("2026-10-02T14:00:00Z"),
+      venceEl: new Date("2026-11-01T14:00:00Z"),
+      timeZone: "America/La_Paz",
+      armado: armarPresupuesto(FILAS, fases),
+      ...extra,
+    }),
+  );
+  return { html, texto: html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ") };
+}
+
+describe("PresupuestoVista", () => {
+  it("con varias fases: cada una con su total, y el total general", () => {
+    const { texto } = pintar(new Map([["a", 1], ["c", 1], ["b", 2]]));
+    expect(texto).toContain("Fase 1");
+    expect(texto).toContain("Total fase 1 Bs 950,00");
+    expect(texto).toContain("Fase 2");
+    expect(texto).toContain("Total fase 2 Bs 1.200,50");
+    expect(texto).toContain("TOTAL Bs 2.150,50");
+    expect(texto.indexOf("Endodoncia")).toBeLessThan(texto.indexOf("Corona de porcelana"));
+  });
+
+  it("con una sola fase no dice «Fase 1» ni repite el total", () => {
+    const { texto } = pintar(new Map([["a", 1]]));
+    expect(texto).not.toContain("Fase 1");
+    expect(texto).not.toContain("Total fase");
+    expect(texto).toContain("TOTAL Bs 800,00");
+  });
+
+  it("para quién, del negocio, cuándo vence, y que no es factura", () => {
+    const { texto } = pintar(new Map([["a", 1]]));
+    expect(texto).toContain("Lucía Mendoza");
+    expect(texto).toContain("Clínica Dental Aramayo");
+    expect(texto).toContain("1 de noviembre de 2026");
+    expect(texto).toContain("Presupuesto, no es factura.");
+    expect(texto).toContain("Diente 36");
+  });
+
+  it("fuera del dental no hay diente", () => {
+    const { texto } = pintar(new Map([["a", 1]]), { rotuloPieza: null });
+    expect(texto).not.toContain("Diente");
+  });
+});
