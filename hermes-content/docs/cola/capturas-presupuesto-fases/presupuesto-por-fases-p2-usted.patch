+// El presupuesto por fases habla de USTED (Sergio Urcullo, 5-oct): al dueño en el
+// armador, en sus botones y en los errores de la ruta, y al paciente en la hoja
+// pública y en el WhatsApp. El parche del 2-oct venía en voseo al dueño
+// («Ordená el plan…», «Elegí al menos un…», «Para enviarlo, cargá un celular…»,
+// «Recargá la página»).
+//
+// Dos miradas: las frases EXACTAS que se ven (render) y un barrido de la fuente
+// de los archivos del presupuesto que caza cualquier voseo o tuteo nuevo.
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+
+vi.mock("next/link", () => ({
+  default: ({ children, href, ...rest }: { children: React.ReactNode; href: string }) => createElement("a", { href, ...rest }, children),
+}));
+
+import { ArmadorDePresupuesto } from "@/components/presupuesto/ArmadorDePresupuesto";
+import { mensajeDelPresupuesto } from "@/lib/presupuesto/fases";
+
+import { ARCHIVOS } from "./escanear-fuente";
+
+const VOCAB = { cliente: "paciente", clienteFemenino: false, servicio: "tratamiento", servicios: "tratamientos" };
+const PLAN = [
+  { id: "pt_a", nombre: "Endodoncia", pieza: 36, centavos: 80_000, status: "PENDIENTE" },
+  { id: "pt_b", nombre: "Limpieza dental", pieza: null, centavos: 15_000, status: "COMPLETADO" },
+];
+
+function pintar(extra: Partial<Parameters<typeof ArmadorDePresupuesto>[0]> = {}) {
+  const html = renderToStaticMarkup(
+    createElement(ArmadorDePresupuesto, {
+      patientId: "pat_1",
+      nombre: "Lucía Mendoza",
+      telefono: "71234567",
+      negocio: "Clínica Dental Aramayo",
+      filas: PLAN,
+      rotuloPieza: "Diente",
+      vocab: VOCAB,
+      ...extra,
+    }),
+  );
+  return html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ");
+}
+
+/**
+ * Voseo y tuteo en una línea de texto. Palabras terminadas en á/é/í tónica
+ * (Probá, Elegí, cargá, podés…) menos las que no son verbo de segunda persona,
+ * y los pronombres tú/tu/tus/te/vos/ti.
+ */
+const NO_SON_VOSEO = new Set([
+  "acá", "allá", "ahí", "aquí", "así", "atrás", "además", "demás", "después", "más", "qué", "quién", "cuál",
+  "cómo", "dónde", "cuándo", "está", "están", "sí", "también", "válido", "envió",
+]);
+function voseoEn(linea: string): string[] {
+  const hallazgos: string[] = [];
+  for (const m of linea.matchAll(/(?<!\p{L})(\p{L}+(?:ás|és|ís|á|é|í))(?!\p{L})/gu)) {
+    if (!NO_SON_VOSEO.has(m[1].toLowerCase())) hallazgos.push(m[1]);
+  }
+  for (const m of linea.matchAll(/(?<!\p{L})(tú|tu|tus|te|vos|ti|contigo)(?!\p{L})/giu)) hallazgos.push(m[1]);
+  return hallazgos;
+}
+
+const DEL_PRESUPUESTO = (ruta: string) =>
+  ruta.startsWith("components/presupuesto/") ||
+  ruta.startsWith("lib/presupuesto/") ||
+  ruta.startsWith("app/print/presupuesto/") ||
+  ruta.startsWith("app/(public)/presupuesto/") ||
+  ruta.startsWith("app/(dashboard)/patients/[id]/presupuesto/") ||
+  ruta.startsWith("app/api/patients/[id]/presupuesto/");
+
+describe("el presupuesto por fases habla de usted", () => {
+  it("el armador, al dueño", () => {
+    expect(pintar()).toContain("Ordene el plan en fases. Los precios salen de su catálogo de tratamientos.");
+  });
+
+  it("sin nada elegido, dice qué falta de usted", () => {
+    const soloLoHecho = [{ ...PLAN[1] }];
+    expect(pintar({ filas: soloLoHecho })).toContain("Elija al menos un tratamiento.");
+  });
+
+  it("sin un celular al que WhatsApp llegue, dice qué cargar de usted", () => {
+    expect(pintar({ telefono: "3344556" })).toContain("Para enviarlo, cargue un celular en su ficha.");
+  });
+
+  it("el WhatsApp al paciente: de usted y con el nombre de pila", () => {
+    expect(mensajeDelPresupuesto("Dra. Lucía Mendoza", "Clínica Dental Aramayo", "https://app.onia.com.bo/presupuesto/x.y")).toBe(
+      "Hola Lucía, le enviamos su presupuesto de Clínica Dental Aramayo: https://app.onia.com.bo/presupuesto/x.y",
+    );
+  });
+
+  it("ninguna pantalla del armador vosea ni tutea", () => {
+    for (const texto of [pintar(), pintar({ filas: [] }), pintar({ filas: [{ ...PLAN[1] }] }), pintar({ telefono: null })]) {
+      expect(voseoEn(texto)).toEqual([]);
+    }
+  });
+
+  it("ningún archivo del presupuesto vosea ni tutea (fuente sin comentarios)", () => {
+    const archivos = ARCHIVOS.filter((a) => DEL_PRESUPUESTO(a.ruta));
