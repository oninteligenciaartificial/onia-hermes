+import { describe, expect, it } from "vitest";
+
+import { armarPresupuesto, centavosDe, codificarFases, FASES_MAX, fasesPorDefecto, leerFases } from "./fases";
+
+// Presupuesto por fases (2-oct, hueco #2 de dental en la auditoría y lo #1 que
+// copiar de Doctocliq): el plan del paciente agrupado en fases, total por fase y
+// total general. Plata en CENTAVOS enteros: un 0,1 + 0,2 de coma flotante en un
+// presupuesto que el paciente lee es un error que se ve.
+
+const FILAS = [
+  { id: "pt_a", nombre: "Endodoncia", pieza: 36, centavos: 80_000 },
+  { id: "pt_b", nombre: "Corona de porcelana", pieza: 36, centavos: 120_000 },
+  { id: "pt_c", nombre: "Limpieza dental", pieza: null, centavos: 15_000 },
+  { id: "pt_d", nombre: "Blanqueamiento", pieza: null, centavos: 90_010 },
+];
+
+describe("centavosDe", () => {
+  it("lee el Decimal de Prisma (string) sin coma flotante", () => {
+    expect(centavosDe("1200.00")).toBe(120_000);
+    expect(centavosDe("0.1")).toBe(10);
+    expect(centavosDe("900.1")).toBe(90_010);
+    expect(centavosDe({ toString: () => "150.5" })).toBe(15_050);
+    expect(centavosDe(800)).toBe(80_000);
+  });
+});
+
+describe("armarPresupuesto", () => {
+  it("agrupa por fase, en el orden del plan, con total por fase y total general", () => {
+    const r = armarPresupuesto(FILAS, new Map([["pt_a", 1], ["pt_b", 2], ["pt_c", 1], ["pt_d", 0]]));
+    expect(r.fases.map((f) => [f.numero, f.filas.map((x) => x.id), f.totalCentavos])).toEqual([
+      [1, ["pt_a", "pt_c"], 95_000],
+      [2, ["pt_b"], 120_000],
+    ]);
+    expect(r.totalCentavos).toBe(215_000);
+  });
+
+  it("las fases se numeran seguidas: elegir 1 y 3 se lee 1 y 2", () => {
+    const r = armarPresupuesto(FILAS, new Map([["pt_a", 3], ["pt_b", 1]]));
+    expect(r.fases.map((f) => [f.numero, f.filas[0].id])).toEqual([
+      [1, "pt_b"],
+      [2, "pt_a"],
+    ]);
+  });
+
+  it("lo que no tiene fase no entra (ni al total)", () => {
+    expect(armarPresupuesto(FILAS, new Map())).toEqual({ fases: [], totalCentavos: 0 });
+  });
+});
+
+describe("fasesPorDefecto", () => {
+  it("lo que falta hacer va en la fase 1; lo hecho y lo cancelado quedan afuera", () => {
+    const f = fasesPorDefecto([
+      { id: "a", status: "EN_PROGRESO" },
+      { id: "b", status: "PENDIENTE" },
+      { id: "c", status: "COMPLETADO" },
+      { id: "d", status: "CANCELADO" },
+    ]);
+    expect([...f.entries()]).toEqual([
+      ["a", 1],
+      ["b", 1],
+    ]);
+  });
+});
+
+describe("codificarFases / leerFases (la URL de imprimir)", () => {
+  it("ida y vuelta", () => {
+    const fases = new Map([["cmg1aaaa", 1], ["cmg1bbbb", 2]]);
+    expect(leerFases(codificarFases(fases))).toEqual(fases);
+  });
+
+  it("descarta lo que no es un id o una fase válida", () => {
+    expect([...leerFases(`ok1:1,../x:1,ok2:${FASES_MAX + 1},ok3:0,ok4:2,ok5:dos`).entries()]).toEqual([
+      ["ok1", 1],
+      ["ok4", 2],
+    ]);
+    expect(leerFases(undefined).size).toBe(0);
+  });
+});
diff --git a/lib/presupuesto/fases.ts b/lib/presupuesto/fases.ts
new file mode 100644
index 00000000..02ec6c00
--- /dev/null
+++ b/lib/presupuesto/fases.ts
@@ -0,0 +1,97 @@
+// Presupuesto por fases (2-oct): el plan de tratamiento del paciente agrupado en
+// fases, con total por fase y total general. Hueco #2 de dental en la auditoría
+// de producción y lo #1 que copiar de Doctocliq (allá se arma a mano en 4 clics,
+// se agrupa por fases y se manda con un link público).
+//
+// Puro: sin base, sin reloj. La plata va en CENTAVOS enteros desde el Decimal de
+// Prisma, que llega como texto: «900.10» → 90010, sin pasar por coma flotante.
+// Las fases NO se guardan en la base (no hay columna; ver pendientes del carril):
+// viajan en la URL de imprimir y adentro del link firmado que recibe el paciente.
+
+export const FASES_MAX = 6;
+
+/** Días que vale el link del presupuesto (lo que dura un precio pasado). Acá y no en token.ts: el armador es de cliente y token.ts usa crypto. */
+export const PRESUPUESTO_VALIDEZ_DIAS = 30;
+
+/**
+ * Rubros con presupuesto por fases. Lista cerrada a propósito (igual que el
+ * Recall de tratamiento a medias): en veterinaria el tratamiento es de la
+ * mascota y el presupuesto no se le manda a ella; servicios profesionales no
+ * guarda su catálogo en treatments.
+ */
+const RUBROS_CON_PRESUPUESTO = new Set(["dentagest-clinical", "esteticagest-clinical"]);
+
+export function presupuestoEnRubro(trackId: string): boolean {
+  return RUBROS_CON_PRESUPUESTO.has(trackId);
+}
+
+export interface FilaDePresupuesto {
+  id: string;
+  nombre: string;
+  /** Pieza dental (FDI) o null fuera del dental. */
+  pieza: number | null;
+  centavos: number;
+}
+
+export interface FaseArmada {
+  numero: number;
+  filas: FilaDePresupuesto[];
+  totalCentavos: number;
+}
+
+export interface PresupuestoArmado {
+  fases: FaseArmada[];
+  totalCentavos: number;
+}
+
+/** «1200.00», 1200 o un Decimal → 120000. */
+export function centavosDe(valor: string | number | { toString(): string }): number {
+  const texto = typeof valor === "number" ? String(valor) : valor.toString();
+  const m = /^(\d+)(?:\.(\d{1,2}))?$/.exec(texto.trim());
+  if (m) return Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0"));
+  return Math.round(Number(texto) * 100);
+}
+
+/**
+ * Las filas con fase (1..FASES_MAX), agrupadas y numeradas SEGUIDAS en el orden
+ * de la fase elegida: quien eligió «1» y «3» lee «Fase 1» y «Fase 2». Dentro de
+ * cada fase, el orden del plan. Sin fase (0 o ausente) = no entra.
+ */
+export function armarPresupuesto(filas: readonly FilaDePresupuesto[], faseDe: ReadonlyMap<string, number>): PresupuestoArmado {
+  const porFase = new Map<number, FilaDePresupuesto[]>();
+  for (const fila of filas) {
+    const fase = faseDe.get(fila.id) ?? 0;
+    if (!Number.isInteger(fase) || fase < 1 || fase > FASES_MAX) continue;
+    porFase.set(fase, [...(porFase.get(fase) ?? []), fila]);
+  }
+  const fases = [...porFase.keys()]
+    .sort((a, b) => a - b)
+    .map((fase, i) => {
+      const lista = porFase.get(fase) ?? [];
+      return { numero: i + 1, filas: lista, totalCentavos: lista.reduce((s, f) => s + f.centavos, 0) };
+    });
+  return { fases, totalCentavos: fases.reduce((s, f) => s + f.totalCentavos, 0) };
+}
+
+/** Lo que falta hacer (Pendiente, En progreso) arranca en la fase 1; lo hecho y lo cancelado, afuera. */
+export function fasesPorDefecto(filas: readonly { id: string; status: string }[]): Map<string, number> {
+  return new Map(filas.filter((f) => f.status === "PENDIENTE" || f.status === "EN_PROGRESO").map((f) => [f.id, 1]));
+}
+
+const ID = /^[A-Za-z0-9_-]{1,64}$/;
+
+/** "id:fase,id:fase" para la URL de imprimir (la ve solo quien tiene sesión). */
+export function codificarFases(faseDe: ReadonlyMap<string, number>): string {
+  return [...faseDe.entries()].map(([id, fase]) => `${id}:${fase}`).join(",");
+}
+
+/** Lo inverso, descartando lo que no es un id ni una fase válida. */
+export function leerFases(texto: string | undefined | null): Map<string, number> {
+  const out = new Map<string, number>();
+  for (const par of (texto ?? "").split(",")) {
+    const [id, fase] = par.split(":");
+    const n = Number(fase);
+    if (id && ID.test(id) && /^\d+$/.test(fase ?? "") && n >= 1 && n <= FASES_MAX) out.set(id, n);
+  }
+  return out;
+}
