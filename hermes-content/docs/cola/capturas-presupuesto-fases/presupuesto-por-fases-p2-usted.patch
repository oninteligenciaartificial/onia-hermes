@@ -0,0 +1,71 @@
+// El armador del presupuesto por fases (2-oct), en la ficha del paciente. Sin
+// JSX a propósito. La captura a 390 y 1440 se mira aparte.
+
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+
+vi.mock("next/link", () => ({
+  default: ({ children, href, ...rest }: { children: React.ReactNode; href: string }) => createElement("a", { href, ...rest }, children),
+}));
+
+import { PresupuestoPorFases } from "./PresupuestoPorFases";
+
+const FILAS = [
+  { id: "pt_a", nombre: "Endodoncia", pieza: 36, centavos: 80_000, status: "EN_PROGRESO" },
+  { id: "pt_b", nombre: "Corona de porcelana", pieza: 36, centavos: 120_000, status: "PENDIENTE" },
+  { id: "pt_c", nombre: "Limpieza dental", pieza: null, centavos: 15_000, status: "COMPLETADO" },
+];
+
+function pintar(extra: Partial<Parameters<typeof PresupuestoPorFases>[0]> = {}) {
+  const html = renderToStaticMarkup(
+    createElement(PresupuestoPorFases, {
+      patientId: "pat_1",
+      nombre: "Lucía Mendoza",
+      telefono: "71234567",
+      negocio: "Clínica Dental Aramayo",
+      filas: FILAS,
+      rotuloPieza: "Diente",
+      vocab: { cliente: "paciente", clienteFemenino: false, servicio: "tratamiento", servicios: "tratamientos" },
+      ...extra,
+    }),
+  );
+  return { html, texto: html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ") };
+}
+
+describe("PresupuestoPorFases", () => {
+  it("arranca con lo que falta hacer en la fase 1 y el total con precios del catálogo", () => {
+    const { texto, html } = pintar();
+    expect(texto).toContain("Total Bs 2.000,00");
+    expect(html).toContain('aria-label="Fase de Endodoncia"');
+    expect(texto).toContain("No incluir");
+  });
+
+  it("lo ya hecho arranca afuera (se puede sumar)", () => {
+    const { html } = pintar();
+    // El select de la limpieza (Completado) arranca en «No incluir» (valor 0).
+    expect(html).toMatch(/aria-label="Fase de Limpieza dental"[^>]*>[\s\S]*?<option value="0" selected=""/);
+  });
+
+  it("imprimir lleva a la hoja con las fases elegidas", () => {
+    const { html } = pintar();
+    expect(html).toContain('href="/print/presupuesto/pat_1?f=pt_a%3A1%2Cpt_b%3A1"');
+  });
+
+  it("enviar le habla al paciente en el idioma del rubro", () => {
+    expect(pintar().texto).toContain("Enviar al paciente");
+    const estetica = { cliente: "clienta", clienteFemenino: true, servicio: "tratamiento", servicios: "tratamientos" };
+    expect(pintar({ vocab: estetica, rotuloPieza: null }).texto).toContain("Enviar a la clienta");
+  });
+
+  it("sin un celular al que WhatsApp llegue, dice por qué no se puede enviar", () => {
+    const { texto } = pintar({ telefono: "3344556" });
+    expect(texto).toContain("Para enviarlo, cargá un celular en su ficha.");
+  });
+
+  it("sin nada en el plan, dice dónde se carga", () => {
+    const { texto, html } = pintar({ filas: [] });
+    expect(texto).toContain("Todavía no hay tratamientos en el plan.");
+    expect(html).toContain('href="/patients/pat_1"');
+  });
+});
diff --git a/components/presupuesto/PresupuestoPorFases.tsx b/components/presupuesto/PresupuestoPorFases.tsx
new file mode 100644
index 00000000..e4713ce6
--- /dev/null
+++ b/components/presupuesto/PresupuestoPorFases.tsx
@@ -0,0 +1,225 @@
+"use client";
+
+// El armador del presupuesto por fases (2-oct, hueco #2 de dental en la
+// auditoría; lo #1 que copiar de Doctocliq). Desde el plan de tratamiento del
+// paciente: cada paso a una fase (o afuera), total por fase y total general con
+// los precios del catálogo, y dos salidas:
+//   - Imprimir: la hoja limpia de /print/presupuesto (con sesión).
+//   - Enviar al paciente: un link de solo lectura, firmado y con vencimiento,
+//     por WhatsApp (wa.me, sin la API de Meta). Lo arma el servidor con el
+//     precio del catálogo; acá solo se eligen las fases.
+//
+// Las fases no se guardan en la base (no hay columna; ver pendientes): viven en
+// esta pantalla, en la URL de imprimir y adentro del link que recibe el paciente.
+
+import Link from "next/link";
+import { useMemo, useState } from "react";
+
+import { Button } from "@/components/ui/button";
+import { buttonVariants } from "@/components/ui/button-variants";
+import { Card } from "@/components/ui/card";
+import { formatBs } from "@/lib/comercio/format";
+import { mensajeDeError } from "@/lib/http/mensaje-de-error";
+import { armarPresupuesto, codificarFases, FASES_MAX, fasesPorDefecto, PRESUPUESTO_VALIDEZ_DIAS } from "@/lib/presupuesto/fases";
+import { nombreDePila } from "@/lib/utils";
+import { numeroParaWhatsapp } from "@/lib/whatsapp/numero-para-enviar";
+
+export interface FilaDelArmador {
+  id: string;
+  nombre: string;
+  pieza: number | null;
+  centavos: number;
+  status: string;
+}
+
+const RESPALDO = "No se pudo armar el link. Probá de nuevo.";
+const SELECT =
+  "min-h-11 rounded-lg border border-outline-variant bg-surface px-3 text-sm font-semibold text-on-surface focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30";
+
+export function PresupuestoPorFases({
+  patientId,
+  nombre,
+  telefono,
+  negocio,
+  filas,
+  rotuloPieza,
+  vocab,
+}: {
+  patientId: string;
+  nombre: string;
+  telefono: string | null;
+  negocio: string;
+  /** El plan sin lo cancelado, con el precio del catálogo en centavos. */
+  filas: FilaDelArmador[];
+  /** «Diente» solo en el dental. */
+  rotuloPieza: string | null;
+  vocab: { cliente: string; clienteFemenino: boolean; servicio: string; servicios: string };
+}) {
+  const [faseDe, setFaseDe] = useState<Map<string, number>>(() => fasesPorDefecto(filas));
+  const [cantidadDeFases, setCantidadDeFases] = useState(() => Math.max(1, ...fasesPorDefecto(filas).values()));
+  const [enviando, setEnviando] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [link, setLink] = useState<string | null>(null);
+
+  const armado = useMemo(() => armarPresupuesto(filas, faseDe), [filas, faseDe]);
+  const whatsapp = numeroParaWhatsapp(telefono);
+  const alCliente = `${vocab.clienteFemenino ? "a la" : "al"} ${vocab.cliente}`;
+  const vacio = armado.fases.length === 0;
+  const imprimirHref = `/print/presupuesto/${patientId}?f=${encodeURIComponent(codificarFases(faseDe))}`;
+
+  function elegir(id: string, fase: number) {
+    setLink(null);
+    setFaseDe((antes) => {
+      const nuevo = new Map(antes);
+      if (fase === 0) nuevo.delete(id);
+      else nuevo.set(id, fase);
+      return nuevo;
+    });
+  }
+
+  async function enviar() {
+    if (!whatsapp || vacio || enviando) return;
+    // La ventana se abre YA, dentro del toque: abrirla después del fetch la
+    // bloquea el navegador del celular. Se llena cuando el link está listo.
+    const ventana = window.open("", "_blank");
+    if (ventana) ventana.opener = null;
+    setEnviando(true);
+    setError(null);
+    try {
+      const res = await fetch(`/api/patients/${patientId}/presupuesto`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ filas: [...faseDe.entries()].map(([id, fase]) => ({ id, fase })) }),
+      });
+      if (!res.ok) throw new Error(await mensajeDeError(res, RESPALDO));
+      const { url } = (await res.json()) as { url: string };
+      const texto = `Hola ${nombreDePila(nombre)}, le enviamos su presupuesto de ${negocio}: ${url}`;
+      const destino = `https://wa.me/${whatsapp}?text=${encodeURIComponent(texto)}`;
+      if (ventana) ventana.location.href = destino;
+      else window.location.href = destino;
+      setLink(url);
+    } catch (err) {
+      ventana?.close();
+      setError(err instanceof Error ? err.message : RESPALDO);
+    } finally {
+      setEnviando(false);
+    }
+  }
+
+  if (filas.length === 0) {
+    return (
+      <Card as="section" padding="none" className="p-4 md:p-6">
+        <p className="text-sm text-on-surface">Todavía no hay {vocab.servicios} en el plan.</p>
+        <Link href={`/patients/${patientId}`} className={`${buttonVariants({ variant: "secondary", size: "sm" })} mt-3`}>
+          Cargarlos en su ficha
+        </Link>
+      </Card>
+    );
+  }
+
+  return (
+    <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
+      <Card as="section" padding="none" aria-labelledby="pre-plan-h">
+        <div className="flex items-center justify-between gap-3 border-b border-outline-variant/40 px-4 py-4 md:px-6">
+          <h2 id="pre-plan-h" className="font-label text-on-surface-variant">
+            Plan de {vocab.servicio}
+          </h2>
+          {cantidadDeFases < FASES_MAX ? (
+            <button
+              type="button"
+              onClick={() => setCantidadDeFases((n) => Math.min(FASES_MAX, n + 1))}
+              className="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-primary"
+            >
+              <span className="material-symbols-outlined" style={{ fontSize: 18 }} aria-hidden="true">
+                add
+              </span>
+              Agregar fase
+            </button>
+          ) : null}
+        </div>
+        <ul className="divide-y divide-outline-variant/40">
+          {filas.map((fila) => (
+            <li key={fila.id} className="flex items-center justify-between gap-3 px-4 py-3 md:px-6">
+              <div className="min-w-0">
+                <p className="text-sm font-semibold text-on-surface">{fila.nombre}</p>
+                <p className="text-xs text-on-surface-variant tabular-nums">
+                  {rotuloPieza && fila.pieza ? `${rotuloPieza} ${fila.pieza} · ` : ""}
+                  {formatBs(fila.centavos / 100)}
+                </p>
+              </div>
+              <select
+                aria-label={`Fase de ${fila.nombre}`}
+                value={faseDe.get(fila.id) ?? 0}
+                onChange={(e) => elegir(fila.id, Number(e.target.value))}
+                className={SELECT}
+              >
+                {Array.from({ length: cantidadDeFases }, (_, i) => (
+                  <option key={i + 1} value={i + 1}>
+                    Fase {i + 1}
+                  </option>
+                ))}
+                <option value={0}>No incluir</option>
+              </select>
+            </li>
+          ))}
+        </ul>
+      </Card>
+
+      <Card as="section" variant="raised" padding="none" className="p-4 md:p-6" aria-labelledby="pre-total-h">
+        <h2 id="pre-total-h" className="font-label text-on-surface-variant">
+          Presupuesto
+        </h2>
+        {armado.fases.length > 1 ? (
+          <dl className="mt-3 space-y-1.5 text-sm">
+            {armado.fases.map((f) => (
+              <div key={f.numero} className="flex items-baseline justify-between gap-3">
+                <dt className="text-on-surface-variant">Fase {f.numero}</dt>
+                <dd className="font-semibold tabular-nums text-on-surface">{formatBs(f.totalCentavos / 100)}</dd>
+              </div>
+            ))}
+          </dl>
+        ) : null}
+        <p className="mt-3 flex items-baseline justify-between gap-3 border-t border-outline-variant/40 pt-3">
+          <span className="text-sm font-semibold text-on-surface">Total</span>
+          <span className="text-2xl font-semibold tabular-nums text-on-surface">{formatBs(armado.totalCentavos / 100)}</span>
+        </p>
+
+        <div className="mt-4 flex flex-col gap-2">
+          <Button
+            fullWidth
+            loading={enviando}
+            disabled={!whatsapp || vacio}
+            disabledReason={
+              vacio ? `Elegí al menos un ${vocab.servicio}.` : !whatsapp ? "Para enviarlo, cargá un celular en su ficha." : undefined
+            }
+            onClick={() => void enviar()}
+          >
+            <span className="material-symbols-outlined" aria-hidden="true">
+              send
+            </span>
+            Enviar {alCliente}
+          </Button>
+          {vacio ? null : (
+            <a href={imprimirHref} target="_blank" rel="noopener" className={`${buttonVariants({ variant: "secondary" })} w-full`}>
+              <span className="material-symbols-outlined" aria-hidden="true">
+                print
+              </span>
+              Imprimir
+            </a>
+          )}
+        </div>
+
+        {error ? (
+          <p role="alert" className="mt-3 rounded-lg border border-error px-3 py-2 text-xs text-error">
+            {error}
+          </p>
+        ) : null}
+        {link ? (
+          <p className="mt-3 break-all text-xs text-on-surface-variant" role="status">
+            Listo: se abrió WhatsApp con el link. Vale {PRESUPUESTO_VALIDEZ_DIAS} días. <a href={link} className="font-semibold text-primary underline" target="_blank" rel="noopener noreferrer">Ver lo que recibe</a>
+          </p>
+        ) : null}
+      </Card>
+    </div>
+  );
+}
