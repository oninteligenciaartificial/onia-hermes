+import { NextRequest } from "next/server";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+// El link del presupuesto (2-oct) lo abre el PACIENTE desde WhatsApp, sin
+// sesión. Si el proxy lo manda al login, el paciente ve la pantalla de entrar a
+// un sistema que no es suyo y el presupuesto nunca llega. El armador sí pide
+// sesión: vive en /patients/[id]/presupuesto.
+
+vi.mock("@supabase/ssr", () => ({
+  createServerClient: () => ({ auth: { getUser: async () => ({ data: { user: null } }) } }),
+}));
+
+async function pedir(ruta: string) {
+  const { proxy } = await import("@/proxy");
+  return proxy(new NextRequest(`http://127.0.0.1:3999${ruta}`, { method: "GET" }));
+}
+
+describe("presupuesto sin sesión", () => {
+  beforeEach(() => {
+    process.env.NEXT_PUBLIC_SUPABASE_URL = "https://ejemplo.supabase.co";
+    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon-de-prueba";
+  });
+
+  it("el link público no redirige al login", async () => {
+    const res = await pedir("/presupuesto/eyJrIjoicHJlc3VwdWVzdG8ifQ.firma");
+    expect(res.headers.get("location") ?? "").not.toContain("/login");
+  });
+
+  it("el armador de la ficha sí pide sesión", async () => {
+    const res = await pedir("/patients/pat_1/presupuesto");
+    expect(res.status).toBe(307);
+    expect(res.headers.get("location")).toContain("/login");
+  });
+});
