+import { notFound, redirect } from "next/navigation";
+
+import { ArmadorDePresupuesto } from "@/components/presupuesto/ArmadorDePresupuesto";
+import { hasPermissionForProfile } from "@/lib/onia-core/access-control";
+import { vocabularioDeTrack } from "@/lib/onboarding/vocabulario";
+import { resolveVerticalPack, tieneOdontograma } from "@/lib/platform/vertical-pack";
+import { prisma } from "@/lib/prisma";
+import { centavosDe, presupuestoEnRubro } from "@/lib/presupuesto/fases";
+import { createClient } from "@/lib/supabase/server";
+
+// Presupuesto por fases (2-oct, hueco #2 de dental en la auditoría): el plan de
+// tratamiento del paciente agrupado en fases, con los precios del catálogo, para
+// imprimir o mandárselo por WhatsApp. Solo dental y estética, con clinical.read
+// (nombra tratamientos). Todo por organizationId.
+export default async function PresupuestoPage({ params }: { params: Promise<{ id: string }> }) {
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) redirect("/login");
+  const profile = await prisma.profile.findUnique({ where: { userId: user.id } });
+  if (!profile) redirect("/login");
+
+  if (!(await hasPermissionForProfile(profile, "clinical.read"))) notFound();
+  const organizacion = await prisma.organization.findUnique({
+    where: { id: profile.organizationId },
+    select: { name: true, verticalTrackId: true },
+  });
+  const trackId = resolveVerticalPack(organizacion?.verticalTrackId ?? "").trackId;
+  if (!presupuestoEnRubro(trackId)) notFound();
+
+  const { id } = await params;
+  const patient = await prisma.patient.findFirst({
+    where: { id, organizationId: profile.organizationId },
+    select: { id: true, name: true, phone: true },
+  });
+  if (!patient) notFound();
+
+  const plan = await prisma.patientTreatment.findMany({
+    where: { organizationId: profile.organizationId, patientId: patient.id, status: { not: "CANCELADO" } },
+    orderBy: { date: "asc" },
+    select: { id: true, status: true, toothNumber: true, treatment: { select: { name: true, price: true } } },
+  });
+  const esDental = tieneOdontograma(trackId);
+  const v = vocabularioDeTrack(trackId);
+
+  return (
+    <ArmadorDePresupuesto
+      patientId={patient.id}
+      nombre={patient.name}
+      telefono={patient.phone}
+      negocio={organizacion?.name ?? ""}
+      filas={plan.map((f) => ({
+        id: f.id,
+        nombre: f.treatment.name,
+        pieza: esDental ? f.toothNumber : null,
+        centavos: centavosDe(f.treatment.price),
+        status: f.status,
+      }))}
+      rotuloPieza={esDental ? "Diente" : null}
+      vocab={{ cliente: v.cliente, clienteFemenino: v.clienteFemenino, servicio: v.servicio, servicios: v.servicios }}
+    />
+  );
+}
