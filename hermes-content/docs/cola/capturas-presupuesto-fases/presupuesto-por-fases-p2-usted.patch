@@ -0,0 +1,143 @@
+// Banco del presupuesto por fases SIN base — SOLO en desarrollo (404 en prod).
+//
+//   /dev/presupuesto?rubro=dental | estetica            el armador, dentro del shell
+//   /dev/presupuesto?vista=hoja&rubro=dental            la hoja que recibe el paciente
+//   &fases=2      la hoja con dos fases (por defecto, una)
+//   &tel=fijo     sin celular: «Enviar» dice por qué no
+//   &tema=oscuro
+
+import { notFound } from "next/navigation";
+
+import { ESTILOS_COMPROBANTE } from "@/app/print/estilos";
+import { ESTILOS_PRESUPUESTO, PresupuestoVista } from "@/app/print/presupuesto/PresupuestoVista";
+import { LayoutShell } from "@/components/layout/LayoutShell";
+import type { NavigationItem } from "@/components/layout/navigation";
+import { ArmadorDePresupuesto } from "@/components/presupuesto/ArmadorDePresupuesto";
+import { ThemeProvider } from "@/components/theme/ThemeProvider";
+import { vocabularioDeTrack } from "@/lib/onboarding/vocabulario";
+import { AccountContextProvider } from "@/lib/platform/client";
+import type { AccountContextValue, VerticalTrackId } from "@/lib/platform/types";
+import { getNavForPack, resolveVerticalPack, tieneOdontograma } from "@/lib/platform/vertical-pack";
+import { armarPresupuesto, PRESUPUESTO_VALIDEZ_DIAS } from "@/lib/presupuesto/fases";
+
+const AHORA = new Date("2026-10-02T14:00:00.000Z");
+
+const RUBROS: Record<string, { track: VerticalTrackId; negocio: string; persona: string; plan: [string, number | null, number, string][] }> = {
+  dental: {
+    track: "dentagest-clinical",
+    negocio: "Clínica Dental Aramayo",
+    persona: "Lucía Mendoza Rivero",
+    plan: [
+      ["Limpieza dental", null, 15_000, "COMPLETADO"],
+      ["Endodoncia", 36, 80_000, "EN_PROGRESO"],
+      ["Corona de porcelana", 36, 120_000, "PENDIENTE"],
+      ["Resina compuesta", 24, 25_000, "PENDIENTE"],
+      ["Blanqueamiento", null, 90_000, "PENDIENTE"],
+    ],
+  },
+  estetica: {
+    track: "esteticagest-clinical",
+    negocio: "Estética Valeria Spa",
+    persona: "Gabriela Méndez",
+    plan: [
+      ["Limpieza facial profunda", null, 25_000, "COMPLETADO"],
+      ["Depilación láser, 6 sesiones", null, 180_000, "EN_PROGRESO"],
+      ["Peeling químico", null, 40_000, "PENDIENTE"],
+    ],
+  },
+};
+
+export default async function BancoPresupuesto({
+  searchParams,
+}: {
+  searchParams: Promise<{ rubro?: string; vista?: string; fases?: string; tel?: string; tema?: string }>;
+}) {
+  if (process.env.NODE_ENV === "production") notFound();
+  const q = await searchParams;
+  const rubro = q.rubro && q.rubro in RUBROS ? q.rubro : "dental";
+  const { track, negocio, persona, plan } = RUBROS[rubro];
+  const pack = resolveVerticalPack(track);
+  const esDental = tieneOdontograma(pack.trackId);
+  const filas = plan.map(([nombre, pieza, centavos, status], i) => ({
+    id: `pt_${i}`,
+    nombre,
+    pieza: esDental ? pieza : null,
+    centavos,
+    status,
+  }));
+
+  if (q.vista === "hoja") {
+    // Una fase, o dos (lo pendiente en la segunda) con &fases=2.
+    const fases = new Map(
+      filas
+        .filter((f) => f.status !== "COMPLETADO")
+        .map((f, i) => [f.id, q.fases === "2" && i >= 2 ? 2 : 1] as [string, number]),
+    );
+    return (
+      <>
+        <style>{ESTILOS_COMPROBANTE + ESTILOS_PRESUPUESTO}</style>
+        <PresupuestoVista
+          emisor={{ name: negocio, address: "Av. Busch 123, Santa Cruz", phone: "33445566", nit: "1023456028" }}
+          para={persona}
+          rotuloPieza={esDental ? "Diente" : null}
+          emitidoEl={AHORA}
+          venceEl={new Date(AHORA.getTime() + PRESUPUESTO_VALIDEZ_DIAS * 86_400_000)}
+          timeZone="America/La_Paz"
+          armado={armarPresupuesto(filas, fases)}
+        />
+      </>
+    );
+  }
+
+  const account: AccountContextValue = {
+    organizationId: "dev-presupuesto",
+    verticalTrackId: pack.trackId,
+    plan: "professional",
+    countryCode: "BO",
+    currencyCode: "BOB",
+    features: pack.includedFeatures,
+    roleKeys: pack.roleKeys,
+    baseRole: "ADMIN",
+  };
+  const navItems = getNavForPack(pack, {
+    organizationId: account.organizationId,
+    verticalTrackId: pack.trackId,
+    plan: account.plan,
+    countryCode: account.countryCode,
+    currencyCode: account.currencyCode,
+    features: new Set(pack.includedFeatures),
+    roleKeys: pack.roleKeys,
+    baseRole: account.baseRole,
+  }) as NavigationItem[];
+  const v = vocabularioDeTrack(pack.trackId);
+
+  return (
+    <ThemeProvider initialTheme={q.tema === "oscuro" ? "dark" : "light"}>
+      <AccountContextProvider value={account}>
+        <LayoutShell
+          esCliente={true}
+          clinicName={negocio}
+          doctorName=""
+          role="ADMIN"
+          plan="professional"
+          planNombre="Profesional"
+          diasDePrueba={9}
+          decisionesPendientes={0}
+          navItems={navItems}
+          bottomHrefs={pack.bottomNavHrefs}
+          quickActions={pack.quickActions as NavigationItem[]}
+        >
+          <ArmadorDePresupuesto
+            patientId="pat_demo"
+            nombre={persona}
+            telefono={q.tel === "fijo" ? "3344556" : "71234567"}
+            negocio={negocio}
+            filas={filas}
+            rotuloPieza={esDental ? "Diente" : null}
+            vocab={{ cliente: v.cliente, clienteFemenino: v.clienteFemenino, servicio: v.servicio, servicios: v.servicios }}
+          />
+        </LayoutShell>
+      </AccountContextProvider>
+    </ThemeProvider>
+  );
+}
diff --git a/app/print/presupuesto/PresupuestoVista.render.test.ts b/app/print/presupuesto/PresupuestoVista.render.test.ts
