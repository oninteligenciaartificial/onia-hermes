+  it("si el negocio dejó de ser dental o estética: null", async () => {
+    prismaMocks.organization.findUnique.mockResolvedValue({ name: "X", verticalTrackId: "vetgest-clinical" });
+    expect(await cargarPresupuestoPublico(token, AHORA)).toBeNull();
+  });
+
+  it("si se borraron o cancelaron todos los pasos: null; si queda uno, solo ese", async () => {
+    prismaMocks.patientTreatment.findMany.mockResolvedValue([]);
+    expect(await cargarPresupuestoPublico(token, AHORA)).toBeNull();
+    prismaMocks.patientTreatment.findMany.mockResolvedValue([{ id: "pt_a", toothNumber: null, treatment: { name: "Endodoncia" } }]);
+    expect((await cargarPresupuestoPublico(token, AHORA))?.armado.totalCentavos).toBe(80_000);
+  });
+
+  // Auditoría del 2-oct: con el celular mal escrito, el link le llegaba a un
+  // desconocido y no había forma de cortarlo durante 30 días. El link vale para
+  // el celular que tenía la ficha al armarlo: corregirlo lo anula.
+  it("corregir el celular en la ficha anula el link mandado al número equivocado", async () => {
