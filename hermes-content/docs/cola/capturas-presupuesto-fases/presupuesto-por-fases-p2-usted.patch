+
+export function ArmadorDePresupuesto({
+  patientId,
+  nombre,
+  telefono,
+  negocio,
+  filas,
+  rotuloPieza,
+  vocab,
+}: {
+  patientId: string;
+  nombre: string;
+  telefono: string | null;
+  negocio: string;
