@@ -0,0 +1,149 @@
+// La HOJA del presupuesto por fases (2-oct): lo que el paciente abre desde
+// WhatsApp (/presupuesto/[token]) y lo que se imprime (/print/presupuesto). Una
+// sola pieza para las dos: lo que se imprime es lo que recibe. Sin sesión ni
+// base, para que se pueda mirar con datos de ejemplo. Reusa las clases del
+// comprobante (app/print/estilos.ts): mismo encabezado del negocio, mismas
+// cajas, misma tabla, y en el celular las columnas se apilan.
+
+import { formatBs } from "@/lib/comercio/format";
+import { LEYENDA_SIN_VALOR_FISCAL } from "@/lib/cobros";
+import type { PresupuestoArmado } from "@/lib/presupuesto/fases";
+
+import type { EmisorRecibo } from "../recibo-venta/ReciboVentaVista";
+
+export const ESTILOS_PRESUPUESTO = `
+        .pre-doc .inv-table td.r, .pre-doc .inv-table th.r { white-space: nowrap; }
+        .pre-fase { margin: 4px 0 8px; font-size: 13px; font-weight: 600; color: #141A17; }
+        .pre-doc section + section { margin-top: 22px; }
+        .pre-pieza { display: block; margin-top: 2px; font-size: 12px; color: #69716D; }
+        .pre-subtotal td { background: #F7F9F8; font-weight: 600; }
+        .pre-nota { margin-top: 18px; font-size: 12px; color: #424A46; line-height: 1.6; }
+        @media screen and (max-width: 640px) {
+          .pre-doc { margin: 0 auto; border-radius: 0; box-shadow: none; }
+          .pre-doc .inv-header { flex-direction: column; gap: 12px; padding: 20px; }
+          .pre-doc .inv-title-right { text-align: left; }
+          .pre-doc .inv-body { padding: 20px; }
+          .pre-doc .inv-meta-grid { grid-template-columns: 1fr; gap: 16px; }
+          .pre-doc .inv-table th, .pre-doc .inv-table td { padding: 10px; }
+          .pre-doc .inv-total-final { gap: 16px; padding: 12px 10px; }
+          .pre-doc .inv-footer { padding: 14px 20px; }
+        }
+`;
+
+export function PresupuestoVista({
+  emisor,
+  para,
+  rotuloPieza,
+  emitidoEl,
+  venceEl,
+  timeZone,
+  armado,
+}: {
+  emisor: EmisorRecibo;
+  /** Nombre de la persona a la que va el presupuesto. */
+  para: string;
+  /** «Diente» en el dental; null en los demás rubros. */
+  rotuloPieza: string | null;
+  emitidoEl: Date;
+  venceEl: Date;
+  timeZone: string;
+  armado: PresupuestoArmado;
+}) {
+  const fecha = new Intl.DateTimeFormat("es-BO", { day: "numeric", month: "long", year: "numeric", timeZone });
+  const variasFases = armado.fases.length > 1;
+
+  return (
+    <div className="invoice-page pre-doc">
+      <div className="inv-header">
+        <div>
+          <div className="inv-clinic-name">{emisor.name}</div>
+          <div className="inv-clinic-meta">
+            {emisor.address && <div>{emisor.address}</div>}
+            {emisor.phone && <div>{emisor.phone}</div>}
+            {emisor.email && <div>{emisor.email}</div>}
+            {emisor.nit && <div className="inv-nit-badge">NIT: {emisor.nit}</div>}
+          </div>
+        </div>
+        <div className="inv-title-right">
+          <h1>PRESUPUESTO</h1>
+        </div>
+      </div>
+
+      <div className="inv-body">
+        <div className="inv-meta-grid">
+          <div className="inv-meta-box">
+            <h4>Para</h4>
+            <div className="inv-patient-name">{para}</div>
+          </div>
+          <div className="inv-meta-box">
+            <h4>Fechas</h4>
+            <div className="inv-dates">
+              <div>
+                <div className="inv-date-label">Emitido</div>
+                <div className="inv-date-value">{fecha.format(emitidoEl)}</div>
+              </div>
+              <div>
+                <div className="inv-date-label">Válido hasta</div>
+                <div className="inv-date-value">{fecha.format(venceEl)}</div>
+              </div>
+            </div>
+          </div>
+        </div>
+
+        {armado.fases.map((fase) => (
+          <section key={fase.numero} aria-label={variasFases ? `Fase ${fase.numero}` : undefined}>
+            {variasFases ? <h2 className="pre-fase">Fase {fase.numero}</h2> : null}
+            <div className="inv-table-wrap">
+              <table className="inv-table">
+                <thead>
+                  <tr>
+                    <th>Tratamiento</th>
+                    <th className="r">Precio</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {fase.filas.map((fila) => (
+                    <tr key={fila.id}>
+                      <td>
+                        {fila.nombre}
+                        {/* Dos columnas en todo ancho: una columna que se esconde en el
+                            celular dejaba la del subtotal (colSpan) como un hueco gris. */}
+                        {rotuloPieza && fila.pieza ? (
+                          <span className="pre-pieza">
+                            {rotuloPieza} {fila.pieza}
+                          </span>
+                        ) : null}
+                      </td>
+                      <td className="r b">{formatBs(fila.centavos / 100)}</td>
+                    </tr>
+                  ))}
+                  {variasFases ? (
+                    <tr className="pre-subtotal">
+                      <td>Total fase {fase.numero}</td>
+                      <td className="r">{formatBs(fase.totalCentavos / 100)}</td>
+                    </tr>
+                  ) : null}
+                </tbody>
+              </table>
+            </div>
+          </section>
+        ))}
+
+        <div className="inv-total-final">
+          <span className="lbl">TOTAL</span>
+          <span className="val">{formatBs(armado.totalCentavos / 100)}</span>
+        </div>
+
+        <p className="pre-nota">
+          Precios en bolivianos. Pasado el {fecha.format(venceEl)}, los precios se vuelven a confirmar.
+        </p>
+      </div>
+
+      <div className="inv-footer">
+        {emisor.name}
+        {emisor.nit && ` · NIT ${emisor.nit}`}
+        <div className="inv-sin-notice">Presupuesto, no es factura. {LEYENDA_SIN_VALOR_FISCAL}</div>
+      </div>
+    </div>
+  );
+}
diff --git a/app/print/presupuesto/[patientId]/page.tsx b/app/print/presupuesto/[patientId]/page.tsx
