+    expect(await cargarPresupuestoPublico(alEquivocado, AHORA)).toBeNull();
+    // El mismo celular escrito de otra forma no lo anula.
+    prismaMocks.patient.findFirst.mockResolvedValue({ name: "Lucía Mendoza", phone: "+591 712 34567" });
+    expect(await cargarPresupuestoPublico(token, AHORA)).not.toBeNull();
+  });
+
+  it("la consulta de la persona trae su celular de hoy", async () => {
+    await cargarPresupuestoPublico(token, AHORA);
+    expect(prismaMocks.patient.findFirst.mock.calls[0][0].select).toEqual({ name: true, phone: true });
+  });
+
+  it("estética: sin diente", async () => {
+    prismaMocks.organization.findUnique.mockResolvedValue({ name: "Estética", verticalTrackId: "esteticagest-clinical" });
+    expect((await cargarPresupuestoPublico(token, AHORA))?.rotuloPieza).toBeNull();
