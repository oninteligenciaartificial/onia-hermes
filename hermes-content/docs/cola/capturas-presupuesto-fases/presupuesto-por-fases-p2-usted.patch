+// Token del link público del presupuesto (2-oct).
+//
+// Stateless, como el del portal (lib/onia-core/portal-token.ts): HMAC-SHA256
+// sobre {negocio, persona, filas [id, fase, centavos], emisión, vencimiento}, sin
+// tabla ni migración. El paciente lo abre sin sesión desde WhatsApp.
+//
+// - No adivinable: la firma usa el secreto del servidor (PORTAL_TOKEN_SECRET o
+//   ENCRYPTION_KEY, que producción ya exige).
+// - No se cruza con el portal: la clave se DERIVA con un propósito propio, así un
+//   token del portal (mismo secreto de base, mismas claves o/p/e) no abre un
+//   presupuesto y uno de presupuesto no abre el portal.
+// - Vence a los PRESUPUESTO_VALIDEZ_DIAS: es lo que dura un precio pasado.
+// - Lleva el PRECIO congelado (centavos): el presupuesto que recibió el paciente
+//   no cambia si mañana se toca el catálogo. Los nombres no viajan: se leen de la
+//   base, del negocio y la persona del token.
+//
+// - Atado al CELULAR (auditoría del 2-oct): stateless no se revoca, y con el
+//   número mal escrito «Enviar al paciente» le mandaba a un desconocido nombre,
+//   tratamientos, piezas y montos por 30 días. El token lleva la HUELLA del
+//   celular de la ficha (HMAC con la clave del servidor: no se puede sacar el
+//   número del link probando celulares) y la carga la compara con el de hoy.
+//   Corregir el número en la ficha anula los links mandados al equivocado.
+//
+// ponytail: no corta un link que el paciente correcto reenvió, ni el caso en que
+// nadie corrige el número. Para anularlo por otras causas, un salt por persona
+// (columna) sumado al HMAC — ver pendientes del carril.
+
+import { createHmac, timingSafeEqual } from "crypto";
+
+import { numeroParaWhatsapp } from "@/lib/whatsapp/numero-para-enviar";
+
+import { FASES_MAX, PRESUPUESTO_VALIDEZ_DIAS } from "./fases";
+
+export { PRESUPUESTO_VALIDEZ_DIAS };
+const PROPOSITO = "onia:presupuesto:v1";
+const MAX_FILAS = 60;
+
+export interface FilaFirmada {
+  id: string;
+  fase: number;
+  centavos: number;
+}
+
+export interface PresupuestoFirmado {
+  organizationId: string;
+  patientId: string;
+  filas: FilaFirmada[];
+  /** huellaDelTelefono() del celular de la ficha al armar el link. */
+  huellaTelefono: string;
+  emitidoEl: Date;
+  venceEl: Date;
+}
+
+function clave(): Buffer {
+  const s = process.env.PORTAL_TOKEN_SECRET || process.env.ENCRYPTION_KEY;
+  if (!s) throw new Error("Falta PORTAL_TOKEN_SECRET o ENCRYPTION_KEY para firmar el presupuesto");
+  return createHmac("sha256", s).update(PROPOSITO).digest();
+}
+
+const firmar = (carga: string) => createHmac("sha256", clave()).update(carga).digest("base64url");
+
+/**
+ * Huella del celular, con la clave del servidor. Normalizado como lo usa el envío
+ * (numeroParaWhatsapp: «70012345» y «+591 700 12345» son el mismo); si no es un
+ * celular, sus dígitos. El prefijo «tel:» no aparece en una carga base64url: las
+ * dos firmas no se cruzan.
+ */
+export function huellaDelTelefono(telefono: string | null | undefined): string {
+  const numero = numeroParaWhatsapp(telefono) ?? (telefono ?? "").replace(/\D/g, "");
+  return createHmac("sha256", clave()).update(`tel:${numero}`).digest("base64url").slice(0, 22);
+}
+
+export function firmarPresupuestoToken(args: {
+  organizationId: string;
+  patientId: string;
+  filas: readonly FilaFirmada[];
+  /** Patient.phone al armar el link: vale para ese número. */
+  telefono: string | null;
+  ahora?: Date;
+}): string {
+  const ahora = args.ahora ?? new Date();
+  const i = Math.floor(ahora.getTime() / 1000);
+  const payload = {
+    k: "presupuesto",
+    o: args.organizationId,
+    p: args.patientId,
+    f: args.filas.map((f) => [f.id, f.fase, f.centavos]),
+    t: huellaDelTelefono(args.telefono),
+    i,
+    e: i + PRESUPUESTO_VALIDEZ_DIAS * 86_400,
+  };
+  const carga = Buffer.from(JSON.stringify(payload), "utf8").toString("base64url");
+  return `${carga}.${firmar(carga)}`;
+}
+
+function filaValida(x: unknown): x is [string, number, number] {
+  return (
+    Array.isArray(x) &&
+    x.length === 3 &&
+    typeof x[0] === "string" &&
+    /^[A-Za-z0-9_-]{1,64}$/.test(x[0]) &&
+    Number.isInteger(x[1]) &&
+    x[1] >= 1 &&
+    x[1] <= FASES_MAX &&
+    Number.isInteger(x[2]) &&
+    x[2] >= 0 &&
+    x[2] <= 10_000_000_000
+  );
+}
+
+export function verificarPresupuestoToken(token: string, ahora: Date = new Date()): PresupuestoFirmado | null {
+  if (!token || typeof token !== "string" || token.length > 8000) return null;
+  const partes = token.split(".");
+  if (partes.length !== 2) return null;
+  const [carga, firma] = partes;
+  const a = Buffer.from(firma);
+  const b = Buffer.from(firmar(carga));
+  if (a.length !== b.length || !timingSafeEqual(a, b)) return null;
+  try {
+    const p = JSON.parse(Buffer.from(carga, "base64url").toString("utf8")) as Record<string, unknown>;
+    if (p.k !== "presupuesto" || typeof p.o !== "string" || typeof p.p !== "string") return null;
+    if (typeof p.i !== "number" || typeof p.e !== "number" || !Array.isArray(p.f)) return null;
+    if (typeof p.t !== "string" || p.t.length === 0) return null;
+    if (p.f.length === 0 || p.f.length > MAX_FILAS || !p.f.every(filaValida)) return null;
+    if (p.e * 1000 < ahora.getTime()) return null;
+    return {
+      organizationId: p.o,
+      patientId: p.p,
+      filas: (p.f as [string, number, number][]).map(([id, fase, centavos]) => ({ id, fase, centavos })),
+      huellaTelefono: p.t,
+      emitidoEl: new Date(p.i * 1000),
+      venceEl: new Date(p.e * 1000),
+    };
+  } catch {
+    return null;
+  }
+}
