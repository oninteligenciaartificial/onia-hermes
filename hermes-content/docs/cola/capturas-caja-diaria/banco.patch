 =?UTF-8?q?a=20para=20el=20OK=20de=20dise=C3=B1o?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

La caja no tenía banco: sólo se podía ver con sesión y base. /dev/caja-diaria monta el CajaDiariaClient real dentro del shell y responde /api/caja-diaria en el navegador con la misma forma y el mismo cálculo (resumenCajaDiaria): ?estado=sin-abrir|abierta|cerrada y ?rol=dueno|recepcion (recepción no recibe esperado ni descuadre, como la API). Producción no cambia.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HhnFgkeF6nLGvjrfjt1o2C
---
 app/dev/caja-diaria/BancoCajaDiaria.tsx | 99 +++++++++++++++++++++++++
 app/dev/caja-diaria/page.tsx            | 79 ++++++++++++++++++++
 2 files changed, 178 insertions(+)
 create mode 100644 app/dev/caja-diaria/BancoCajaDiaria.tsx
 create mode 100644 app/dev/caja-diaria/page.tsx

diff --git a/app/dev/caja-diaria/BancoCajaDiaria.tsx b/app/dev/caja-diaria/BancoCajaDiaria.tsx
new file mode 100644
index 00000000..364f42b3
--- /dev/null
+++ b/app/dev/caja-diaria/BancoCajaDiaria.tsx
@@ -0,0 +1,99 @@
+"use client";
+
+// Banco de la caja diaria SIN base. Responde en el navegador lo que respondería
+// GET/POST /api/caja-diaria, con la misma forma y el mismo cálculo
+// (`resumenCajaDiaria`), así el componente de producción se monta SIN cambios.
+//   estado: sin-abrir | abierta | cerrada     rol: dueno | recepcion
+// El dueño ve esperado y descuadre; recepción NO (igual que la API real:
+// efectivoEsperado, descuadre y cierre llegan en null).
+// Los cambios (abrir, egreso, cerrar) viven sólo en esta pestaña.
+
+import { useEffect, useState, type ReactNode } from "react";
+
+import { resumenCajaDiaria } from "@/lib/caja-diaria";
+
+export type EstadoBanco = "sin-abrir" | "abierta" | "cerrada";
+export type RolBanco = "dueno" | "recepcion";
+
+const CAMILA = { id: "u_camila", nombre: "Camila Rojas" };
+const ANA = { id: "u_ana", nombre: "Dra. Ana Aramayo" };
+const dia = "2026-10-08";
+const a = (hora: string) => `${dia}T${hora}:00-04:00`;
+
+const COBROS = [
+  { amount: 150, method: "EFECTIVO", userId: CAMILA.id, cobradoPor: CAMILA.nombre, paidAt: a("09:10") },
+  { amount: 200, method: "QR", userId: ANA.id, cobradoPor: ANA.nombre, paidAt: a("10:25") },
+  { amount: 120, method: "TARJETA", userId: CAMILA.id, cobradoPor: CAMILA.nombre, paidAt: a("11:40") },
+  { amount: 80, method: "TRANSFERENCIA", userId: ANA.id, cobradoPor: ANA.nombre, paidAt: a("12:05") },
+];
+
+type Egreso = { id: string; amount: number; reason: string; createdByUserId: string; creadoPor: string; createdAt: string };
+type Sim = {
+  abierta: boolean;
+  cerrada: boolean;
+  fondo: number;
+  cobros: typeof COBROS;
+  egresos: Egreso[];
+  contado: number | null;
+  notas: string | null;
+};
+
+function inicial(estado: EstadoBanco): Sim {
+  if (estado === "sin-abrir") return { abierta: false, cerrada: false, fondo: 0, cobros: [], egresos: [], contado: null, notas: null };
+  const taxi: Egreso = { id: "e1", amount: 20, reason: "Taxi", createdByUserId: CAMILA.id, creadoPor: CAMILA.nombre, createdAt: a("13:00") };
+  const base: Sim = { abierta: true, cerrada: false, fondo: 100, cobros: COBROS, egresos: [taxi], contado: null, notas: null };
+  // Cerrada con descuadre de −Bs 5: esperado 230 (100 + 150 − 20), contado 225.
+  return estado === "cerrada" ? { ...base, cerrada: true, contado: 225, notas: "Falta un billete de Bs 5; se revisa mañana." } : base;
+}
+
+function leer(sim: Sim, rol: RolBanco) {
+  const ver = rol === "dueno";
+  const base = resumenCajaDiaria({
+    fondoInicial: sim.fondo,
+    cobros: sim.cobros.map((c) => ({ amount: c.amount, method: c.method, userId: c.userId })),
+    egresos: sim.egresos.map((e) => ({ amount: e.amount })),
+    efectivoContado: ver ? sim.contado : null,
+  });
+  return {
+    date: `${dia}T04:00:00.000Z`,
+    canOperate: true,
+    canViewClose: ver,
+    session: sim.abierta
+      ? { id: "banco", openingFund: sim.fondo, openedAt: a("08:30"), openedByUserId: CAMILA.id, openedBy: CAMILA.nombre, closedAt: sim.cerrada ? a("18:00") : null }
+      : null,
+    resumen: { ...base, efectivoContado: ver ? sim.contado : null, efectivoEsperado: ver ? base.efectivoEsperado : null, descuadre: ver ? base.descuadre : null },
+    cobros: sim.cobros,
+    egresos: sim.egresos,
+    cierre: sim.cerrada && ver
+      ? { closedAt: a("18:00"), closedByUserId: CAMILA.id, countedCash: sim.contado ?? 0, expectedCash: base.efectivoEsperado, cashDifference: base.descuadre ?? 0, notes: sim.notas }
+      : null,
+  };
+}
+
+export function BancoCajaDiaria({ estado, rol, children }: { estado: EstadoBanco; rol: RolBanco; children: ReactNode }) {
+  const [listo, setListo] = useState(false);
+
+  useEffect(() => {
+    // Se instala ANTES de montar la caja (ella pide los datos al montarse) y se
+    // restaura al desmontar. Sólo toca /api/caja-diaria.
+    const original = window.fetch;
+    let sim = inicial(estado);
+    window.fetch = async (input, init) => {
+      const raw = typeof input === "string" ? input : input instanceof Request ? input.url : input.href;
+      const url = new URL(raw, window.location.origin);
+      if (url.origin !== window.location.origin || url.pathname !== "/api/caja-diaria") return original(input, init);
+      if (init?.method !== "POST") return Response.json(leer(sim, rol));
+      const body = JSON.parse(String(init.body));
+      if (body.action === "open") sim = { ...sim, abierta: true, fondo: body.openingFund };
+      if (body.action === "expense") {
+        sim = { ...sim, egresos: [...sim.egresos, { id: `e${sim.egresos.length + 1}`, amount: body.amount, reason: body.reason, createdByUserId: CAMILA.id, creadoPor: CAMILA.nombre, createdAt: a("14:00") }] };
+      }
+      if (body.action === "close") sim = { ...sim, cerrada: true, contado: body.countedCash, notas: body.notes ?? null };
+      return Response.json({ ok: true });
+    };
+    setListo(true);
+    return () => { window.fetch = original; };
+  }, [estado, rol]);
+
+  return listo ? <>{children}</> : null;
+}
