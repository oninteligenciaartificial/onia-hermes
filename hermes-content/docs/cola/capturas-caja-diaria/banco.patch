@@ -0,0 +1,79 @@
+// Banco de la caja diaria SIN base — SOLO en desarrollo (404 en prod).
+//
+// Monta el MISMO componente de /caja-diaria (`CajaDiariaClient`) dentro del
+// shell real, con datos de ejemplo que responde `BancoCajaDiaria` en el
+// navegador. Sirve para MIRAR la caja a 390 y 1440 sin sesión ni base.
+//
+// Uso: npm run dev -> http://localhost:3000/dev/caja-diaria
+//      ?estado=sin-abrir | abierta | cerrada     (por defecto: abierta)
+//      &rol=dueno | recepcion                    (por defecto: dueno; recepción no ve el esperado)
+//      &tema=oscuro                              (modo oscuro)
+//   abierta: fondo Bs 100, 4 cobros (efectivo, QR, tarjeta, transferencia; dos personas)
+//            y un egreso «Taxi» de Bs 20.  cerrada: descuadre de −Bs 5.
+
+import { notFound } from "next/navigation";
+
+import { CajaDiariaClient } from "@/app/(dashboard)/caja-diaria/CajaDiariaClient";
+import { LayoutShell } from "@/components/layout/LayoutShell";
+import type { NavigationItem } from "@/components/layout/navigation";
+import { ThemeProvider } from "@/components/theme/ThemeProvider";
+import { vocabularioDeTrack } from "@/lib/onboarding/vocabulario";
+import { AccountContextProvider } from "@/lib/platform/client";
+import type { AccountContextValue } from "@/lib/platform/types";
+import { getNavForPack, resolveVerticalPack } from "@/lib/platform/vertical-pack";
+import { BancoCajaDiaria, type EstadoBanco, type RolBanco } from "./BancoCajaDiaria";
+
+const ESTADOS: EstadoBanco[] = ["sin-abrir", "abierta", "cerrada"];
+
+export default async function BancoDeCajaDiaria({ searchParams }: { searchParams: Promise<{ estado?: string; rol?: string; tema?: string }> }) {
+  if (process.env.NODE_ENV === "production") notFound();
+
+  const { estado, rol, tema } = await searchParams;
+  const estadoElegido = ESTADOS.find((e) => e === estado) ?? "abierta";
+  const rolElegido: RolBanco = rol === "recepcion" ? "recepcion" : "dueno";
+  const pack = resolveVerticalPack("dentagest-clinical");
+  const account: AccountContextValue = {
+    organizationId: "dev-caja-diaria",
+    verticalTrackId: pack.trackId,
+    plan: "professional",
+    countryCode: "BO",
+    currencyCode: "BOB",
+    features: pack.includedFeatures,
+    roleKeys: pack.roleKeys,
+    baseRole: rolElegido === "dueno" ? "ADMIN" : "STAFF",
+  };
+  const navItems = getNavForPack(pack, {
+    organizationId: account.organizationId,
+    verticalTrackId: pack.trackId,
+    plan: account.plan,
+    countryCode: account.countryCode,
+    currencyCode: account.currencyCode,
+    features: new Set(pack.includedFeatures),
+    roleKeys: pack.roleKeys,
+    baseRole: account.baseRole,
+  }) as NavigationItem[];
+
+  return (
+    <ThemeProvider initialTheme={tema === "oscuro" ? "dark" : "light"}>
+      <AccountContextProvider value={account}>
+        <LayoutShell
+          esCliente={true}
+          clinicName="Clínica Aramayo"
+          doctorName={rolElegido === "dueno" ? "Dra. Ana Aramayo" : "Camila Rojas"}
+          role={account.baseRole}
+          plan="professional"
+          planNombre="Profesional"
+          diasDePrueba={5}
+          decisionesPendientes={0}
+          navItems={navItems}
+          bottomHrefs={pack.bottomNavHrefs}
+          quickActions={pack.quickActions as NavigationItem[]}
+        >
+          <BancoCajaDiaria key={`${estadoElegido}-${rolElegido}`} estado={estadoElegido} rol={rolElegido}>
+            <CajaDiariaClient vocabulario={{ negocio: vocabularioDeTrack(pack.trackId).negocio }} />
+          </BancoCajaDiaria>
+        </LayoutShell>
+      </AccountContextProvider>
+    </ThemeProvider>
+  );
+}
-- 
