+  { id:"luis",name:"Dr. Luis Vargas" },
+];
+const cita=(id:string,nombre:string,doctorId:string|null,hora:string,durationMin:number,status="PENDIENTE"):CitaAgendaDia=>({id,doctorId,dateTime:`2026-10-06T${hora}:00-04:00`,durationMin,status,patient:{name:nombre},doctor:doctorId?{name:doctorId}:null});
+const citasDeEjemplo=[
+  cita("A","Lucía Mendoza","ana","09:00",60),
+  cita("B","Jorge Rivas","ana","09:30",30),
+  cita("C","Carla Rojas","luis","09:00",45,"CONFIRMADA"),
+  cita("D","Marta Flores",null,"11:00",30),
+  cita("E","Diego Suárez","luis","15:30",30,"CANCELADA"),
+  cita("F","Rosa Paredes","ana","10:30",30,"COMPLETADA"),
+  cita("G","Luis Quispe","luis","10:30",30,"NO_ASISTIO"),
 ];
