-const citas=[cita("A","ana","09:00",60),cita("B","ana","09:30",30),cita("C","luis","09:00",45,"CONFIRMADA"),cita("D",null,"11:00",30),cita("E","luis","15:30",30,"CANCELADA")];
 export function BancoAgenda({caso}:{caso:string}) {
   const [dia,setDia]=useState("2026-10-06");
   const [seleccionada,setSeleccionada]=useState<string|null>(null);
+  // Confirmar sólo cambia el estado local del banco: no hay red ni base.
+  const [confirmadas,setConfirmadas]=useState<string[]>([]);
+  const citas=citasDeEjemplo.map(c=>confirmadas.includes(c.id)?{...c,status:"CONFIRMADA"}:c);
   return <div className="space-y-5">
-    <header><h1 className="text-2xl font-semibold text-on-surface">Agenda del día</h1><p className="text-sm text-on-surface-variant">Banco con datos ficticios. Confirmar está deshabilitado; no se guardan cambios.</p></header>
+    <header><h1 className="text-2xl font-semibold text-on-surface">Agenda del día</h1><p className="text-sm text-on-surface-variant">Datos de ejemplo; no se guarda nada.</p></header>
     <AgendaDia citas={caso==="vacio"?[]:citas} profesionales={profesionales} fecha={dia} zona="America/La_Paz"
       perfil={caso==="doctor"?{id:"ana",role:"DOCTOR"}:{id:"recepcion",role:"STAFF"}}
       puedeGestionar={caso!=="lectura"} ahora={Date.parse("2026-10-06T12:00:00Z")}
       citasLabel="citas" onFecha={d=>{setDia(d);setSeleccionada(null);}} onSeleccionar={setSeleccionada} seleccionada={seleccionada}
+      onConfirmar={id=>setConfirmadas(prev=>[...prev,id])}
       fallo={caso==="error"?{id:"A",texto:"No se pudo guardar el cambio. Revise su conexión."}:null}/>
     {seleccionada && <p role="status" className="text-sm text-on-surface">Detalle de la cita {seleccionada}. En el banco no se abren fichas ni se ejecutan acciones reales.</p>}
   </div>;
