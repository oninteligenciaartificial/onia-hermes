  "prompt_engineering_system": {
    "version": "2026-06-01",
    "research_sources": [
      "https://higgsfield.ai/marketing-studio-intro",
      "https://higgsfield.ai/marketing-automation",
      "https://www.alici.ai/blog/ugc-hook-strategy-types-testing-2026",
      "Higgsfield CLI: marketing-studio avatars/hooks/settings list"
    ],
    "core_rule": "A Higgsfield prompt must direct persona, setting, product/service action, camera behavior, 6-beat script structure, safe proof and negative constraints. Do not send generic ad prompts.",
    "six_beat_structure": [
      "0-2s hook: one clear visual/verbal interruption",
      "2-5s problem: name the pain in plain language",
      "5-10s mechanism: what changes or how the product/service works",
      "10-18s demo: show it, do not only explain it",
      "18-23s safe proof/detail: feature, process, routine or approved proof",
      "23-30s CTA: one action only"
    ],
    "prompt_blocks_order": [
      "job_set_type and mode",
      "business and offer",
      "target audience",
      "ready character/persona",
      "ready scenography/setting",
      "hook line",
      "scene flow",
      "camera and edit language",
      "audio/subtitle instruction",
      "safe claims",
      "negative prompt",
      "CTA"
    ],
    "default_higgsfield_params": {
      "job_set_type": "marketing_studio_video",
      "aspect_ratio": "9:16",
      "duration": 15,
      "resolution": "720p",
      "generate_audio": false
    },
    "mode_by_goal": {
      "product_demo": "ugc_unboxing",
      "hands_on_review": "product_review",
      "service_explainer": "ugc_how_to",
      "local_offer": "ugc",
      "premium_story": "tv_spot",
      "creative_test": "wild_card"
    },
    "quality_rules": [
      "Use Spanish script lines, but prompt Higgsfield in English for better video direction.",
      "Keep on-screen text under 6-8 words per caption.",
      "Ask for visual change every 2-3 seconds.",
      "Prefer demo/product action over review-only talking.",
      "Mention exact gestures: pick up, open, pour, tap screen, show receipt, point to calendar.",
      "Use one CTA. Do not mix follow, buy, comment and book in the same short.",
      "Avoid fake scarcity, fake proof, exact performance claims and unapproved logos.",
      "For long ads, generate 15s modules and edit them together instead of one vague 60s prompt."
    ]
  },
