# ONIA Meta Ads — variable names only. Real values live in /root/.hermes/.env on
# the VPS, or as an n8n Header Auth credential. NEVER commit real values.
# See hermes-content/docs/ONIA_META_SETUP_Y_ADS_RUNBOOK.md §6.

# Safety switch. DRY unless this is exactly "true". Leave unset in normal use.
META_LIVE=

# API version (use the current stable shown in the Graph API Explorer).
META_API_VERSION=v21.0

# Ids (not secret, but keep out of git anyway).
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=act_
META_APP_ID=
META_PIXEL_ID=

# Secrets — server-side only.
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_CAPI_TOKEN=
