# Emisor SIAT — variables de entorno (NUNCA commitear el .env real).
# Secretos solo en env / vault del VPS, jamas en git ni en el core.

# Ambiente: piloto | produccion
SIAT_ENV=piloto

# NIT del contribuyente emisor (por organizacion, se resuelve del tenant registry;
# esto es solo para pruebas de un NIT unico).
SIAT_NIT=

# Credenciales SIAT en linea del NIT (obtenidas del portal). El token delegado
# por cliente lo genera el cliente en SIAT y se guarda cifrado por organizacion.
SIAT_USUARIO=
SIAT_TOKEN_DELEGADO=

# Codigo de sistema devuelto por "Gestion de Autorizacion de Sistemas" del SIN
# (uno por version del sistema; se obtiene al registrar como proveedor).
SIAT_CODIGO_SISTEMA=

# Certificado digital (SOLO modalidad electronica / etapa VIII). RUTAS a los
# archivos PEM — en el VPS bajo /opt/onia-siat/certs/ con chmod 600, JAMAS en
# git. El de PRUEBA (piloto) lo emite AGETIC gratis en
# desarrollo.adsib.gob.bo/desa_solicitudes; el de produccion en
# solicitud.firmadigital.bo. La computarizada NO lo requiere.
# SIAT_FIRMA_KEY_FILE=/opt/onia-siat/certs/firma.key.pem
# SIAT_FIRMA_CERT_FILE=/opt/onia-siat/certs/firma.crt.pem

# ------------------- Wrapper HTTP (src/http-wrapper.mjs) --------------------
# En el VPS este bloque vive en /opt/onia-siat/siat-wrapper.env (nunca en git).
# El wrapper tambien lee SIAT_ENV, SIAT_NIT y SIAT_CODIGO_SISTEMA de arriba,
# y acepta SIAT_PILOT_TOKEN (el mismo de siat-piloto.env) como token del SIN.

# Bearer que Onia Platform manda como SIAT_SERVICE_TOKEN. Generar uno largo:
#   openssl rand -hex 32
SIAT_WRAPPER_TOKEN=

# Token del SIN (apikey). Si esta vacio se usa SIAT_PILOT_TOKEN.
SIAT_SIN_TOKEN=

# CUIS del punto de venta que emite (del checkpoint del runner):
#   jq -r '.cuisByPv["0"]' /opt/onia-siat/fase1-state.json
SIAT_CUIS=

# Homologacion por defecto para TODAS las lineas (del catalogo sincronizado:
#   jq '.catalogs.productos[0]' /opt/onia-siat/fase1-state.json
#   jq '.catalogs.unidadesMedida[0]' /opt/onia-siat/fase1-state.json ):
SIAT_ACTIVIDAD_ECONOMICA=
SIAT_CODIGO_PRODUCTO_SIN=
SIAT_UNIDAD_MEDIDA=

# Opcionales (defaults sensatos):
# SIAT_WRAPPER_HOST=127.0.0.1
# SIAT_WRAPPER_PORT=8517
# SIAT_SUCURSAL=0
# SIAT_PUNTO_VENTA=0
# SIAT_LEYENDA=            (default: texto Ley 453 generico; usar la del catalogo)
# SIAT_CODIGO_METODO_PAGO=1
# SIAT_RAZON_SOCIAL=       (default: OniaAgency)
# SIAT_MUNICIPIO=          (default: Santa Cruz de la Sierra)
# SIAT_DIRECCION=
# SIAT_WRAPPER_STATE=/opt/onia-siat/wrapper-state.json
# SIAT_NUMERO_INICIAL=     (default: derivado del epoch, no choca con el runner)
