  "agregados_al_guion": [
    { "id": "A1", "que": "El dato lleva la palabra «parecido» («parecido 0,81»): el número solo no dice qué mide. El guion dice «dato 0,81».", "revertir": "build.mjs → texto de la pastilla #dA-<id> (y la lectura pasa de 2 a 1 palabra)" },
    { "id": "A2", "que": "Marca «mi piso · 0,70» (el guion dice «Piso, 0,70.»): deja claro que el piso lo fijó la sesión, no una frontera objetiva (igual que G2).", "revertir": "build.mjs → texto de #sc-mkl / #l1-mkl" },
    { "id": "A3", "que": "Imagen D: punto y pastilla NEUTROS (blanco) en vez de verde, y la pastilla «justo en el piso»: 0,702 cumple por poco y no se anuncia como aprobado (el guion lo pide).", "revertir": "plan.json → imagenes[d].estado = \"ok\"" },
    { "id": "A4", "que": "La nota «Una toma cada uno: es una prueba, no una regla.» va en la placa de la lección 1 (la que ordena por precio y sugiere ranking): el guion dice que «una tarjeta» la dice, sin decir cuál.", "revertir": "plan.json → l1.nota" },
    { "id": "A5", "que": "Tarjeta de la lección 2: «El café: B perdió la cara.» (6 palabras) en vez de «B perdió la cara en el café.» (7: el guion se pasa de su propio máximo de 6).", "revertir": "plan.json → c13 (y subir el máximo a 7 en build.mjs)" },
    { "id": "A6", "que": "Las 8 referencias se muestran TODAS (cuadrícula de 4x2) en la regla, no una muestra de 5 como en G2: «Se mide contra 8 fotos suyas.» se ve literal.", "revertir": "plan.json → refs.recortes y regla.refs" },
    { "id": "A7", "que": "Cierre con la FOTO A (no el clip K1): la orden era «sin clips». El guion admitía las dos. Revertir: poner el clip K1 de 0 a 3 s (o de 2 a 5,5 s, ver G2 H7).", "revertir": "plan.json → medios[f-cierre] por un clip" },
    { "id": "A8", "que": "El rótulo de IA se ve entero de 0 a 2,4 s y recién ahí sale (G2 lo sacaba dentro de esos 2,4 s): 2,4 s legibles para sus 6 palabras.", "revertir": "timeline.js → leave('#rotulo', PLAN.rotulo.b)" },
    { "id": "A9", "que": "Empuje lento 1,00 → 1,04 sobre cada foto (la orden: «movimiento mínimo tipo empuje lento/zoom suave»).", "revertir": "plan.json → zoom.fin = 1" }
