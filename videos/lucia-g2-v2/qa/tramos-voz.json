[
 {
  "n": 1,
  "linea": "¿Quién pierde la cara?",
  "chars": 22,
  "a": 0.125,
  "b": 1.7083333333333333,
  "dura": 1.583333,
  "ultimo": false
 },
 {
  "n": 2,
  "linea": "Seis clips con la misma orden.",
  "chars": 30,
  "a": 1.7083333333333333,
  "b": 3.75,
  "dura": 2.041667,
  "ultimo": false
 },
 {
  "n": 3,
  "linea": "Se mide contra ocho fotos suyas.",
  "chars": 32,
  "a": 3.75,
  "b": 5.875,
  "dura": 2.125,
  "ultimo": false
 },
 {
  "n": 4,
  "linea": "De cero a uno.",
  "chars": 14,
  "a": 5.875,
  "b": 6.916666666666667,
  "dura": 1.041667,
  "ultimo": false
 },
 {
  "n": 5,
  "linea": "Mi piso: cero setenta.",
  "chars": 22,
  "a": 6.916666666666667,
  "b": 8.458333333333334,
  "dura": 1.541667,
  "ultimo": false
 },
 {
  "n": 6,
  "linea": "Kling tres, foto sola: pierde parecido.",
  "chars": 39,
  "a": 8.458333333333334,
  "b": 11,
  "dura": 2.541667,
  "ultimo": false
 },
 {
  "n": 7,
  "linea": "Seedance Mini, foto sola.",
  "chars": 25,
  "a": 11,
  "b": 12.708333333333334,
  "dura": 1.708333,
  "ultimo": false
 },
 {
  "n": 8,
  "linea": "Queda bajo el piso.",
  "chars": 19,
  "a": 12.708333333333334,
  "b": 14.041666666666666,
  "dura": 1.333333,
  "ultimo": false
 },
 {
  "n": 9,
  "linea": "Kling O tres, solo referencias: aguantó.",
