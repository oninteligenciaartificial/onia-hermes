  "verticalFactory": {
    "pattern": "Un solo core + motor GestiOS + pack vertical por rubro. Cada vertical se vende especializado (vocabulario, checklists, KPIs e intake del rubro), nunca como ERP generico. Nuevos rubros = nuevo pack, no nuevo codigo de core.",
    "packContents": [
      "vocabulario del rubro: tipos de WorkItem, tipos de BusinessPartner, areas tipicas",
      "checklists de procesos del rubro (ProcessChecklist)",
      "panel del dueno con KPIs del rubro (SavedView sobre owner_dashboard)",
      "plantillas de intake del rubro (canales y formularios)",
      "oferta y pricing del rubro"
    ],
    "strategy": "onia-core/ONIA_VERTICAL_FACTORY_STRATEGY_2026.md",
    "roadmapRubros": [
