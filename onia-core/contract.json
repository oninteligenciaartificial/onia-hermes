  "intakePolicy": {
    "purpose": "Todo canal externo entra al core como WorkItem normalizado. Las integraciones (WhatsApp, formularios, llamadas) viven fuera del core y solo empujan intake normalizado.",
    "detail": "onia-core/ONIA_CORE_OWNER_PANEL_AND_INTAKE_2026.md",
    "channels": [
      {
        "id": "whatsapp_chatwoot",
        "source": "Chatwoot/WhatsApp",
        "workItemType": "lead_conversacion",
        "gate": "external_gate whatsapp"
      },
      {
        "id": "email_shared",
        "source": "Correos oficiales de la empresa (todos registrados como CommunicationChannel)",
        "workItemType": "mensaje_correo",
        "gate": "none"
      },
      {
        "id": "web_form",
        "source": "Formularios web-factory / landing",
        "workItemType": "lead_formulario",
        "gate": "none"
      },
      {
        "id": "phone_walkin",
        "source": "Llamada o visita registrada manualmente",
        "workItemType": "solicitud_manual",
        "gate": "none"
      },
      {
        "id": "import",
        "source": "ImportBatch validado",
        "workItemType": "segun_lote",
        "gate": "dry_run_obligatorio"
      }
    ],
    "normalizationRules": [
      "todo canal oficial de la empresa DEBE existir como CommunicationChannel; un mensaje que llega por canal no registrado es una alerta de gobernanza",
      "el ruteo usa routedAreaId/routingRule del CommunicationChannel de origen, no reglas sueltas",
      "todo intake crea WorkItem con type, priority, canal de origen y payload minimo",
      "match o creacion de BusinessPartner/Contact antes de asignar responsable",
      "dedupe por contacto+canal en ventana de 24h antes de crear otro WorkItem",
      "asignacion por regla de ruteo del area (round-robin u owner fijo), auditada en ActivityEvent",
      "clasificacion IA opcional (embeddings) corre fuera del core y solo sugiere type/priority"
    ]
  },
