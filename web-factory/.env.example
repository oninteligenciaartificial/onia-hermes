UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GITHUB_TOKEN=

# Server-side Nuvia commerce storage. Never expose the service role key in browser code.
WEB_FACTORY_SUPABASE_URL=
WEB_FACTORY_SUPABASE_SERVICE_ROLE_KEY=
WEB_FACTORY_SUPABASE_SCHEMA=web_factory

# Server-side ONIA Center runtime/Auth. Never expose the service role key in browser code.
ONIA_CENTER_SUPABASE_URL=
ONIA_CENTER_SUPABASE_SERVICE_ROLE_KEY=
ONIA_CENTER_SUPABASE_ANON_KEY=
ONIA_CENTER_SUPABASE_SCHEMA=onia_center

# ONIA Center internal assistant. Prefer a dedicated key for this system.
ONIA_ASSISTANT_PROVIDER=openai
OPENAI_ONIA_CENTER_API_KEY=
OPENAI_ONIA_CENTER_MODEL=gpt-5.4-mini
ONIA_ASSISTANT_MAX_OUTPUT_TOKENS=900
ONIA_CENTER_BASE_URL=http://localhost:3012
ONIA_CENTER_INTERNAL_API_KEY=
ONIA_DAILY_BRIEFING_MODEL=gpt-5.4-mini
ONIA_DAILY_BRIEFING_MAX_OUTPUT_TOKENS=2200
ONIA_FAST_MODEL=gpt-5.4-mini
ONIA_DEEP_REASONING_MODEL=gpt-5.5
ONIA_AUDIO_ANALYSIS_MODEL=gpt-5.4-mini
ONIA_AUDIO_MAX_OUTPUT_TOKENS=1800
ONIA_AUDIO_STT_BASE_URL=http://127.0.0.1:3108/v1
ONIA_AUDIO_STT_MODEL=Systran/faster-distil-whisper-large-v3
ONIA_AUDIO_STT_LANGUAGE=es
ONIA_AUDIO_STT_FALLBACK_PROVIDER=openai
ONIA_AUDIO_STT_FALLBACK_MODEL=gpt-4o-mini-transcribe
ONIA_AUDIO_MAX_MB=100

# Optional notification/calendar connectors for n8n. Keep real values in n8n/Vercel/local secrets only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SERGIO_CHAT_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Future RAG/workflow provider. Leave empty until Dify is deployed and protected.
DIFY_BASE_URL=
DIFY_ONIA_CENTER_API_KEY=

# Primary payment provider for Nuvia checkout.
BNB_ENV=sandbox
BNB_ACCOUNT_ID=
BNB_AUTHORIZATION_ID=
BNB_AUTH_BASE_URL=
BNB_QR_BASE_URL=
BNB_WEBHOOK_SECRET=

# Manual fallback channels. Configure only when operationally approved.
YAPE_BUSINESS_PHONE_OR_QR=
NUVIA_BANK_NAME=
NUVIA_BANK_ACCOUNT=
NUVIA_BANK_ACCOUNT_OWNER=
