UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GITHUB_TOKEN=

# Server-side Nuvia commerce storage. Never expose the service role key in browser code.
WEB_FACTORY_SUPABASE_URL=
WEB_FACTORY_SUPABASE_SERVICE_ROLE_KEY=
WEB_FACTORY_SUPABASE_SCHEMA=web_factory

# Server-side ONIA Center runtime/Auth. Never expose the service role key in browser code.
ONIA_CENTER_SUPABASE_URL=
ONIA_CENTER_SUPABASE_SERVICE_ROLE_KEY=
ONIA_CENTER_SUPABASE_ANON_KEY=
ONIA_CENTER_SUPABASE_SCHEMA=onia_center

# ONIA Center internal assistant. Prefer a dedicated key for this system.
ONIA_ASSISTANT_PROVIDER=openai
OPENAI_ONIA_CENTER_API_KEY=
OPENAI_ONIA_CENTER_MODEL=gpt-5.4-mini
ONIA_ASSISTANT_MAX_OUTPUT_TOKENS=900

# Future RAG/workflow provider. Leave empty until Dify is deployed and protected.
DIFY_BASE_URL=
DIFY_ONIA_CENTER_API_KEY=

# Primary payment provider for Nuvia checkout.
BNB_ENV=sandbox
BNB_ACCOUNT_ID=
BNB_AUTHORIZATION_ID=
BNB_AUTH_BASE_URL=
BNB_QR_BASE_URL=
BNB_WEBHOOK_SECRET=

# Manual fallback channels. Configure only when operationally approved.
YAPE_BUSINESS_PHONE_OR_QR=
NUVIA_BANK_NAME=
NUVIA_BANK_ACCOUNT=
NUVIA_BANK_ACCOUNT_OWNER=
