UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GITHUB_TOKEN=

# Server-side Nuvia commerce storage. Never expose the service role key in browser code.
WEB_FACTORY_SUPABASE_URL=
WEB_FACTORY_SUPABASE_SERVICE_ROLE_KEY=
WEB_FACTORY_SUPABASE_SCHEMA=web_factory

# Primary payment provider for Nuvia checkout.
BNB_ENV=sandbox
BNB_ACCOUNT_ID=
BNB_AUTHORIZATION_ID=
BNB_AUTH_BASE_URL=
BNB_QR_BASE_URL=
BNB_WEBHOOK_SECRET=

# Manual fallback channels. Configure only when operationally approved.
YAPE_BUSINESS_PHONE_OR_QR=
NUVIA_BANK_NAME=
NUVIA_BANK_ACCOUNT=
NUVIA_BANK_ACCOUNT_OWNER=
