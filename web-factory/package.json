{
  "name": "web-factory",
  "version": "1.0.0",
  "description": "ONIA Web Factory for tokenized client sites.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "build:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-site-stable.ps1",
    "generate": "tsx generate/index.ts",
    "client:new": "tsx generate/create-client.ts",
    "design:auto": "tsx generate/auto-design.ts",
    "factory:build": "tsx generate/factory-build.ts",
    "from-configurador": "tsx generate/from-configurador.ts",
    "factory:smoke": "pnpm test && pnpm generate demo && pnpm generate skincare-demo --template store && pnpm generate restaurant-demo && pnpm generate clinic-demo && pnpm generate engineering-demo && pnpm generate saas-demo && pnpm generate dashboard-demo --template dashboard && pnpm generate dental-demo --template landing-clinic && pnpm generate realestate-demo --template landing-realestate && pnpm generate logistics-demo --template landing-logistics",
    "blocks:demo": "tsx packages/blocks/demo.ts",
    "lint": "pnpm --filter site lint",
    "preview:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-previews.ps1",
    "preview:nuvia": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-nuvia-preview.ps1",
    "nuvia:catalog": "node harvester/product/scrape_hbderm_products.mjs --concurrency=1 && node harvester/product/build_nuvia_hbderm_catalog.mjs && node harvester/product/sanitize_nuvia_public_catalog.mjs && node harvester/product/apply_existing_nuvia_cutouts.mjs && node harvester/product/build_nuvia_merchandising.mjs",
    "nuvia:merchandising": "node harvester/product/build_nuvia_merchandising.mjs",
    "nuvia:media": "node harvester/product/enrich_nuvia_product_media.mjs --concurrency=5",
    "nuvia:cutouts": "python harvester/product/create_nuvia_product_cutouts.py && node harvester/product/apply_existing_nuvia_cutouts.mjs",
    "nuvia:cutout-map": "node harvester/product/apply_existing_nuvia_cutouts.mjs",
    "nuvia:prices:check": "node harvester/product/watch_nuvia_price_changes.mjs --check-only --concurrency=1",
    "nuvia:prices:watch": "node harvester/product/watch_nuvia_price_changes.mjs --concurrency=1",
    "nuvia:prices:force": "node harvester/product/watch_nuvia_price_changes.mjs --force --concurrency=1",
    "nuvia:sanitize-public": "node harvester/product/sanitize_nuvia_public_catalog.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:next": "pnpm --filter site build && playwright test --config=playwright.next.config.ts",
    "e2e:install": "pnpm exec playwright install chromium",
    "images:check": "tsx generate/check-images.ts",
    "references:anatomy": "node harvester/vision/extract_web_anatomy.mjs",
    "references:code-index": "node harvester/vision/index_licensed_code.mjs --repos-root C:/Users/PC/.codex/design-stack/repos --out data/references/code-sources/latest-code-cache-index.json",
    "references:code-examples": "node harvester/vision/index_component_code_examples.mjs --code-index data/references/code-sources/latest-code-cache-index.json --out data/references/code-sources/latest-component-code-examples.json --max-files-per-repo 24",
    "references:intelligence": "node harvester/vision/build_design_intelligence.mjs --gallery data/references/design-sources/gallery-examples/latest-gallery-examples.json --code data/references/code-sources/latest-component-code-examples.json --out data/references/design-sources/latest-design-intelligence.json --markdown docs/WEB_FACTORY_DESIGN_INTELLIGENCE_LATEST.md",
    "references:harvest:smoke": "node harvester/vision/watch_design_references.mjs --once --source-ids 21st-landing-page-components,registry-directory,magic-ui --max-items 6 --detail-items 1 --max-files-per-repo 12",
    "references:harvest:daily": "node harvester/vision/watch_design_references.mjs --once --max-items 24 --detail-items 3 --max-files-per-repo 36",
    "references:harvest:watch": "node harvester/vision/watch_design_references.mjs --interval-minutes 1440 --max-items 24 --detail-items 3 --max-files-per-repo 36",
    "references:gallery:merge": "node harvester/vision/merge_gallery_examples.mjs --input-dir data/references/design-sources/gallery-examples --out data/references/design-sources/gallery-examples/latest-gallery-examples.json",
    "references:gallery:21st": "node harvester/vision/scrape_gallery_examples.mjs --config data/references/design-sources/gallery-reference-sources.json --cache-root C:/Users/PC/.codex/design-stack/gallery-examples-full --out data/references/design-sources/gallery-examples/21st-community-components.json --source-ids 21st-community-components --max-items 30 --detail-items 10",
    "references:gallery:all": "node harvester/vision/scrape_gallery_examples.mjs --config data/references/design-sources/gallery-reference-sources.json --cache-root C:/Users/PC/.codex/design-stack/gallery-examples-full --out data/references/design-sources/gallery-examples/full-gallery-run.json",
    "references:playwright:install": "pnpm exec playwright install chromium",
    "reels:prepare": "node harvester/reels/prepare.mjs --lane trend",
    "reels:prepare:client": "node harvester/reels/prepare.mjs --lane client",
    "reels:intelligence": "node harvester/reels/build-reels-intelligence.mjs --lane trend",
    "reels:intelligence:client": "node harvester/reels/build-reels-intelligence.mjs --lane client",
    "reels:acquire": "node harvester/reels/build-web-models.mjs",
    "automation:vps:dry": "node scripts/web-factory-vps-automation.mjs --mode daily --dry-run",
    "automation:vps:daily": "node scripts/web-factory-vps-automation.mjs --mode daily",
    "automation:vps:references": "node scripts/web-factory-vps-automation.mjs --mode references",
    "automation:vps:nuvia-check": "node scripts/web-factory-vps-automation.mjs --mode nuvia-check",
    "automation:vps:nuvia-watch": "node scripts/web-factory-vps-automation.mjs --mode nuvia-watch",
    "automation:vps:smoke": "node scripts/web-factory-vps-automation.mjs --mode smoke",
    "typecheck:packages": "tsc --noEmit -p tsconfig.packages.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "@onia/templates": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "lucide-react": "^1.18.0",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.19.43",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
