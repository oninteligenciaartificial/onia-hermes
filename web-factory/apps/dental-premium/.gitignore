node_modules/
.next/

# Esta app vive DENTRO del workspace pnpm de web-factory (pnpm-workspace.yaml: apps/*).
# Un package-lock.json acá no lo lee nadie y encima invita a correr `npm install`, que es
# lo que dejó a onia.com.bo nueve dias sin publicarse: el deploy muere en
# `pnpm install --frozen-lockfile` cuando pnpm-lock.yaml no conoce las deps de esta app.
# Se instala SIEMPRE desde web-factory/ con pnpm. Ver README.
package-lock.json
yarn.lock

# Artefacto incremental de tsc: se regenera en cada typecheck y solo ensucia el diff.
tsconfig.tsbuildinfo

# Capturas que escribe `npm run gate:contraste`. Se REGENERAN en cada corrida y
# pesan 1,2 MB: versionarlas sería 1,2 MB de binario nuevo por vuelta del loop.
# La evidencia que sobrevive son los NÚMEROS del gate, que van en el commit y en
# la cola; la foto se vuelve a sacar en un comando cuando hace falta mirarla.
capturas/
