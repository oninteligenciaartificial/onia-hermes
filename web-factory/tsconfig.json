{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "data/**/*.ts",
    "design/**/*.ts",
    "generate/**/*.ts",
    "harvester/**/*.ts",
    "packages/**/*.ts"
  ]
}
