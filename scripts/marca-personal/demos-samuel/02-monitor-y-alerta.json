{
  "name": "Samuel - 02 - Monitor y alerta (demo)",
  "nodes": [
    {
      "id": "horario",
      "name": "Revisar cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        300,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "monitor",
      "name": "Revisar mi web",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "url": "https://example.com",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "condicion",
      "name": "La web tiene un problema",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        820,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fallo",
              "leftValue": "={{ !!$json.error || Number($json.statusCode) >= 400 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "aviso",
      "name": "Avisarme por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        230
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "TU_CHAT_ID",
        "text": "Alerta: mi web no responde correctamente. Revisa el servicio.",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Revisar cada 5 minutos": {
      "main": [
        [
          {
            "node": "Revisar mi web",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Revisar mi web": {
      "main": [
        [
          {
            "node": "La web tiene un problema",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "La web tiene un problema": {
      "main": [
        [
          {
            "node": "Avisarme por Telegram",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "America/La_Paz",
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
